  "map.[hota] purgatory.sign.76.91.0.message" : "Tikai sacensību dalībniekiem. Atvainojiet. :)",
  "map.[hota] purgatory.sign.78.55.0.message" : "Neliela mīkla tev",
  "map.[hota] purgatory.sign.80.10.1.message" : "Heidena Kristensena īpašā zona\n(Es to joprojām saucu par \"smiltīm\" \"sēra\" vietā kopš bērnības)",
  "map.[hota] purgatory.sign.80.247.1.message" : "Uz brūnā atslēgu meistara telti un grāfieni",
  "map.[hota] purgatory.sign.80.42.1.message" : "Šeit guļ visi tie balonos ietērptie izstāžu rāpuļi",
  "map.[hota] purgatory.sign.83.104.1.message" : "Šeit guļ visu laiku dižākais burvju mākslinieks: Tims!\n... un visi Monty Python maniaki.",
  "map.[hota] purgatory.sign.83.184.1.message" : "Uz tumši zilo atslēgu meistara telti",
  "map.[hota] purgatory.sign.83.38.1.message" : "Īpaša vieta, kas rezervēta M. Naitam Šjamalanam",
  "map.[hota] purgatory.sign.88.224.1.message" : "Tajā kolizejā krita daudzi magi. Viņu gari vajā šo vietu.",
  "map.[hota] purgatory.sign.9.231.0.message" : "Daudzi mūsējie sekoja viņam pa šo ceļu, cilvēki, kurus mēs kopš tā laika neesam redzējuši.\n\nBet viņi nevarēja tikt tālu, viņi joprojām ir goblini...",
  "map.[hota] purgatory.sign.90.123.1.message" : "Šeit guļ visi cilvēki, kas devās uz kino, lai skatītos \"Akvamenu\" tikai Džeisona Momoa ķermeņa dēļ.",
  "map.[hota] purgatory.sign.95.102.0.message" : "Zelta upe. Uzmanieties no vilku laupītājiem un rūķiem, kas cīnās par šo apgabalu!",

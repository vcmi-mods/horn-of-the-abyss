  "map.[hota] element land.quest.98.9.0.completed" : "Visa Armagedona asmens maģija tiks izsmelta, iznīcinot barjeru, vai vēlaties turpināt?",
  "map.[hota] element land.quest.98.9.0.firstVisit" : "Koku cilvēku cilts slēpjas aiz spēcīgas barjeras, kas veidota no koka maģijas, tikai Armagedona Asmens būs pietiekami spēcīgs, lai to sadedzinātu.",
  "map.[hota] element land.quest.98.9.0.nextVisit" : "Tikai Armagedona zobens to var iznīcināt.",
  "map.[hota] element land.sign.103.56.0.message" : "Vai zinājāt, ka melnie pūķi ir spēcīgāki par sarkanajiem pūķiem?\n\nLai iegūtu vairāk noderīgas informācijas, apmeklējiet savu vietējo krogu.",
  "map.[hota] element land.sign.105.100.1.message" : "Sveiki.",
  "map.[hota] element land.sign.105.145.1.message" : "Atslēgu galvaspilsēta",
  "map.[hota] element land.sign.11.42.1.message" : "Ja nepieciešama rezerves atslēga, aprunājies ar tur esošo aci.",
  "map.[hota] element land.sign.113.73.0.message" : "Iemācies jāt jau šodien! Zirgs, vienradzis vai briesmonis! Sīkāku informāciju jautājiet reģistratūrā.",
  "map.[hota] element land.sign.115.146.1.message" : "Nomājams negodnieks! Apciemojiet mani manā lapenē, kas atrodas tikai dažu dienu brauciena attālumā uz dienvidiem no šejienes!",
  "map.[hota] element land.sign.117.212.0.message" : "Globālās sasilšanas sala",
  "map.[hota] element land.sign.118.190.0.message" : "Es dzirdēju, ka nav varoņu, kas specializētos gaisa elementālos.",
  "map.[hota] element land.sign.118.77.0.message" : "Jāšanas skolas sala",
  "map.[hota] element land.sign.137.80.0.message" : "Notiek Uzbrukuma asociācijas un Aizsardzības federācijas miera samits, lūdzu, netraucējiet.",
  "map.[hota] element land.sign.143.90.0.message" : "Reti kuloni! Saņemiet savus retos kulonus šeit bez maksas jau šodien! Viss, kas jums jādara, ir pieķēdēt durvis un satvert! Vienkārši, vai ne!?",
  "map.[hota] element land.sign.150.5.1.message" : "Dzīvības un nāves templis",
  "map.[hota] element land.sign.155.27.1.message" : "Slikti",
  "map.[hota] element land.sign.157.188.0.message" : "Šis ir rakstura ieraksts.",
  "map.[hota] element land.sign.163.61.0.message" : "Es nokritu acij ābolu no šīs klints, lūdzu, atnesiet to man atpakaļ, ja to atradīsiet! Es dzīvoju kvestu tornī blakus rozā divvirzienu teleportētājam!",
  "map.[hota] element land.sign.164.95.1.message" : "Eņģeļu pāreja",
  "map.[hota] element land.sign.171.24.1.message" : "Daleka ligzda",

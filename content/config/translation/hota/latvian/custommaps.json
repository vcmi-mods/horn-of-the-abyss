{
  // Mysterious Island 1.5.c
  // Google AI Translation
  "map.[hota] the mysterious island.event.0.description" : "Ir pagājis mēnesis.\n\nŠie ir jaunākie ieraksti no mūsu hronikas:\n\n{=== Dienasgrāmata - 1. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{---------------------------------------------}\n{Izlūks izglābts.}\n{Palīdzēja atjaunot mūsu krāsu atslēgu.}\n{~}\n{Iekarotas divas sekundāras pilsētas.}\n{~}\n\n{Informācija atjaunota:}\n{--------------------------------------------------}\n{Diplomātijas prasme nav noderīga,}\n{bet diplomātiskie artefakti ir.}\n{~}\n{Dažas burvestības nav ģildēs,}\n{bet tās var iegūt vēlāk.}\n{~}\n{{Pilsētas portāls pastāv, bet mēs to nevaram iegūt ilgu laiku.}\n{Alternatīva ir pieejama no 13. līmeņa.}\n{~}\n{Trūkst zināšanu,\n{bet tās ir paslēptam personāžam.}\n{~}\n{Šomēnes krogos parādījās četras baumas:}\n{Tās ar dzeltenu tekstu ir noderīgi.}\n{~}\n{=== . ===}\n\n--\nAutora piezīme:\nJūsu žurnālā norādītie mērķi un informācija ir galvenie.\nTaču ir arī daudzi {citi} uzdevumi, atrašanās vietas un varoņi, kas var jums palīdzēt,\npat ja tie šeit nav uzskaitīti.",
  "map.[hota] the mysterious island.event.1.description" : "Jūsu {krodziņos} klīst dīvainas baumas...\n\nIeklausieties tajās – varbūt atradīsiet kādu noderīgu informāciju?",
  "map.[hota] the mysterious island.event.10.description" : "Trešais mēnesis uz šīs salas.\nMums izdevās ģenerēt vēl dažus resursus!",
  "map.[hota] the mysterious island.event.100.description" : "{13.} mēnesis ir gandrīz beidzies!\nVampīru izsaukšanas rituāls tūlīt sāksies...",
  "map.[hota] the mysterious island.event.101.description" : "Ēnaina figūra, paslēpusies krogā, sarkastiski piebilst:\n\n\"Nu... tas gan bija interesants komentārs...\"",
  "map.[hota] the mysterious island.event.102.description" : "Tu paskaties apkārt un atklāj, ka balss nāca no rūķu sievietes, klejotājas vārdā Krapuleta:\n\n\"Ja tu vēlies īstu {noderīgu informāciju}, man ir tieši tā lieta.\tNu, nekautrējies...\"",
  "map.[hota] the mysterious island.event.103.description" : "\"{Pirāti} (Pink) plāno \"spēcīgu, {koordinētu} uzbrukumu no visiem salas nostūriem...\n\nEs varētu pateikt {precīzu dienu}, kad viņi uzbruks, un {kur}...\n\nBet tas nebūs bez maksas...\"",
  "map.[hota] the mysterious island.event.104.description" : "\"Ja jūs interesē šī mazā lietiņa, tā jums izmaksās {86 753 zelta} monētas!\tEs pagaidīšu pēc {divām nedēļām}, tad es aiziešu no šejienes!\n\nNāciet {ar mani} uz {māju pie ūdens}, {uz ziemeļiem} no {Grants ezera}.\tTo ir viegli atrast: tas ir {liels ezers} ar {kubliņu}.\n\nTas patīk tikai vienam cilvēkam, tāpēc jūs to nevarat palaist garām!\n\nUn neaizmirstiet, satiku mani pirms {6} mēnešiem, {4} nedēļām, {2} dienām.\nTas ir cietums!\"",
  "map.[hota] the mysterious island.event.105.description" : "Pirms Krapulettas piedāvājuma pārdot informāciju derīguma termiņš {beidzas}, atlikušas tikai {piecas dienas}.\n\nJa vēlamies uzzināt, {kur} un {kad} pirāti plāno savu koordinēto uzbrukumu, mums jāsteidzas viņu atrast viņas {mājā pie ūdens} {uz ziemeļiem} no {Grants ezera}.",
  "map.[hota] the mysterious island.event.106.description" : "Varbūt paralēlā Visumā notika izvirdums?\n\nPārāk filozofisks jautājums... atgriezīsimies pie lietas būtības!\n\n",
  "map.[hota] the mysterious island.event.107.description" : "Ja mēs viņu vēl neesam atraduši, mums vajadzētu {iet viņu glābt}, jo īpaši tāpēc, ka viņa specialitāte {nodrošināt 350 zelta} dienā un viņa {Īpašumu} prasme noteikti palīdzētu mūsu finansēm!",
  "map.[hota] the mysterious island.event.108.description" : "Interesanti bija tas, ko teica ragana.\n\nJa mēs to vēl neesam izdarījuši, mums vajadzētu mēģināt GLĀBT mūsu sūtni, kas specializējas {Ērgļa acī}.\n\nMēs viņu nosūtījām sarunās ar {Oranžo} frakciju ({Pazemes cietums} un {Elle}), bet viņš tā arī neatgriezās...",
  "map.[hota] the mysterious island.event.109.description" : "Ja mūsu skautu varonis un es vēl neesam atvēruši ceļu uz {color} Atslēgmeistara telti, tikko {pavērusies} alternatīva pieeja!",
  "map.[hota] the mysterious island.event.11.description" : "Ceturtais mēnesis uz salas.\nMēs joprojām ģenerējam arvien vairāk resursu!",
  "map.[hota] the mysterious island.event.110.description" : "Mūsu spiegi ziņo, ka {Pirāti (Rozā)}, iespējams, ir atklājuši kontrabandistu maršrutus, kas ļauj viņiem {iefiltrēties} mūsu teritorijā un apkārtējās valstīs bez kuģu nepieciešamības!",
  "map.[hota] the mysterious island.event.111.description" : "Esam pamanījuši, ka prasme \"Diplomātija\" NAV laba ideja.\n\nTomēr, ja atradīsim {diplomāta artefaktus}, iespējams, vēlēsimies tos {paturēt}.\nTie varētu noderēt vēlāk.\n",
  "map.[hota] the mysterious island.event.112.description" : "atbilst 1 minūtei no katra",
  "map.[hota] the mysterious island.event.113.description" : "Ja vēl neesam to izdarījuši, dosimies {glābt} mūsu varoni \"Monētu meistaru\", kurš ir devies meklēt šīs salas noslēpumaino figūru.\n\n{Uzdevumu devējs}, kas atrodas vistuvāk mūsu sākuma pilsētai, varētu norādīt mums pareizo virzienu {direction}.",
  "map.[hota] the mysterious island.event.114.description" : "Starp citu, kādas bija {baumas} šonedēļ mūsu {krodziņā}?",
  "map.[hota] the mysterious island.event.115.description" : "Jauna nedēļa, jaunas {baumas} {krodziņos}!",
  "map.[hota] the mysterious island.event.116.description" : "Autora piezīme:\n\nBaumas ar {dzelteniem vārdiem} ir uzrakstījis es pats.\n\nBaumas vienkāršā baltā tekstā ģenerē spēle automātiski.",
  "map.[hota] the mysterious island.event.117.description" : "Tev šķita, ka dzirdi klusu {dārdoņu}, kas nāk no {salas dzīlēm}.\n\nBet virspusē nekas īpašs.\nĪpašs...",
  "map.[hota] the mysterious island.event.118.description" : "Pagājušajā naktī tev bija briesmīgs murgs: {pirātu kuģi} uzbrūk no visiem {četriem} salas stūriem...",
  "map.[hota] the mysterious island.event.119.description" : "Ja vēl neesam to izdarījuši, mums vajadzētu {glābt} mūsu Ērgļa acs specializēto varoni.\n\n{Uzdevumu devējs} blakus mūsu {6. līmeņa radījuma mājvietai} piedāvā {75 000 zelta} atlīdzību par viņa atgriešanos.",
  "map.[hota] the mysterious island.event.12.description" : "Piektais mēnesis, kas pavadīts uz salas.\nMūsu ikmēneša ienākumi sāk kļūt interesanti!",
  "map.[hota] the mysterious island.event.120.description" : "K&Q atšķirība",
  "map.[hota] the mysterious island.event.121.description" : "— Padoms.\n\nJūs varat {kartē} atrast briesmoni, kuru jānogalina, izmantojot {uzdevumu žurnālu}:\n\n1. Atveriet savu {uzdevumu žurnālu}, īsinājumtaustiņš: {Q} vai {A}.\n(uz QWERTY/AZERTY tastatūras)\n\n2. Ar {kreiso peles taustiņu} noklikšķiniet uz {briesmoņa portreta} un centrējiet kameru uz {tā atrašanās vietu}. Tagad jūs zināt, kurp doties!\n\n3. Varat arī noklikšķināt uz {uzdevumu devēja ikonas} un centrēt kameru uz viņu.",
  "map.[hota] the mysterious island.event.122.description" : "...bet vēl viena maza detaļa:\n\npasaules gals būs pēc dažiem mēnešiem!\n\nApokagedons vai kas tamlīdzīgs?",
  "map.[hota] the mysterious island.event.123.description" : "Jūsu magi un arhimagi iebilst:\n\n\"Nekādā gadījumā! Mēs nekādā gadījumā neienestīsim tornī kādu garīgu nieciņu! Tā ir nopietna lieta – arkāniskajai maģijai nav nekāda labuma no šāda \"Svētā Grāla\".\n\nJa vēlaties palielināt savu vienību ražošanu, \"Svētā Grāla\" vietā dodieties {rietumu} virzienā uz jūru.\n\nUz nelielas {sniegotas salas} ir ala, kur mūsu kolēģi magi ir veikuši visus nepieciešamos pasākumus...\"\n\n--\nAutora piezīme:\nGrālu nevar būvēt {Korālas} (Torņa) un {Žēlsirdības upes} (Torņa vai Bastiona) pilsētās.\n\nTo var būvēt visās pārējās pilsētās, ieskaitot jūsu sekundāro pilsētu {Falls River} (Bastiona).",
  "map.[hota] the mysterious island.event.124.description" : "Vienā no jūsu krodziņiem dzirdēsiet brīdinošu stāstu:\n\n\"{Pilna inventāra kļūda}: Piedzīvojumu meklētājs reiz aizmirsa {iztukšot} savu {mugursomu} pirms uzbrukuma svarīgam ienaidnieka varonim {sarkanajā} teritorijā, un rezultātā viņš nevarēja iegūt {būtisko artefaktu}, kas nepieciešams, lai sakautu citus sarkanos varoņus...\"",
  "map.[hota] the mysterious island.event.125.description" : "Viens no jūsu virsniekiem piekrīt jūsu bažām:\n\n\"Ņemot vērā salas lielumu, {tikai} galvenais varonis ar maksimāli palielinātiem primārajiem rādītājiem ilgtermiņā būtu {pašnāvniecisks}.\"\n\nMums jāplāno vismaz {divi} galvenie varoņi, kuri ir apmeklējuši pēc iespējas vairāk {primāro prasmju} uzlabošanas vietu.\n\n{Trīs} būtu vēl labāk...\"",
  "map.[hota] the mysterious island.event.126.description" : "Mēs atkal jutām, kā zeme dreb!\n\nZem šīs salas kaut kas notiek...\n\n...it kā kaut kas {laika gaitā būtu ieguvis spēku}.",
  "map.[hota] the mysterious island.event.127.description" : "Jūs saņemsiet sarkastisku piezīmi:\n\n\"Tik dramatiski...\tSaskaņā ar manu informāciju, Sarkanā Vulkāna spēki tagad katru nedēļu {1. līmeņa} radījumu ražošanu {dubulto} - varbūt pat {trīskāršo}.\n\nAk, un, protams, šī informācija nebija bez maksas... protams.\n\nkrabja kaķis\"",
  "map.[hota] the mysterious island.event.128.description" : "Vēl viena zemestrīce!\n\nŠķiet, ka kaut kas {aug} pazemē...",
  "map.[hota] the mysterious island.event.129.description" : "Vēl viena piezīme no Krapuletto:\n\"Jā... būtībā Redas spēks {pieaug} visu laiku.\"\n\nPašlaik viņu {2. līmeņa} radību ražošana ir {dubultota} - varbūt pat {trīskāršota}.\nLabāk ķerties pie darba, pirms tas pārvēršas par pilnīgu katastrofu...\n\nUn acīmredzot šī mazā informācija nebija bez maksas.\n\nUz redzēšanos!\"",
  "map.[hota] the mysterious island.event.13.description" : "Lūk, mūsu ienākumi jau sesto mēnesi!",
  "map.[hota] the mysterious island.event.130.description" : "Vēl viena zemestrīce!\n\nLabi, šķiet, ka tā notiek ciklos – {katra mēneša sākumā}.",
  "map.[hota] the mysterious island.event.131.description" : "Krapulets smejoties saka:\n\n\"Labi, kaptein Jasna!\n\nTiešām, katra mēneša sākumā Red produkcija palielinās...\n\nTagad viņu {3. līmeņa} vienību produkcija katru nedēļu palielinās daudz vairāk.\n\nPaldies par zeltu un veiksmi!\"",
  "map.[hota] the mysterious island.event.132.description" : "Ai! Vēl viena zemestrīce – visspēcīgākā, kādu jebkad esam piedzīvojuši!\n\nEsam 13. mēneša sākumā...\n\nVai vampīriem, kas kaut ko plāno ap Asinspeldi, varētu izdoties viņu izsaukt?",
  "map.[hota] the mysterious island.event.133.description" : "Krapulets ar nopietnu skatienu:\n\n\"Man nepatīk to teikt, bet viss izskatās drūmi...\n\nPapildus visai tai mēneša beigu izsaukšanai, sarkanie tikko ievērojami {palielināja} savu {4. līmeņa} radību ražošanu.\n\nNu... veiksmi un paldies par resursiem!\"",
  "map.[hota] the mysterious island.event.134.description" : "Tu dzirdi {dēmoniskus smieklus} atbalsojamies no zemes dzīlēm...",
  "map.[hota] the mysterious island.event.135.description" : "\"Ak, un vēl viena lieta: lai jūs zinātu, arī {5. līmeņa} radījumu ražošana ir palielināta Sarkanajam iebrucējam...\n\nJā, diemžēl arī šī informācija nav bezmaksas, bet nudien atzīstiet to — tā ir super noderīga!\"",
  "map.[hota] the mysterious island.event.136.description" : "Vēl viens mēnesis ir pagājis.\n\nŠeit ir jaunie ieraksti no mūsu hronikas:\n\n{=== Žurnāls - 2. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{--------------------------------------}\n{Mēs esam izpētījuši savrupmāju kopš 13. līmeņa.}\n{Šī teritorija ir bagāta ar resursiem.}\n{Šie resursi atbloķē teleportācijas starp mūsu trim pilsētām.}\n{~}\n{Šī teritorija ļauj ceļot pa sešām galvenajām teritorijām,}\n{bet vispirms jums ir jāiegūst nepieciešamās krāsu atslēgas:}\n{ }\n{Frakcijas | Atslēga}\n{__________________}\n{ Zila | Tumši zila}\n{ Dzeltenbrūna | Balta}\n{Zaļa | Zaļa}\n{Oranža | Brūna}\n{Violeta | Violeta}\n{ Zilganzaļa | gaiši zils}\n{~}\n\n{Ilgtermiņa mērķis:}\n{-------------------------------------------\n\n{Uzdevumu devējs netālu no mūsu galvaspilsētas ir lūdzis mums nogalināt pūķus.}\n{Šis ceļš ved pie noslēpumainas un spēcīgas figūras.}\n{~}\n\n{Atjaunināta informācija:}\n{-------------------------------------------\n\n{Ir iespējami kombinēti artefakti.}\n{Dažas daļas tiek iegūtas, veicot uzdevumus vai noteiktās vietās.}\n{~}\n{Paļaušanās uz vienu galveno varoni ir pašnāvība.}\n{Divi būs minimums, lai izdzīvotu.}\n{~}\n{Šomēnes krodziņos ir parādījušās četras baumas:}\n{Tās, kurām ir dzeltens teksts, ir noderīgas.}\n{~}\n_______________________________________________\nIepriekšējais ieraksts (jau izlasīts):\n\n{=== Dienasgrāmata - 1. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{-------------------------------------------\n\n{Izlūks izglābts.}\n{Palīdzēja atjaunot mūsu krāsu atslēgu.}\n{~}\n{Iekarotas divas sekundārās pilsētas.}\n{~}\n\n{Atjaunota informācija:}\n{-------------------------------------------}\n{Diplomātijas prasme nav noderīga,}\n{bet diplomātiskie artefakti ir.}\n{~}\n{Dažas burvestības nav ģildēs,}\n{bet tās var iegūt vēlāk.}\n{~}\n{Pilsētas portāls pastāv, bet mēs to nevaram iegūt ilgu laiku.}\n{Alternatīva ir pieejama no 13. līmeņa.}\n{~}\n{Trūkst zinātnieka,\n{bet tas ir paslēptam tēlam.}\n{~}\n{=== . ===}",
  "map.[hota] the mysterious island.event.137.description" : "Lielgabalu šāvieni atskan no visiem salas nostūriem!\nTas notiek! Ir sākusies koordinēta pirātu uzbrukuma!",
  "map.[hota] the mysterious island.event.14.description" : "Viņš jau ir pavadījis šeit septiņus mēnešus!\nCerams, ka šie resursi mums palīdzēs...",
  "map.[hota] the mysterious island.event.141.description" : "Ir {trīspadsmitā} mēneša sākums.\n\nJa vecajam vīram bija taisnība, mums {jābūt gataviem} \"dēmonisko portālu\" atvēršanai šī mēneša beigās...\n",
  "map.[hota] the mysterious island.event.142.description" : "Pirāti uzbrūk mūsu resursiem!",
  "map.[hota] the mysterious island.event.143.description" : "Mums jālabo pirātu nodarītie postījumi...",
  "map.[hota] the mysterious island.event.144.description" : "Mēs nosūtījām savu speciālistu Eagle Eye diplomātiskā misijā uz citām frakcijām salā.\n\nDiemžēl kopš tā laika neesam no jums dzirdējuši.\nCerēsim, ka nekas nav noticis...",
  "map.[hota] the mysterious island.event.145.description" : "Klīst pat baumas par {Raganu būdu} ūdenī, kas var iemācīt sekundāro prasmi {Skatīties maģiju}.\n\nPat {Barbari}, {Virskungi} un {Algotņi}, kuri parasti to nevar apgūt...",
  "map.[hota] the mysterious island.event.146.description" : "Vēl viens mēnesis ir pagājis.\n\nŠeit ir jaunie ieraksti no mūsu hronikas:\n\n{=== Dienasgrāmata – 3. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{----------------------------------------}\n{Mūsu varonis \"Monētu meistars\" ir pazudis}\n{mēģinot veikt pūķa uzdevumu}\n{vedot pie noslēpumainas figūras.}\n{~}\n{Mums viņš jāmeklē pazemē.}\n{Uzdevumu devējs var atklāt savu atrašanās vietu.}\n{~}\n\n{Atjaunināta informācija:}\n{----------------------------------------}\n{Zagļu ģilde nav uzticama, ja runa ir par Sarkanā un Rozā spēku.}\n{~}\n{Ne visi uzdevumi uz salas ir nepieciešami, lai virzītos uz priekšu.}\n{~}\n{Šomēnes krodziņos ir parādījušās četras jaunas baumas.}\n{~}\n\n___________________________________________\nAutora piezīme:\nŠie mērķi un padomi ir galvenie.\nCiti pastāv un šeit nav uzskaitīti, taču tie var būt ļoti noderīgi.\n______________________________________________\nIepriekšējie ieraksti (jau izlasīti):\n\n{=== Žurnāls - 2. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{---------------------------------------------}\n{Mēs esam izpētījuši savrupmāju kopš 13. līmeņa.}\n{Šī teritorija ir bagāta ar resursiem.}\n{Šie resursi atbloķē teleportācijas starp mūsu trim pilsētām.}\n{~}\n{Šī teritorija ļauj ceļot cauri sešām galvenajām teritorijām,}\n{bet vispirms jums ir jāiegūst nepieciešamās krāsu atslēgas:}\n{ }\n{Frakcijas | Atslēga}\n{__________________}\n{ Zila | Tumši zila}\n{ Dzeltenbrūna | Balta}\n{Zaļa | Zaļa}\n{Oranža | Brūna}\n{Violeta | Violeta}\n{ Zilganzaļa | gaiši zils}\n{~}\n\n{Ilgtermiņa mērķis:}\n{-------------------------------------------}\n{Uzdevumu devējs netālu no mūsu galvaspilsētas ir lūdzis mums nogalināt pūķus.}\n{Šis ceļš ved pie noslēpumainas un spēcīgas figūras.}\n{~}\n\n{Atjaunināta informācija:}\n{------------------------------------------\n\n{Ir iespējami kombinēti artefakti.}\n{Dažas daļas tiek iegūtas, veicot uzdevumus vai noteiktās vietās.}\n{~}\n{Paļaušanās uz vienu galveno varoni ir pašnāvība.}\n{Lai izdzīvotu, būs nepieciešami divi.}\n{~}\n\n_____________________________________________\nPirmais ieraksts (jau izlasīts):\n\n{=== Dienasgrāmata - 1. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{--------------------------------------------------\n\n{Izlūks izglābts.}\n{Palīdzēja atjaunot mūsu krāsu atslēgu.}\n{~}\n{Iekarotas divas sekundāras pilsētas.}\n{~}\n\n{Atjaunināts informācija:}\n{--------------------------------------------}\n{Diplomātijas prasme nav noderīga,}\n{bet diplomātiskie artefakti ir.}\n{~}\n{Dažas burvestības nav ģildēs,}\n{bet tās var iegūt vēlāk.}\n{~}\n{Pilsētas portāls pastāv, bet mēs to nevaram iegūt ilgu laiku.}\n{Alternatīva ir pieejama no 13. līmeņa.}\n{~}\n{Zinātnieka prasmes trūkst,}\n{bet tā ir kādam slēptam tēlam.}\n{~}\n{=== . ===}",
  "map.[hota] the mysterious island.event.147.description" : "Vēl viens mēnesis ir pagājis. Šie ir jaunie ieraksti no mūsu hronikas:\n\n{=== Dienasgrāmata – 4. mēnesis ===}\n\n{Īstermiņa mērķis:}\n{----------------------------------------------}\n{Glābt mūsu varoni \"Monētu meistaru\".}\n{Nodot pūķa uzdevumu uzdevumu devējam.}\n{~}\n\n{Vidēja termiņa mērķis:}\n{-------------------------------------------\n\n{Atrodiet mūsu ērgļa redzes speciālistu.}\n{~}\n\n{Atjaunināta informācija:}\n{------------------------------------------\n\n{Pirāti (Rozā) ir apguvuši klonēšanas burvestību.}\n{~}\n{Šomēnes krodziņos ir parādījušās četras jaunas baumas.}\n{~}\n\n________________________________________________ Iepriekšējie ieraksti (jau izlasīti):\n\n{=== Dienasgrāmata – 3. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{- ...}\n{Mūsu varonis \"Monētu meistars\" pazuda}\n{mēģinot uzbrukt pūķim uzdevums}\n{kas ved pie noslēpumainas figūras.}\n{~}\n{Mums viņš jāmeklē pazemē.}\n{Uzdevuma devējs var atklāt viņa atrašanās vietu.}\n{~}\n\n{Atjaunināta informācija:}\n{--------------------------------------------}\n{Zagļu ģilde nav uzticama attiecībā uz Sarkanā un Rozā spēku.}\n{~}\n{Ne visi uzdevumi uz salas ir nepieciešami, lai virzītos uz priekšu.}\n{~}\n{Šomēnes krogos ir parādījušās četras jaunas baumas.}\n{~}\n\n___________________________________________\nOtrais dienasgrāmatas ieraksts (jau izlasīts):\n\n{=== Dienasgrāmata - 2. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{-------------------------------------------------}\n{Mēs esam izpētījuši savrupmāju kopš 13. līmeņa.}\n{Šī teritorija ir bagāta ar resursiem.}\n{Šie resursi atbloķē teleportētājus starp mūsu trim pilsētām.}\n{~}\n{Šī teritorija ļauj ceļot pa sešām galvenajām teritorijām,}\n{bet vispirms jums ir jāiegūst nepieciešamais krāsainās atslēgas:}\n{ }\n{ Frakcija | Atslēga}\n{__________________}\n{ Zila | Tumši zila}\n{ Dzeltenbrūna | Balta}\n{ Zaļa | Zaļa}\n{ Oranža | Brūna}\n{ Violeta | Violeta}\n{ Zilganzaļa | gaiši zils}\n{~}\n\n{Ilgtermiņa mērķis:}\n{-------------------------------------------}\n{Uzdevumu devējs netālu no mūsu galvaspilsētas ir lūdzis mums nogalināt pūķus.}\n{Šis ceļš ved pie noslēpumainas un spēcīgas figūras.}\n{~}\n\n{Atjaunināta informācija:}\n{------------------------------------------\n\n{Ir iespējami kombinēti artefakti.}\n{Dažas daļas tiek iegūtas, veicot uzdevumus vai noteiktās vietās.}\n{~}\n{Paļaušanās uz vienu galveno varoni ir pašnāvība.}\n{Lai izdzīvotu, būs nepieciešami divi.}\n{~}\n\n_____________________________________________\nPirmais ieraksts (jau izlasīts):\n\n{=== Dienasgrāmata - 1. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{--------------------------------------------------\n\n{Izlūks izglābts.}\n{Palīdzēja atjaunot mūsu krāsu atslēgu.}\n{~}\n{Iekarotas divas sekundāras pilsētas.}\n{~}\n\n{Atjaunināts informācija:}\n{--------------------------------------------}\n{Diplomātijas prasme nav noderīga,}\n{bet diplomātiskie artefakti ir.}\n{~}\n{Dažas burvestības nav ģildēs,}\n{bet tās var iegūt vēlāk.}\n{~}\n{Pilsētas portāls pastāv, bet mēs to nevaram iegūt ilgu laiku.}\n{Alternatīva ir pieejama no 13. līmeņa.}\n{~}\n{Zinātnieka prasmes trūkst,}\n{bet tā ir kādam slēptam tēlam.}\n{~}\n{=== . ===}",
  "map.[hota] the mysterious island.event.148.description" : "Vēl viens mēnesis ir pagājis. Šie ir jaunie ieraksti no mūsu hronikas:\n\n{=== Dienasgrāmata – 5. mēnesis ===}\n\n{Vidēja termiņa mērķis:}\n{--------------------------------------------}\n{Izglābt mūsu varoni Ērgļa Aci.}\n{Viņu tur frakcija, kuras krāsainais sargs bloķē mūsu 6. līmeņa radības mājokli.}\n{~}\n\n{Atjaunināta informācija:}\n{----------------------------------------------}\n{Ērgļa Acs var būt vienīgais veids, kā apgūt noteiktus burvestības.}\n{~}\n{Ir veids, kā atrast Grālu bez jebkādām krāsainām atslēgām.}\n{~}\n{Lai satiktu noslēpumaino un spēcīgo figūru zem salas,}\n{mums ir nepieciešamas visas sešas krāsainās atslēgas...}\n{un jāšķērso pazemes upe.}\n{Tiek teikts, ka šim tēlam piemīt Zinātnieka prasme.}\n{~}\n{Ienaidnieka sakaušana ar pilnu inventāru var izraisīt ienaidnieka artefaktu zaudēšanu.}\n{Citi artefakti ir jāpārdod vai jāpārveido par XP,}\n{bet noderīgi, lai paturēt.}\n{~}\n{Krogos parādījušās četras jaunas baumas.}\n{~}\n\n____________________________________________\nIepriekšējie ieraksti (jau izlasīti):\n\n{=== Dienasgrāmata – 4. mēnesis ===}\n\n{Īstermiņa mērķis:}\n{-------------------------------------------\n\n{Glābt mūsu varoni \"Monētu meistaru\".}\n{Nodot pūķa uzdevumu uzdevumu devējam.}\n{~}\n\n{Vidēja termiņa mērķis:}\n{-------------------------------------------\n{Atrodiet mūsu ērgļa redzes speciālistu.}\n{~}\n\n{Atjaunināta informācija:}\n{------------------------------------------\n{Pirāti (Rozā) ir apguvuši klonēšanas burvestību.}\n{~}\n{Šomēnes krogos parādījušās četras jaunas baumas.}\n{~}\n\n____________________________________________\nTrešais dienasgrāmatas ieraksts (jau izlasīts):\n\n{=== Dienasgrāmata – 3. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{-----------------------------------------------}\n{Mūsu varonis \"Monētu meistars\" pazuda}\n{mēģinot veikt pūķa uzdevumu}\n{vedot pie noslēpumainas figūras.}\n{~}\n{Mums viņš jāmeklē pazemē.}\n{Uzdevumu devējs var atklāt savu atrašanās vietu.}\n{~}\n\n{Atjaunināta informācija:}\n{-----------------------------------------\n{Zagļu ģilde nav uzticama attiecībā uz Sarkanās un Rozā krāsas spēku.}\n{~}\n{Ne visi uzdevumi uz salas ir nepieciešami, lai virzītos uz priekšu.}\n{~}\n{Šomēnes krodziņos ir parādījušās četras jaunas baumas.}\n{~}\n\n___________________________________________\nOtrais žurnāla ieraksts (jau izlasīts):\n\n{=== Žurnāls - 2. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{-------------------------------------------------}\n{Mēs esam izpētījuši savrupmāju kopš 13. līmeņa.}\n{Šī teritorija ir bagāta ar resursiem.}\n{Šie resursi atbloķē teleportācijas starp mūsu trim pilsētas.}\n{~}\n{Šajā apgabalā var ceļot pa sešām galvenajām teritorijām,}\n{bet vispirms ir jāiegūst nepieciešamās krāsu atslēgas:}\n{ }\n{Frakcijas | Atslēga}\n{_________________}\n{Zila | Tumši zila}\n{Dzeltenbrūna | Balta}\n{Zaļa | Zaļa}\n{Oranža | Brūna}\n{Violeta | Violeta}\n{Zirgkrāsas | gaiši zils}\n{~}\n\n{Ilgtermiņa mērķis:}\n{-------------------------------------------}\n{Uzdevumu devējs netālu no mūsu galvaspilsētas ir lūdzis mums nogalināt pūķus.}\n{Šis ceļš ved pie noslēpumainas un spēcīgas figūras.}\n{~}\n\n{Atjaunināta informācija:}\n{------------------------------------------\n\n{Ir iespējami kombinēti artefakti.}\n{Dažas daļas tiek iegūtas, veicot uzdevumus vai noteiktās vietās.}\n{~}\n{Paļaušanās uz vienu galveno varoni ir pašnāvība.}\n{Lai izdzīvotu, būs nepieciešami divi.}\n{~}\n\n_____________________________________________\nPirmais ieraksts (jau izlasīts):\n\n{=== Dienasgrāmata - 1. mēnesis ===}\n\n{Īstermiņa mērķi:}\n{--------------------------------------------------\n\n{Izlūks izglābts.}\n{Palīdzēja atjaunot mūsu krāsu atslēgu.}\n{~}\n{Iekarotas divas sekundāras pilsētas.}\n{~}\n\n{Atjaunināts informācija:}\n{--------------------------------------------}\n{Diplomātijas prasme nav noderīga,}\n{bet diplomātiskie artefakti ir.}\n{~}\n{Dažas burvestības nav ģildēs,}\n{bet tās var iegūt vēlāk.}\n{~}\n{Pilsētas portāls pastāv, bet mēs to nevaram iegūt ilgu laiku.}\n{Alternatīva ir pieejama no 13. līmeņa.}\n{~}\n{Zinātnieka prasmes trūkst,}\n{bet tā ir kādam slēptam tēlam.}\n{~}\n{=== . ===}",
  "map.[hota] the mysterious island.event.149.description" : "Vēl viens mēnesis ir pagājis.\n\nŠeit ir jaunie ieraksti no mūsu hronikas:\n\n{=== Dienasgrāmata - 6. mēnesis ===}\n\n{Īstermiņa mērķis:}\n{---------------------------------------------}\n{Sagatavoties koordinētam uzbrukumam no pirātiem (Rozā).}\n{~}\n\n{Ilgtermiņa mērķis:}\n{------------------------------------------}\n{Iekarot visu salu un iegūt sešu krāsu atslēgas.}\n{Pēc tam atrodiet noslēpumaino figūru, kas paslēpta zem salas.}\n{~}\n\n{Atjaunināta informācija:}\n{-------------------------------------------}\n{Pirāti plāno koordinētu uzbrukumu.}\n{Punduru spiegs Krapulets pārdeva mums precīzus uzbrukumu laikus un vietas.}\n{~}\n{Krodziņos ir parādījušās četras jaunas baumas.}\n{~}\n\n__________________________________________\nAutora atgādinājums:\n\nŠie mērķi un padomi ir galvenie.\nCiti pastāv un šeit nav uzskaitīti, bet var būt ļoti noderīgi.\n______________________________________________\nIepriekšējie ieraksti (jau izlasīti):\n\n{=== Dienasgrāmata – 5. mēnesis ===}\n\n{Vidēja termiņa mērķis:}\n{----------------------------------------------}\n{Glābiet mūsu varoni Ērgļa Aci.}\n{Viņu tur frakcija, kuras krāsainais sargs bloķē mūsu 6. līmeņa radījumu mājokli.}\n{~}\n\n{Atjaunināta informācija:}\n{------------------------------------------\n\n{Ērgļa Acs var būt vienīgais veids, kā apgūt noteiktus burvestības.}\n{~}\n{Ir veids, kā atrast Grālu bez jebkādām krāsainām atslēgām.}\n{~}\n{Lai satiktu noslēpumaino un spēcīgo figūru zem salas,}\n{mums ir nepieciešamas visas sešas krāsainās atslēgas...}\n{un jāšķērso pazemes upe.}\n{Tiek teikts, ka šim tēlam piemīt Zinātnieka prasme.}\n{~}\n{Ienaidnieka sakaušana ar pilnu inventāru var izraisīt ienaidnieka artefaktu zaudēšanu.}\n{Citi artefakti būtu jāpārdod vai jāpārveido par XP,}\n{bet noderīgie būtu paturēts.}\n{~}\n{Krogos parādījušās četras jaunas baumas.}\n{~}\n\n____________________________________________\nCeturtais ieraksts (jau izlasīts):\n\n{=== D
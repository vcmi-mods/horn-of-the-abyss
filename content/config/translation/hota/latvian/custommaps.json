  "map.[hota] purgatory.sign.48.79.1.message" : "Šeit guļ fanātiskie Harija Potera fani, kuri domā, ka filmas ir labas",
  "map.[hota] purgatory.sign.50.161.1.message" : "Mangrovju sakopšana\nLūdzu, neatstājiet atkritumus visur",
  "map.[hota] purgatory.sign.52.137.1.message" : "Mangrovju sakopšana\nLūdzu, neatstājiet atkritumus visur",
  "map.[hota] purgatory.sign.57.65.1.message" : "Šeit guļ kristāla atkarīgie",
  "map.[hota] purgatory.sign.60.98.0.message" : "Garais ceļš (ziemeļrietumu gals)",
  "map.[hota] purgatory.sign.62.50.1.message" : "Šajā Pandoras lādē jūs atradīsiet visas pazudušās dvēseles, kuras uzskatīja, ka Gredzenu pavēlnieka filmu paplašinātās versijas ir \"pārāk garas\".",
  "map.[hota] purgatory.sign.64.27.1.message" : "Vieta, kas rezervēta visiem ekstrēmajiem MCU faniem.",
  "map.[hota] purgatory.sign.68.32.1.message" : "Vils Vils Smits Smits Vils Smits?",
  "map.[hota] purgatory.sign.68.5.1.message" : "Šeit apmetas visi Dr. Who fani, kas pārāk bieži teica \"REZERVĒT!\".",
  "map.[hota] purgatory.sign.69.99.1.message" : "Šeit guļ fanātiskie Harija Potera fani, kuri domā, ka filmas ir labas",
  "map.[hota] purgatory.sign.70.40.1.message" : "Šeit apmetas visi GOT fani, kas nomira, gaidot pēdējās grāmatas.",
  "map.[hota] purgatory.sign.71.46.1.message" : "Ja nezini, kas viņi ir, šī vieta ir rezervēta tev. Blekdžeks un prostitūtas nav atļautas.",
  "map.[hota] purgatory.sign.72.129.1.message" : "Mangrovju sakopšana\nLūdzu, neatstājiet atkritumus visur",

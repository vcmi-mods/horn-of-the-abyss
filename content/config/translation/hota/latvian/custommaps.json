  "map.[hota] purgatory.sign.225.32.0.message" : "Odisejs joprojām ir ļoti dusmīgs par to, kas ar viņu notika.",
  "map.[hota] purgatory.sign.227.101.0.message" : "Ja ienaidnieks uzbrūk no augšas, tev absolūti jāprot noturēties uz zemes.",
  "map.[hota] purgatory.sign.228.12.1.message" : "Profesors Džons Letsfindsomeshut",
  "map.[hota] purgatory.sign.228.142.1.message" : "Universitāte šķīstītavā",
  "map.[hota] purgatory.sign.23.230.0.message" : "Reiz dzīvoja goblins, kura vārds jau sen ir aizmirsts.\nViņš savā rasē nebija nekas īpašs.",
  "map.[hota] purgatory.sign.230.10.1.message" : "Kāpnes uz debesīm",
  "map.[hota] purgatory.sign.230.35.0.message" : "Mēs par šo īsti neko nezinām.",
  "map.[hota] purgatory.sign.231.196.1.message" : "Zilās telts atslēgu meistaram",
  "map.[hota] purgatory.sign.233.38.1.message" : "Tikai sacensību dalībniekiem. Atvainojiet. :)",
  "map.[hota] purgatory.sign.236.76.0.message" : "TURIETIES!\nMēs nelaidīsim ārā pūķu mednieku!",
  "map.[hota] purgatory.sign.239.82.0.message" : "TURIETIES!\nMēs nelaidīsim ārā Pūķu Imperatoru!",
  "map.[hota] purgatory.sign.248.208.1.message" : "Paldies par spēlēšanu, ceru, ka patika! :)",
  "map.[hota] purgatory.sign.250.10.1.message" : "Debesu sūdu upe",
  "map.[hota] purgatory.sign.30.230.0.message" : "Laipni lūgti Goblinu pilsētā!\nĻaujiet man pastāstīt jums mūsu tautas lielāko leģendu!",
  "map.[hota] purgatory.sign.30.50.0.message" : "Purpura telts atslēgu meistaram",
  "map.[hota] purgatory.sign.32.224.0.message" : "Tikai sacensību dalībniekiem. Atvainojiet. :)",

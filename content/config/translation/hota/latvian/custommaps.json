  "map.[hota] element land.sign.173.99.1.message" : "Zemūdens cietoksnis",
  "map.[hota] element land.sign.174.5.1.message" : "Dzīvības un nāves templis",
  "map.[hota] element land.sign.175.245.0.message" : "Element Land, autors Tadang, 2019.\n\nKarte, kas iedvesmota no \"crapcore\". Paldies par spēlēšanu!",
  "map.[hota] element land.sign.176.192.1.message" : "Šeit atrodas vienīgā ļaundaru midzenis visā pasaulē!",
  "map.[hota] element land.sign.179.200.0.message" : "TURIETIES.",
  "map.[hota] element land.sign.188.98.0.message" : "Nakts ir tumša un pilna baiļu.",
  "map.[hota] element land.sign.197.1.1.message" : "Sveiki, esmu formu mainītājs, kas izliekas par zīmi. Lūdzu, nāciet iekšā.",

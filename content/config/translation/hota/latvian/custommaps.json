  "map.[hota] might and magic.guards.179.11.0.message" : "TUKSNESIS\n\nCeļa meklētāja bonuss:",
  "map.[hota] might and magic.guards.179.113.1.message" : "\"Zemes gari neļaus necienīgajiem atklāt savus noslēpumus. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.180.4.0.message" : "Arčibalds:\n\"Šai kastei tika dots nosaukums - \"LIECNIEKS\". Tā satur lielu daudzumu maģiskas enerģijas. Varbūt slepkavības, ko eņģeļi organizē šajās vietās, nav saistītas tikai ar dēmonu dzimšanu, bet arī ar šo kasti, ko viņiem izdevās iegūt...\"",
  "map.[hota] might and magic.guards.181.204.0.message" : "Kad ieņemsi torni, tā uzkrātā maģiskā enerģija sāks tevi virzīt.",
  "map.[hota] might and magic.guards.182.159.1.message" : "LAVAS TUNEĻI\n\nCeļa meklētāja bonuss:",
  "map.[hota] might and magic.guards.183.21.0.message" : "Arčibalds:\n\"Šī ir bezvārda Pandoras lāde. Es tajā nejūtu nekādu būtisku maģisku enerģiju, izņemot to, kas nepieciešama šīs lādes pastāvēšanai. Lai gan dažreiz es varu kļūdīties.\"",
  "map.[hota] might and magic.guards.183.240.0.message" : "ŪDENS DOMAINS\n\nCeļa meklētāja bonuss:",
  "map.[hota] might and magic.guards.184.212.1.message" : "\"Uguns Gari neļaus saviem noslēpumiem tikt atklātiem necienīgajiem. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.184.54.1.message" : "Arčibalds:\n\"Šī kaste ir pārpildīta ar maģisku enerģiju. Kaut kas, ar ko jūs varat saskarties, to atverot, ir ārkārtīgi bīstams. Šīs kastes nosaukums izklausās pēc \"MISTISKA PAKTA\".\"",
  "map.[hota] might and magic.guards.185.230.0.message" : "Arčibalds:\n\"Šī ir bezvārda Pandoras lāde. Es tajā nejūtu nekādu būtisku maģisku enerģiju, izņemot to, kas nepieciešama šīs lādes pastāvēšanai. Lai gan dažreiz es varu kļūdīties.\"",
  "map.[hota] might and magic.guards.185.48.0.message" : "Kad ieņemsi torni, tā uzkrātā maģiskā enerģija sāks tevi virzīt.",
  "map.[hota] might and magic.guards.185.73.0.message" : "Arčibalds:\n\"Šī ir bezvārda Pandoras lāde. Es tajā nejūtu nekādu būtisku maģisku enerģiju, izņemot to, kas nepieciešama šīs lādes pastāvēšanai. Lai gan dažreiz es varu kļūdīties.\"",
  "map.[hota] might and magic.guards.185.82.1.message" : "\"Ūdens Gari neļaus saviem noslēpumiem tikt atklātiem necienīgajiem. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.187.107.1.message" : "\"Uguns Gari neļaus saviem noslēpumiem tikt atklātiem necienīgajiem. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.187.249.0.message" : "Arčibalds:\n\"Šai kastītei ir dots nosaukums — \"PĒRLE\". Tajā ir ievērojams daudzums maģiskas enerģijas.\"",
  "map.[hota] might and magic.guards.189.53.1.message" : "\"Uguns Gari neļaus saviem noslēpumiem tikt atklātiem necienīgajiem. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.19.190.1.message" : "Arčibalds:\n\"Šī ir bezvārda Pandoras lāde. Es tajā nejūtu nekādu būtisku maģisku enerģiju, izņemot to, kas nepieciešama šīs lādes pastāvēšanai. Lai gan dažreiz es varu kļūdīties.\"",

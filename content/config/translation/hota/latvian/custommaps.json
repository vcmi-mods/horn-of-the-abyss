  "map.[hota] might and magic.guards.76.146.0.message" : "ZIEMEĻU AVAUNTNELLA\n\nCeļa meklētāja bonuss:",
  "map.[hota] might and magic.guards.76.190.1.message" : "Dižciltīgie Krīlūdas karotāji, kas nav pakļāvušies Triumvirāta tirānijai, ir iesprostoti šajā Pandoras lādē. Vai vēlaties atbrīvot viņu važas?\n",
  "map.[hota] might and magic.guards.77.18.0.message" : "Arčibalds:\n\"Šī ir bezvārda Pandoras lāde. Es tajā nejūtu nekādu būtisku maģisku enerģiju, izņemot to, kas nepieciešama šīs lādes pastāvēšanai. Lai gan dažreiz es varu kļūdīties.\"",
  "map.[hota] might and magic.guards.77.186.0.message" : "Arčibalds:\n\"Šī ir bezvārda Pandoras lāde. Es tajā nejūtu nekādu būtisku maģisku enerģiju, izņemot to, kas nepieciešama šīs lādes pastāvēšanai. Lai gan dažreiz es varu kļūdīties.\"",
  "map.[hota] might and magic.guards.78.225.1.message" : "Arčibalds:\n\"Es domāju, ka arī tu vari sajust vareno maģisko enerģiju, kas ieslēgta šajā Pandoras lādē. Tai ir dots nosaukums \"DRAUDU CEĻŠ\"\"",
  "map.[hota] might and magic.guards.79.107.1.message" : "\"Ūdens Gari neļaus saviem noslēpumiem tikt atklātiem necienīgajiem. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.79.117.0.message" : "Arčibalds:\n\"Šī ir bezvārda Pandoras lāde. Es tajā nejūtu nekādu būtisku maģisku enerģiju, izņemot to, kas nepieciešama šīs lādes pastāvēšanai. Lai gan dažreiz es varu kļūdīties.\"",
  "map.[hota] might and magic.guards.8.137.1.message" : "Arčibalds:\n\"Šai kastei ir dots nosaukums — \"STOICISM\". Tajā ir ievērojams daudzums maģiskas enerģijas.\"",
  "map.[hota] might and magic.guards.81.217.1.message" : "\"Ūdens Gari neļaus saviem noslēpumiem tikt atklātiem necienīgajiem. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.81.69.1.message" : "\"Zemes gari neļaus necienīgajiem atklāt savus noslēpumus. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.82.184.1.message" : "\"Zemes gari neļaus necienīgajiem atklāt savus noslēpumus. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.83.55.1.message" : "Nemierīgas dvēseles aiznes Dvēseļu upes tumšā straume. Šie ūdeņi ir dziļi satraucoši un var saistīt pat visdrosmīgāko sirdi.",
  "map.[hota] might and magic.guards.83.56.1.message" : "DVĒSELES UPE\n\nCeļa meklētāja bonuss:",
  "map.[hota] might and magic.guards.84.92.0.message" : "Smaragda kalni\n\nCeļa meklētāja bonuss:",

  "map.[hota] the mysterious island.monster.23.96.1.message" : "Ņau!",
  "map.[hota] the mysterious island.monster.231.11.1.message" : "Kas?! Vai tas bija viens no maniem {4} skorbuta {brāļiem}, ​​kas mani nodeva?\nNē!\nTu nedabūsi manu zeltu, ne tagad, ne nekad!",
  "map.[hota] the mysterious island.monster.231.218.1.message" : "Rituāls jau ir sācies, neviens to nevar apturēt!\n\nDēmoniskais portāls tiks atvērts {13.} mēneša {beigās}!\n\nMUAHAHAHAHAHAHAHA! (dēmoniski smiekli).\n\n\";...;\"",
  "map.[hota] the mysterious island.monster.232.161.0.message" : "Sveiks, kaptein!\n\nVarbūt mums vajadzētu {izrakt} šo pludmali, lai novērstu kuģu piestātni šeit?",
  "map.[hota] the mysterious island.monster.235.127.1.message" : "Sveiki! Mūsu varonis Monētu meistars mani atstāja šeit ar ziņu:\nviņi dodas izpētīt {pazemes upi}!",
  "map.[hota] the mysterious island.monster.235.214.0.message" : "Bākas sargi jūk prātā, sakot dīvainas lietas:\n\n\"Nēēē! Mums nevajadzēja kļūt par fangarmiem vai lichiem! Miraks, kādu artefaktu tu man iedevi?!\"",
  "map.[hota] the mysterious island.monster.237.242.1.message" : "Tu neizturēsi!",
  "map.[hota] the mysterious island.monster.237.94.1.message" : "{NEAUTORIZĒTA}\n{PIEEJA}\n1011001 1101111 1110101 100000 1110011 1101000 1100001 1101100 1100001 1101100 1101100 100000 1101110 1101111 1110011 100001\n\n",
  "map.[hota] the mysterious island.monster.239.134.1.message" : "\"Mundus? Atkal tu?!\"",
  "map.[hota] the mysterious island.monster.239.90.0.message" : "Zināšanas ir spēks.",
  "map.[hota] the mysterious island.monster.239.97.0.message" : "\"Stop! Lai turpinātu, jums būs nepieciešama C veidlapa, divreiz apzīmogota, goblinu uzrauga parakstīta un pieejama tikai B12 birojā trešajā stāvā... kas var pastāvēt vai nebūt.\"",
  "map.[hota] the mysterious island.monster.242.157.0.message" : "Neaiztieciet!",
  "map.[hota] the mysterious island.monster.242.245.1.message" : "Dēmoniski dēmoni ir sasējuši mūsu māti {alā} starp Konfluksu un Bāku!\nTu degsi viņu dēļ...",
  "map.[hota] the mysterious island.monster.243.155.1.message" : "Govju līmenī!",
  "map.[hota] the mysterious island.monster.244.145.1.message" : "\"Mēs esam Šmargonrogas pūķi — nometieties ceļos vai pārvērtieties pelnos!\"",
  "map.[hota] the mysterious island.monster.245.161.0.message" : "Jāāāā!",
  "map.[hota] the mysterious island.monster.247.103.1.message" : "\"Ļauj sevi sadedzināt ugunī!\"",
  "map.[hota] the mysterious island.monster.247.163.0.message" : "Šī ir MANA pludmale, kuce!",
  "map.[hota] the mysterious island.monster.250.90.1.message" : "\"{Čūskas}... kāpēc gan lai būtu jābūt {čūskām}?\"",
  "map.[hota] the mysterious island.monster.27.164.1.message" : "\"Tagad jūs redzēsiet Liču Karaļa patieso spēku.\"",
  "map.[hota] the mysterious island.monster.29.123.1.message" : "Kas?! Vai tas bija viens no maniem {4} skorbuta {brāļiem}, ​​kas mani nodeva?\nNē!\nTu nedabūsi manu zeltu, ne tagad, ne nekad!",
  "map.[hota] the mysterious island.monster.29.187.0.message" : "\"Esmu rūķis un rokot bedri\nRok, rok, rok, rok, rok\nEsmu rūķis un rokot bedri\nRoc bedri, rok bedri!...\"\n\n\"Hei! Tas ir mans ZELTS!\"",
  "map.[hota] the mysterious island.monster.31.204.0.message" : "MANA mīļā!",
  "map.[hota] the mysterious island.monster.32.201.0.message" : "b b bb b b braraaiiiin",
  "map.[hota] the mysterious island.monster.34.159.1.message" : "\"Mēs esam Šmargonrogas pūķi — nometieties ceļos vai pārvērtieties pelnos!\"",
  "map.[hota] the mysterious island.monster.36.213.0.message" : "Hei!\n\nVarbūt mums vajadzētu {izrakt} šo pludmali, lai apturētu viņu pirātu kuģu piestātni šeit, vai ne?",
  "map.[hota] the mysterious island.monster.37.188.1.message" : "īgns.",
  "map.[hota] the mysterious island.monster.37.195.1.message" : "Dēmoniski dēmoni ir sasējuši mūsu māti {alā} starp Konfluksa pilsētu un Bāku!\nTu par to sadegs...",
  "map.[hota] the mysterious island.monster.37.206.0.message" : "\"Zeķe!\"",
  "map.[hota] the mysterious island.monster.37.35.0.message" : "Sasodītie odi!",
  "map.[hota] the mysterious island.monster.38.73.0.message" : "\"Nēēē! Mums nevajadzēja kļūt par fangarmiem vai lichiem! Miraks, kādu artefaktu tu iedevi?!\"",
  "map.[hota] the mysterious island.monster.4.69.1.message" : "Mammu!",
  "map.[hota] the mysterious island.monster.43.189.0.message" : "\"Parlay? Tas taču ir tas ar \"P\", vai ne?\"",
  "map.[hota] the mysterious island.monster.43.74.1.message" : "<3",
  "map.[hota] the mysterious island.monster.44.231.0.message" : "Šššš!",
  "map.[hota] the mysterious island.monster.46.35.0.message" : "\"Es satiku troļļu, ejot pa mežu\nViņš vilka sev līdzi sasietu elfu\n\nAk, cik viņš ir stiprs, cik skaists!\n\nAk, cik liels ir mans draugs Haosa trollis!\n\nEs viņam saku: draugs, ko tu ar šo vīrieti darīsi?\n\nViņš atbild: es to ēdīšu, pildīti āboli...\"\n\n--\nAutora piezīme:\nŠī ir franču dziesma no ļoti populāras MP3 sāgas franciski runājošo gīku vidū ar nosaukumu {Le Donjon de Naheulbeuk}.",
  "map.[hota] the mysterious island.monster.47.97.1.message" : "Kas?! Vai tas bija viens no maniem {4} skorbuta {brāļiem}, ​​kas mani nodeva?\nNē!\nTu nedabūsi manu zeltu, ne tagad, ne nekad!",
  "map.[hota] the mysterious island.monster.49.84.1.message" : "\"Es tevi nolādu mūžīgi vārdā, es tevi svētīju mūžīgi nāvē.\"",
  "map.[hota] the mysterious island.monster.50.165.1.message" : "Sveiki! Mūsu varonis Monētu meistars mani atstāja šeit ar ziņu:\nviņi dodas izpētīt {pazemes upi}!",
  "map.[hota] the mysterious island.monster.53.118.0.message" : "Bākas sargi ir sajukuši prātā, runājot dīvainas lietas:\n\n\"Nē! Mēs netiksim pārvērsti par fangarmām vai ličām! Miraks, kādu ārprātu tu esi laidis vaļā?\"",
  "map.[hota] the mysterious island.monster.53.37.1.message" : "Pirāti ielauzās šeit un nozaga zobenu \"{Mirušā bruņinieka melnā lauskas}\"!\n\nMĒS atriebsimies jums!\n\nMēs atriebsimies jums!\n",
  "map.[hota] the mysterious island.monster.55.181.1.message" : "NEDRĪKST PAGĀT!",
  "map.[hota] the mysterious island.monster.56.192.0.message" : "Uzņemt slēpni, iedurt mugurā, iedurt mugurā, izķidāt!\n",
  "map.[hota] the mysterious island.monster.56.79.0.message" : "APTURIET DĒMONU SAIMNIECĪBU\nAPTURIET FANGARMU SAIMNIECĪBU\nAPTURIET LICH SAIMNIECĪBU",
  "map.[hota] the mysterious island.monster.57.209.0.message" : "\"Es kādreiz biju piedzīvojumu meklētājs, tāpat kā tu... tad man celī trāpīja bulta.\"",
  "map.[hota] the mysterious island.monster.57.231.1.message" : "\"Mēs esam staigājošie miroņi...\n\nJūs varat elpot. Jūs varat mirkšķināt. Jūs varat raudāt. Pie velna, jūs visi to darīsiet.\"",
  "map.[hota] the mysterious island.monster.58.196.0.message" : "GRUIIK!",
  "map.[hota] the mysterious island.monster.58.200.0.message" : "Šis mežs ir pietiekami cietis, ej prom!\n\n",
  "map.[hota] the mysterious island.monster.58.203.1.message" : "Ieelpo šo smalko, puvušo gaisu... un mirsti!",
  "map.[hota] the mysterious island.monster.6.189.0.message" : "Neskaties!\nTu tāpat nekad ieeju neatradīsi!",
  "map.[hota] the mysterious island.monster.61.131.1.message" : "\"Hmm, nepieteikti apmeklētāji. Jāveic sagatavošanās darbi...\"",
  "map.[hota] the mysterious island.monster.61.36.0.message" : "Uzbrukums, dūriens mugurā, dūriens mugurā, izķidāšana, pazušana...\n\n... Lēts šāviens, sakropļot, sakropļot, /lol, niere, sakropļot, sagatavošanās, pazušana...\n\n... dūriens mugurā, dūriens mugurā, /skūpsts, /deja",
  "map.[hota] the mysterious island.monster.62.202.0.message" : "Dēmoniskas šausmas ir iedzina mūsu māti {alā} \"starp Saplūšanu un Bāku!\nJūs sadedzināsiet par viņu noziegumiem...",
  "map.[hota] the mysterious island.monster.63.204.0.message" : "Ko tu te dari?!",
  "map.[hota] the mysterious island.monster.65.190.1.message" : "Mūūū!",
  "map.[hota] the mysterious island.monster.65.33.0.message" : "Jārr!",
  "map.[hota] the mysterious island.monster.69.31.1.message" : "audums!",
  "map.[hota] the mysterious island.monster.69.62.1.message" : "*violets*",
  "map.[hota] the mysterious island.monster.7.81.0.message" : "Beidzot!\nEsmu ieradies, lai veidotu savu laimi jau sen. Biju pārliecināts, ka šajā salā ir kaut kas labs un arī puisis ar vardi...\n\nBet tā ir necaurredzama!\nTo var apmeklēt tikai {lidojošas} radības...",
  "map.[hota] the mysterious island.monster.72.167.0.message" : "Apžēlojies, Kungs, glāb mūs!",
  "map.[hota] the mysterious island.monster.72.7.1.message" : "Sveiki!",
  "map.[hota] the mysterious island.monster.74.15.1.message" : "Kas?! Vai tas bija viens no maniem {4} skorbuta {brāļiem}, ​​kas mani nodeva?\nNē!\nTu nedabūsi manu zeltu, ne tagad, ne nekad!",
  "map.[hota] the mysterious island.monster.74.167.1.message" : "\"Mēs esam Šmargonrogas pūķi — nometieties ceļos vai pārvērtieties pelnos!\"",
  "map.[hota] the mysterious island.monster.74.71.0.message" : "\"Hmm, nepieteikti apmeklētāji. Jāveic sagatavošanās darbi...\"",
  "map.[hota] the mysterious island.monster.75.176.0.message" : "Sadedzini ķecerus!",
  "map.[hota] the mysterious island.monster.75.69.0.message" : "Ko, pie velna, tu te dari?!",
  "map.[hota] the mysterious island.monster.76.196.0.message" : "V! Atnesiet man krūmus!",
  "map.[hota] the mysterious island.monster.77.159.0.message" : "Lokators!",
  "map.[hota] the mysterious island.monster.77.168.0.message" : "Ej ellē, tu negantība!",
  "map.[hota] the mysterious island.monster.77.169.1.message" : "\"Mundus? Atkal tu?!\"",
  "map.[hota] the mysterious island.monster.77.181.0.message" : "Urīns!",
  "map.[hota] the mysterious island.monster.78.179.1.message" : "Ej uz elli.",
  "map.[hota] the mysterious island.monster.80.104.1.message" : "Tu neizturēsi!\n\nTu esi {uz šosejas uz elli}!",
  "map.[hota] the mysterious island.monster.80.160.1.message" : "mans kungs.",
  "map.[hota] the mysterious island.monster.81.162.1.message" : "Sveiki! Mūsu varonis Monētu meistars mani atstāja šeit ar ziņu:\nviņi dodas izpētīt {pazemes upi}!",
  "map.[hota] the mysterious island.monster.84.21.1.message" : "lūdzu... palīdziet...",
  "map.[hota] the mysterious island.monster.85.111.1.message" : "Lai nolādēts!",
  "map.[hota] the mysterious island.monster.85.76.1.message" : "Dod man savas asinis!",
  "map.[hota] the mysterious island.monster.86.72.1.message" : "Peons.",
  "map.[hota] the mysterious island.monster.87.166.0.message" : "Govju līmenis?",
  "map.[hota] the mysterious island.monster.87.184.0.message" : "\"Es kādreiz biju piedzīvojumu meklētājs, tāpat kā tu... tad man celī trāpīja bulta.\"",
  "map.[hota] the mysterious island.monster.87.231.0.message" : "Ššššš...",
  "map.[hota] the mysterious island.monster.89.163.0.message" : "Nebarojiet troļļus!",
  "map.[hota] the mysterious island.monster.91.115.1.message" : "Melnais bruņinieks: \"{Neviens neizturēs.}\"",
  "map.[hota] the mysterious island.monster.91.145.0.message" : "\"Zeķe!\"",
  "map.[hota] the mysterious island.monster.91.181.1.message" : "Par karali un valsti!",
  "map.[hota] the mysterious island.monster.92.181.0.message" : "Braiiii.",
  "map.[hota] the mysterious island.monster.93.10.0.message" : "\"Nē... Mēs nevēlamies kļūt par fangarmiem vai lichiem. Šis nav mūsu ceļš. Miraks, ko tu mums esi uzlicis?\"",
  "map.[hota] the mysterious island.monster.94.228.0.message" : "bzzzzzzzzzz!",
  "map.[hota] the mysterious island.monster.94.3.1.message" : "Ko tu te dari?!",
  "map.[hota] the mysterious island.monster.95.141.1.message" : "Grumpf!",
  "map.[hota] the mysterious island.monster.95.181.1.message" : "Gaismas dēļ!",
  "map.[hota] the mysterious island.monster.96.116.1.message" : "\"Pat nāvē tu neatradīsi mieru.\"",
  "map.[hota] the mysterious island.monster.97.145.0.message" : "Ej uz elli! Riebums!",
  "map.[hota] the mysterious island.monster.97.99.1.message" : "\"Laipni lūgti Los Squelettos! Lai vai jūs būtu draugi vai ienaidnieki, mums vienalga.\"",
  "map.[hota] the mysterious island.monster.98.173.0.message" : "Mums šis {sērs} ir vajadzīgs mūsu rituālam. Ejiet prom!",
  "map.[hota] the mysterious island.monster.98.186.1.message" : "NE. AIZSKĀRIET. MŪMIŅA.",
  "map.[hota] the mysterious island.quest.0.179.0.completed" : "KABOOM!",
  "map.[hota] the mysterious island.quest.0.179.0.firstVisit" : "Lai gan vējus jau var notvert {pa gaisu}, akmeņu attīrīšana ļaus jums tos sasniegt arī {pa jūru}.\n\nŠie {labvēlīgie vēji} pilnībā {atjauno} jūsu {pārvietošanās punktus}.\n\nTam būs nepieciešami {resursi} sprāgstvielām un {zelts} sapieru apmaksai.",
  "map.[hota] the mysterious island.quest.0.179.0.nextVisit" : "Lai gan vējus jau var notvert {pa gaisu}, akmeņu attīrīšana ļaus jums tos sasniegt arī {pa jūru}.\n\nŠie {labvēlīgie vēji} pilnībā {atjauno} jūsu {pārvietošanās punktus}.\n\nTam būs nepieciešami {resursi} sprāgstvielām un {zelts} sapieru apmaksai.",
  "map.[hota] the mysterious island.quest.10.161.0.completed" : "Lieliski! Izpētīsim plašās jūras un to noslēpumus... kas zina, varbūt pat atradīsim Grālu!",
  "map.[hota] the mysterious island.quest.10.161.0.firstVisit" : "Atklātā jūra ir bīstama — pirms došanās turp mums līdzi vajadzētu būt vismaz {vienam kristāla pūķim}.",
  "map.[hota] the mysterious island.quest.10.161.0.nextVisit" : "Bez {viena kristāla pūķa} mēs nevarēsim iekļūt atklātā jūrā.",
  "map.[hota] the mysterious island.quest.10.93.0.completed" : "KABOOM!",
  "map.[hota] the mysterious island.quest.10.93.0.firstVisit" : "Lai gan vējus jau var notvert {pa gaisu}, akmeņu attīrīšana ļaus jums tos sasniegt arī {pa jūru}.\n\nŠie {labvēlīgie vēji} pilnībā {atjauno} jūsu {pārvietošanās punktus}.\n\nTam būs nepieciešami {resursi} sprāgstvielām un {zelts} sapieru apmaksai.",
  "map.[hota] the mysterious island.quest.10.93.0.nextVisit" : "Lai gan vējus jau var notvert {pa gaisu}, akmeņu attīrīšana ļaus jums tos sasniegt arī {pa jūru}.\n\nŠie {labvēlīgie vēji} pilnībā {atjauno} jūsu {pārvietošanās punktus}.\n\nTam būs nepieciešami {resursi} sprāgstvielām un {zelts} sapieru apmaksai.",
  "map.[hota] the mysterious island.quest.100.148.0.completed" : "\"Es izvēlējos vardarbību.\"",
  "map.[hota] the mysterious island.quest.100.148.0.firstVisit" : "PEGI {13} – Vardarbība!\n\nUz priekšu, pex",
  "map.[hota] the mysterious island.quest.100.148.0.nextVisit" : "PEGI {13} – Vardarbība!\n\nUz priekšu, pex",
  "map.[hota] the mysterious island.quest.100.91.1.completed" : "Eja atveras!\n\nTagad mums tikai jāizdomā, kā nokļūt Pilsētas portāla svētnīcā.\n\nMums droši vien būs jāiet cauri dažām {slēptām} vietām...",
  "map.[hota] the mysterious island.quest.100.91.1.firstVisit" : "Dēmoni ir aizzīmogojuši eju, bet šķiet, ka {pūķa asinis} varētu to atbloķēt!\n\nAutora piezīme:\nŠī eja ir noderīga tikai tad, ja jūs nākat {no ziemeļiem}, ​​lai \"nozagtu\" Pilsētas portāla burvestību.\nTā ir pilnīgi bezjēdzīga, ja jūs nākat no dienvidiem, caur Sarkano teritoriju.",
  "map.[hota] the mysterious island.quest.100.91.1.nextVisit" : "Dēmoni ir aizzīmogojuši eju, bet šķiet, ka {pūķa asinis} varētu to atbloķēt!\n\nAutora piezīme:\nŠī eja ir noderīga tikai tad, ja jūs nākat {no ziemeļiem}, ​​lai \"nozagtu\" Pilsētas portāla burvestību.\nTā ir pilnīgi bezjēdzīga, ja jūs nākat no dienvidiem, caur Sarkano teritoriju.",
  "map.[hota] the mysterious island.quest.102.103.1.completed" : "Mana karaliene!",
  "map.[hota] the mysterious island.quest.102.103.1.firstVisit" : "Tikai Pūķu Mātei, kas nāk no ziemeļiem, ir atļauts šķērsot šo liesmu ceļu.\n\nPat viņai ir bezjēdzīgi nākt no sarkanajām zemēm.\n",
  "map.[hota] the mysterious island.quest.102.103.1.nextVisit" : "Tikai Pūķu Mātei, kas nāk no ziemeļiem, ir atļauts šķērsot šo liesmu ceļu.\n\nPat viņai ir bezjēdzīgi nākt no sarkanajām zemēm.",
  "map.[hota] the mysterious island.quest.102.4.1.completed" : "Paldies par govīm! Iepazīsties ar elites loka šaušanas speciālistu.",
  "map.[hota] the mysterious island.quest.102.4.1.firstVisit" : "Ja tev nepatīk govis, es varu tās noņemt.\n\nApmaiņā es varu tev piedāvāt varoni, kas specializējas elites lokšāvējos.\n\nKo tu izvēlēsies? Govis vai lokšāvējus?",
  "map.[hota] the mysterious island.quest.102.4.1.nextVisit" : "Ja tev nepatīk govis, es varu tās noņemt.\n\nApmaiņā es varu tev piedāvāt varoni, kas specializējas elites lokšāvējos.\n\nKo tu izvēlēsies? Govis vai lokšāvējus?",
  "map.[hota] the mysterious island.quest.102.56.1.completed" : "Apskatīsimies!",
  "map.[hota] the mysterious island.quest.102.56.1.firstVisit" : "- Slēgts līdz 13. mēneša 2. nedēļas 2. dienai. -",
  "map.[hota] the mysterious island.quest.102.56.1.nextVisit" : "- Slēgts līdz 13. mēneša 2. nedēļas 2. dienai. -",
  "map.[hota] the mysterious island.quest.103.122.1.firstVisit" : "Ir pārāk karsts, mēs tur nevaram tikt!",
  "map.[hota] the mysterious island.quest.103.122.1.nextVisit" : "Ir pārāk karsts, mēs tur nevaram tikt!",
  "map.[hota] the mysterious island.quest.104.10.0.completed" : "Nu tad nu mēs sākam!",
  "map.[hota] the mysterious island.quest.104.10.0.firstVisit" : "Tikai frakcija, kas nes {oranžo} karogu, ir pelnījusi tikt cauri!",
  "map.[hota] the mysterious island.quest.104.10.0.nextVisit" : "Tikai frakcija, kas nes {oranžo} karogu, ir pelnījusi tikt cauri!",
  "map.[hota] the mysterious island.quest.104.42.0.completed" : "Kad kāds krīt, mēs turpinām. ... \"KAD kāds krīt.\" Nevis \"Ja\", bet gan \"KAD\"!",
  "map.[hota] the mysterious island.quest.104.42.0.firstVisit" : "Drīkst iet tikai varoņi ar {25} vai augstāku līmeni.\nŠis ceļš ir paredzēts īstajai ekspedīcijai {25}.",
  "map.[hota] the mysterious island.quest.104.42.0.nextVisit" : "Drīkst iet tikai varoņi ar {25} vai augstāku līmeni.\nŠis ceļš ir paredzēts īstajai ekspedīcijai {25}.",
  "map.[hota] the mysterious island.quest.104.43.0.firstVisit" : "Paša akadēmija 5. līmeņa radījumu speciālistiem.\n\nNepieciešama radījumu specializācija un ļoti augsts līmenis.\n\nTikai {Nymus} var nokārtot uzdevumu. Nākamajam uzdevumam būs nepieciešams {25. līmenis}.\n\n--\nAutora piezīme:\nŠis ir bonuss spēlētājiem, kuri vēlas spēlēt kā 5. līmeņa radījumu speciālista galvenais varonis, lai nedaudz pārvarētu plaisu ar varoņiem, kas specializējas uzbrukumā, aizsardzībā vai pirmās palīdzības sniegšanā.\n\nTas ir pilnīgi neobligāti.",
  "map.[hota] the mysterious island.quest.104.43.0.nextVisit" : "Paša akadēmija 5. līmeņa radījumu speciālistiem.\n\nNepieciešama radījumu specializācija un ļoti augsts līmenis.\n\nTikai {Nymus} var nokārtot uzdevumu. Nākamajam uzdevumam būs nepieciešams {25. līmenis}.\n\n--\nAutora piezīme:\nŠis ir bonuss spēlētājiem, kuri vēlas spēlēt kā 5. līmeņa radījumu speciālista galvenais varonis, lai nedaudz pārvarētu plaisu ar varoņiem, kas specializējas uzbrukumā, aizsardzībā vai pirmās palīdzības sniegšanā.\n\nTas ir pilnīgi neobligāti.",
  "map.[hota] the mysterious island.quest.105.58.1.completed" : "Labs grūdiens, un tagad varam turpināt!",
  "map.[hota] the mysterious island.quest.105.58.1.firstVisit" : "Akmeņi bloķē eju; to varētu attīrīt tikai zemestrīce.\n\nVulkāniskā salā tam kādu dienu jānotiek...\n\nPagaidīsim līdz 14. mēnesim, 1. nedēļai, 3. dienai.\n\n--\nAutora piezīme: šie vārti ir {pēc izvēles}, tas ir tikai saīsne, ko vēlāk var izmantot vai neizmantot.",
  "map.[hota] the mysterious island.quest.105.58.1.nextVisit" : "Akmeņi bloķē eju; to varētu attīrīt tikai zemestrīce.\n\nVulkāniskā salā tam kādu dienu jānotiek...\n\nPagaidīsim līdz 14. mēnesim, 1. nedēļai, 3. dienai.\n\n--\nAutora piezīme: šie vārti ir {pēc izvēles}, tas ir tikai saīsne, ko vēlāk var izmantot vai neizmantot.",
  "map.[hota] the mysterious island.quest.106.214.1.firstVisit" : "Šeit esošie apsargi saka, ka viņi laidīs garām tikai tos, kas parādīs karogu {#FFC0CB}.\n\n(heksagonāls joks)",
  "map.[hota] the mysterious island.quest.106.214.1.nextVisit" : "Šeit esošie apsargi saka, ka viņi laidīs garām tikai tos, kas parādīs karogu {#FFC0CB}.\n\n(heksagonāls joks)",
  "map.[hota] the mysterious island.quest.106.23.0.completed" : "KABOOM!",
  "map.[hota] the mysterious island.quest.106.23.0.firstVisit" : "Lai gan vējus jau var notvert {pa gaisu}, akmeņu attīrīšana ļaus jums tos sasniegt arī {pa jūru}.\n\nŠie {labvēlīgie vēji} pilnībā {atjauno} jūsu {pārvietošanās punktus}.\n\nTam būs nepieciešami {resursi} sprāgstvielām un {zelts} sapieru apmaksai.",
  "map.[hota] the mysterious island.quest.106.23.0.nextVisit" : "Lai gan vējus jau var notvert {pa gaisu}, akmeņu attīrīšana ļaus jums tos sasniegt arī {pa jūru}.\n\nŠie {labvēlīgie vēji} pilnībā {atjauno} jūsu {pārvietošanās punktus}.\n\nTam būs nepieciešami {resursi} sprāgstvielām un {zelts} sapieru apmaksai.",
  "map.[hota] the mysterious island.quest.106.43.0.firstVisit" : "Paša akadēmija 5. līmeņa radījumu speciālistiem.\n\nNepieciešama radījumu specializācija un ļoti augsts līmenis.\n\nTikai {Dace} var nokārtot uzdevumu. Nākamajam uzdevumam būs nepieciešams {25. līmenis}.\n\n--\nAutora piezīme:\nŠis ir bonuss spēlētājiem, kuri vēlas spēlēt kā 5. līmeņa radījumu speciālista galvenais varonis, lai nedaudz pārvarētu plaisu ar varoņiem, kas specializējas uzbrukumā, aizsardzībā vai pirmajā palīdzībā.\n\nTas ir pilnīgi neobligāti.",
  "map.[hota] the mysterious island.quest.106.43.0.nextVisit" : "Paša akadēmija 5. līmeņa radījumu speciālistiem.\n\nNepieciešama radījumu specializācija un ļoti augsts līmenis.\n\nTikai {Dace} var nokārtot uzdevumu. Nākamajam uzdevumam būs nepieciešams {25. līmenis}.\n\n--\nAutora piezīme:\nŠis ir bonuss spēlētājiem, kuri vēlas spēlēt kā 5. līmeņa radījumu speciālista galvenais varonis, lai nedaudz pārvarētu plaisu ar varoņiem, kas specializējas uzbrukumā, aizsardzībā vai pirmajā palīdzībā.\n\nTas ir pilnīgi neobligāti.",
  "map.[hota] the mysterious island.quest.106.82.1.completed" : "\"nauda, ​​nauda, ​​nauda\"",
  "map.[hota] the mysterious island.quest.106.82.1.firstVisit" : "No cietuma atskan sauciens:\n\n\"Palīgā! Esmu {Zilās} frakcijas \"Monētu meistars\"!\"\n\nJa mēs esam {Zilie}, pasteigsimies un glābsim šo varoni!\nCitādi lai viņš satrūd savā kamerā...",
  "map.[hota] the mysterious island.quest.106.82.1.nextVisit" : "No cietuma atskan sauciens:\n\n\"Palīgā! Esmu {Zilās} frakcijas \"Monētu meistars\"!\"\n\nJa mēs esam {Zilie}, pasteigsimies un glābsim šo varoni!\nCitādi lai viņš satrūd savā kamerā...",
  "map.[hota] the mysterious island.quest.107.178.0.completed" : "Ar šo {pieredzi} jūs esat gatavs piedzīvojumam. Veiksmi!",
  "map.[hota] the mysterious island.quest.107.178.0.firstVisit" : "Kas man ir, ir paredzēts {Ranloo}, pašam skautam {Teal}.\n\nEs to nevienam citam nedošu.",
  "map.[hota] the mysterious island.quest.107.178.0.nextVisit" : "Kas man ir, ir paredzēts {Ranloo}, pašam skautam {Teal}.\n\nEs to nevienam citam nedošu.",
  "map.[hota] the mysterious island.quest.107.237.1.completed" : "Tavs grūtības līmenis ir 1. bandinieks, 2. bruņinieks vai 3. tornis.\n\nVai vēlies apgūt {Aklā} burvestību?",
  "map.[hota] the mysterious island.quest.107.237.1.firstVisit" : "Šeit ir piekļuve burvestībai {Akls} 1. grūtības līmenim \"Bandnieks\", 2. \"Bruņinieks\" vai 3. \"Tornis\".\n\nJa jūsu grūtības līmenis ir iestatīts uz 4. \"Dāma\" vai 5. \"Karalis\", jūs esat pārāk pieredzējis spēlētājs, lai jums būtu šī burvestība.\n\n{Akls} + {Augšāmcelšanās} ļaunprātīga izmantošana ir kaitīga ienaidnieka veselībai.\n\nJums būs jāpieliek nedaudz vairāk pūļu, lai iegūtu šo burvestību kaut kur šajā tunelī...",
  "map.[hota] the mysterious island.quest.107.237.1.nextVisit" : "Šeit ir piekļuve burvestībai {Akls} 1. grūtības līmenim \"Bandnieks\", 2. \"Bruņinieks\" vai 3. \"Tornis\".\n\nJa jūsu grūtības līmenis ir iestatīts uz 4. \"Dāma\" vai 5. \"Karalis\", jūs esat pārāk pieredzējis spēlētājs, lai jums būtu šī burvestība.\n\n{Akls} + {Augšāmcelšanās} ļaunprātīga izmantošana ir kaitīga ienaidnieka veselībai.\n\nJums būs jāpieliek nedaudz vairāk pūļu, lai iegūtu šo burvestību kaut kur šajā tunelī...",
  "map.[hota] the mysterious island.quest.107.68.1.firstVisit" : "Vārti padosies tikai reģionālajam Monētu meistaram.\n\nVai varbūt... kādu dienu parādīsies sarkana atslēga.",
  "map.[hota] the mysterious island.quest.107.68.1.nextVisit" : "Vārti padosies tikai reģionālajam Monētu meistaram.\n\nVai varbūt... kādu dienu parādīsies sarkana atslēga.",
  "map.[hota] the mysterious island.quest.108.16.1.completed" : "Laipni lūdzam! Šeit atradīsiet mājienu pēdējai kaujai.",
  "map.[hota] the mysterious island.quest.108.16.1.firstVisit" : "Tikai frakcija, kas nes {oranžo} karogu, ir pelnījusi tikt cauri!",
  "map.[hota] the mysterious island.quest.108.16.1.nextVisit" : "Tikai frakcija, kas nes {oranžo} karogu, ir pelnījusi tikt cauri!",
  "map.[hota] the mysterious island.quest.108.17.1.completed" : "Beidzot daži pienācīgi karavīri, lai stātos pretī pēdējam ienaidniekam.\nVeiksmi...\n\n--\nAutora piezīme:\nŠis uzdevums, tāpat kā iepriekšējais, ir {atkārtojams}.",
  "map.[hota] the mysterious island.quest.108.17.1.firstVisit" : "Atvediet man tās citas vājās radības, un es jums piedāvāšu cita veida maiņu.\n\n--\nAutora piezīme:\nŠis uzdevums, tāpat kā iepriekšējais, ir {atkārtojams}.",
  "map.[hota] the mysterious island.quest.108.17.1.nextVisit" : "Atvediet man tās citas vājās radības, un es jums piedāvāšu cita veida maiņu.\n\n--\nAutora piezīme:\nŠis uzdevums, tāpat kā iepriekšējais, ir {atkārtojams}.",
  "map.[hota] the mysterious island.quest.108.72.1.completed" : "Tavs grūtības līmenis ir 1. bandinieks, 2. bruņinieks vai 3. tornis.\n\nVai vēlies apgūt {Aklā} burvestību?",
  "map.[hota] the mysterious island.quest.108.72.1.firstVisit" : "Šeit ir piekļuve burvestībai {Akls} 1. grūtības līmenim \"Bandnieks\", 2. \"Bruņinieks\" vai 3. \"Tornis\".\n\nJa jūsu grūtības līmenis ir iestatīts uz 4. \"Dāma\" vai 5. \"Karalis\", jūs esat pārāk pieredzējis spēlētājs, lai jums būtu šī burvestība.\n\n{Akls} + {Augšāmcelšanās} ļaunprātīga izmantošana ir kaitīga ienaidnieka veselībai.\n\nJums būs jāpieliek nedaudz vairāk pūļu, lai iegūtu šo burvestību kaut kur šajā tunelī...",
  "map.[hota] the mysterious island.quest.108.72.1.nextVisit" : "Šeit ir piekļuve burvestībai {Akls} 1. grūtības līmenim \"Bandnieks\", 2. \"Bruņinieks\" vai 3. \"Tornis\".\n\nJa jūsu grūtības līmenis ir iestatīts uz 4. \"Dāma\" vai 5. \"Karalis\", jūs esat pārāk pieredzējis spēlētājs, lai jums būtu šī burvestība.\n\n{Akls} + {Augšāmcelšanās} ļaunprātīga izmantošana ir kaitīga ienaidnieka veselībai.\n\nJums būs jāpieliek nedaudz vairāk pūļu, lai iegūtu šo burvestību kaut kur šajā tunelī...",
  "map.[hota] the mysterious island.quest.109.160.0.completed" : "Tavi uzticīgie elites karavīri tevi gaida šajās sienās.",
  "map.[hota] the mysterious island.quest.109.160.0.firstVisit" : "No šīs elites mājvietas var vervēt tikai {Teal} frakcija, kas šeit sāka darboties.",
  "map.[hota] the mysterious island.quest.109.160.0.nextVisit" : "No šīs elites mājvietas var vervēt tikai {Teal} frakcija, kas šeit sāka darboties.",
  "map.[hota] the mysterious island.quest.109.5.0.completed" : "Laipni lūdzam! Šeit atradīsiet mājienu pēdējai kaujai.",

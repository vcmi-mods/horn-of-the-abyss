  "map.[hota] noble nemesis.town.123.192.0.name" : "Bogspire",
  "map.[hota] noble nemesis.town.135.21.0.name" : "Mechforge",
  "map.[hota] noble nemesis.town.135.53.0.name" : "Ātrumkārbas turētājs",
  "map.[hota] noble nemesis.town.141.80.0.name" : "dzelzs darbnīcas",
  "map.[hota] noble nemesis.town.150.214.1.name" : "Skorčpīka",
  "map.[hota] noble nemesis.town.160.124.0.name" : "Karaliskā banka",
  "map.[hota] noble nemesis.town.183.225.1.name" : "Lava komanda",
  "map.[hota] noble nemesis.town.194.167.0.name" : "Dvēseles kalps",

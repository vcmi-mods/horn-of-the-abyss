  "map.[hota] element land.quest.172.107.1.completed" : "Beidzot! Dodiet man 300 koksnes un 50 000 zelta, un es jums pretī došu šo.",
  "map.[hota] element land.quest.172.107.1.firstVisit" : "Sveiki, esmu Rakets Riks, vai jūs varētu interesēt leģendārā vairoga iegāde par nelielo cenu – 300 koka un 50 000 zelta?",
  "map.[hota] element land.quest.172.107.1.nextVisit" : "Vau, ar to vienkārši nepietiek. Man vajag 300 koka un 50 000 zelta vairogam.",
  "map.[hota] element land.quest.193.211.1.completed" : "Beidzot 1 novērotājs un 1 ļaunā acs. Laiks ķerties pie darba!",
  "map.[hota] element land.quest.193.211.1.firstVisit" : "Sveiki, esmu atzīts acs ābolu protēžu meistars. Atnesiet man dažus sīkumus, un es varu ķerties pie darba!",
  "map.[hota] element land.quest.193.211.1.nextVisit" : "Neveicās atrast 1 vērotāju un 1 ļauno aci?",
  "map.[hota] element land.quest.213.144.1.completed" : "Beidzot! Dod man 500 zelta, un es tos tev došu pretī.",
  "map.[hota] element land.quest.213.144.1.firstVisit" : "Izpārdošana, pūķi par 100 zelta gabalā.",
  "map.[hota] element land.quest.213.144.1.nextVisit" : "Vau, ar to vienkārši nepietiek. Man vajag 500 zelta.",
  "map.[hota] element land.quest.223.26.1.completed" : "Lieliski! Tu sagūstīji pūķus, tagad iemet tos ugunīgajā bedrē, un es pievienošos tev.",
  "map.[hota] element land.quest.223.26.1.firstVisit" : "Parādi man, ka esi īsts pūķu mednieks, un es pievienošos tavai lietai.",
  "map.[hota] element land.quest.223.26.1.nextVisit" : "Atvediet pūķus šurp un nogaliniet tos, nekas vairāk nebūs.",
  "map.[hota] element land.quest.226.22.1.firstVisit" : "Šis tornis pieder varenam burvim. Viņš atsakās tevi palaist garām, ja vien tu viņam neatnesīsi Pūķtēva Spēku, lai viņš varētu to iznīcināt.",
  "map.[hota] element land.quest.23.21.1.completed" : "Pirāts jautā, vai esi gatavs iet cauri?",
  "map.[hota] element land.quest.23.21.1.firstVisit" : "Tikai pirāts var atslēgt šīs durvis.",
  "map.[hota] element land.quest.23.21.1.nextVisit" : "Tikai pirāts var atslēgt šīs durvis.",
  "map.[hota] element land.quest.249.236.0.completed" : "Beidzot 5 zelta pūķi! Paskatīsimies tagad.. vai man vajadzētu izmantot zilo krāsu?",
  "map.[hota] element land.quest.249.236.0.firstVisit" : "Sveiki, ceļotāji, esmu atzīts mākslinieks, varbūt jūs varētu man palīdzēt izpaust savu talantu!",
  "map.[hota] element land.quest.249.236.0.nextVisit" : "Vai tev neizdodas atrast 5 zelta pūķus? Lūdzu, pasteidzies.",
  "map.[hota] element land.quest.31.28.0.completed" : "Ā, beidzot 60 sēra. Vai esi gatavs tirgoties?",
  "map.[hota] element land.quest.31.28.0.firstVisit" : "Muahaha! Man ir vienīgais Animate Dead eksemplārs visā mūsu karaļvalstī, es to padalīšos ar tevi par 60 Sulfur. Un nē, tu to nekad neatradīsi savās dārgajās burvju ģildēs, bahahaha!",
  "map.[hota] element land.quest.31.28.0.nextVisit" : "Tā kā tu neatvedi līdzi 60 sēra mārciņas, sargi tev liedza caurlaidi.",
  "map.[hota] element land.quest.41.5.1.completed" : "Tavs pūķis laiza lūpas un pārvietojas, lai paņemtu uzkodu.",
  "map.[hota] element land.quest.41.5.1.firstVisit" : "Ceļojot pa savu midzeni, jūs nolemjat, ka sargs nav jums pietiekami labi kalpojis, un piedāvājat viņu kā uzkodu savam pūķim.",
  "map.[hota] element land.quest.41.5.1.nextVisit" : "Tev joprojām ir Psihiskais elements, vai ne?",
  "map.[hota] element land.quest.42.1.1.completed" : "Merkurs ir savākts, ir pienācis laiks atkal atvērt šo bāzes daļu!",
  "map.[hota] element land.quest.42.1.1.firstVisit" : "Saimniek, šai bāzes daļai nepieciešams remonts, lai to atjaunotu darba kārtībā, būs nepieciešami 100 Merkura vienības.",
  "map.[hota] element land.quest.42.1.1.nextVisit" : "Pietiek ar 100 Merkuriem, nekas vairāk.",
  "map.[hota] element land.quest.42.18.1.completed" : "Lieliski! Jūs atradāt jūras briesmoni! Liels paldies!",
  "map.[hota] element land.quest.42.18.1.firstVisit" : "Mēs patiesībā nolēmām, ka vēlamies, lai briesmonis pievienotos mūsu ciemam un mūs aizsargātu, lūdzu, atvediet viņu atpakaļ, tas nevarēja tālu tikt.",
  "map.[hota] element land.quest.42.18.1.nextVisit" : "Lūdzu, atnesiet to šeit atpakaļ!",
  "map.[hota] element land.quest.42.19.1.completed" : "Paldies Dievam, tu mūs visus izglābi!",
  "map.[hota] element land.quest.42.19.1.firstVisit" : "Jūras briesmonis terorizē mūsu apkārtni, lūdzu, atbrīvojieties no tā mūsu labā.",
  "map.[hota] element land.quest.42.19.1.nextVisit" : "Vai briesmonis jau ir prom?",
  "map.[hota] element land.quest.49.3.1.completed" : "Laiks pabeigt savu piedzīvojumu?",
  "map.[hota] element land.quest.49.3.1.firstVisit" : "Ļaunā burvja pūķi aizsargā viņa tumšā maģija.",
  "map.[hota] element land.quest.49.3.1.nextVisit" : "Ļaunais burvis joprojām ir dzīvs, tāpēc jūs nevarat tikt cauri.",
  "map.[hota] element land.quest.83.2.1.completed" : "Eņģeļi pagriežas, lai aizietu, vai tu esi gatavs doties mājās?",
  "map.[hota] element land.quest.83.2.1.firstVisit" : "Goblins ir gatavs atvērt tev vārtus, bet eņģeļi aizies...",
  "map.[hota] element land.quest.83.2.1.nextVisit" : "Vai esi gatavs doties mājās?",
  "map.[hota] element land.quest.89.8.0.completed" : "Vai esi gatavs izperēt klonu par 15 000 koksnes?",
  "map.[hota] element land.quest.89.8.0.firstVisit" : "Klonam pilnīgai izaugšanai nepieciešami 15 000 koksnes vienību...",
  "map.[hota] element land.quest.89.8.0.nextVisit" : "Jums jāatnes 15 000 koksnes vienību.",
  "map.[hota] element land.quest.9.251.1.completed" : "Psihiskais elementālis noliecas uz priekšu, atslēdz vārtus un tad pazūd dūmu mākonī, līdzi paņemot vairākus savus biedrus.",
  "map.[hota] element land.quest.9.251.1.firstVisit" : "Tikai Psihiskais Elementālis var atslēgt šos vārtus.",
  "map.[hota] element land.quest.9.251.1.nextVisit" : "Tikai Psihiskais Elementālis var atslēgt šos vārtus.",
  "map.[hota] element land.quest.91.153.0.completed" : "Paldies, izskatās garšīgi. Lūk, jūsu maksājums.",
  "map.[hota] element land.quest.91.153.0.firstVisit" : "Manā pieliekamajā vairs nav ēdiena, vai jūs man iedosiet ko ēdamu? Es labi samaksāšu.",
  "map.[hota] element land.quest.91.153.0.nextVisit" : "Lūdzu, pasteidzies, esmu izsalcis.",
  "map.[hota] element land.quest.92.7.0.completed" : "Vai esi gatavs izperēt klonu par 15 000 koksnes?",

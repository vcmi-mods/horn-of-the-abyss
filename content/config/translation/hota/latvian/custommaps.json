  "map.[hota] the mysterious island.header.heroes.79" : "Sarūsējis",
  "map.[hota] the mysterious island.header.heroes.85" : "Vasilikss",
  "map.[hota] the mysterious island.header.name" : "- Noslēpumainā sala -",
  "map.[hota] the mysterious island.header.player.0.mainHeroName" : "Nakts karalis",
  "map.[hota] the mysterious island.header.player.7.mainHeroName" : "Džons Silvers",
  "map.[hota] the mysterious island.header.rumor.0.text" : "...šķiet, ka zem vulkāna dzīvo noslēpumains {kapteinis N.}...",
  "map.[hota] the mysterious island.header.rumor.1.text" : "Es dzirdēju kādu sakām, ka ir iespējams izveidot iespaidīgu ieroci, {Eņģeļu aliansi}, nogādājot radības {sešos} dažādos orākulu objektos...",
  "map.[hota] the mysterious island.header.rumor.10.text" : "Pirms ieiešanas viņa teritorijā, sarkanā spēlētāja spēks zagļu ģildē var būt {pārvērtēts}... Neuzticieties viņam šai informācijai.",
  "map.[hota] the mysterious island.header.rumor.11.text" : "{Pirāti} (Rozā) varētu būt spējīgi plānot koordinētu uzbrukumu {vairākās vietās} vienlaicīgi {vienlaikus}.",
  "map.[hota] the mysterious island.header.rumor.12.text" : "Lai apturētu izvirdumus, tos ir vieglāk novērst ar {Orb of Vulnerability}. Taču tas ir tikai {Red Territory Guardian}.",
  "map.[hota] the mysterious island.header.rumor.13.text" : "Leģendārais {Pilsētas portāla} burvestība ir pieejama tikai {pēc} {Sarkanā atslēgu meistara} apmeklēšanas. Izņemot vienu īpašu varoni...",
  "map.[hota] the mysterious island.header.rumor.14.text" : "Vulkāna (sarkano varoņu) spēks palielināsies {katra mēneša} sākumā, sākot ar {septīto} mēnesi.",
  "map.[hota] the mysterious island.header.rumor.15.text" : "Tiek uzskatīts, ka pastāv {aizmugurējās durvis}, kuras var atbloķēt tikai {Pūķu Māte} vai kāds cits {Bens}, ļaujot apiet noteiktus ceļus. Autora piezīme: Aizmugurējās durvis nav obligātas.",
  "map.[hota] the mysterious island.header.rumor.16.text" : "Tikai {radības} uz {mazām saliņām} ap salu var saturēt {resursus}...",
  "map.[hota] the mysterious island.header.rumor.17.text" : "Steiga rada atkritumus! {Atslēgu} un {pamatprasmju} atstāšana novārtā jums izmaksās dārgi. Ļoti, ļoti dārgi...",
  "map.[hota] the mysterious island.header.rumor.18.text" : "Ja {viens} galvenais varonis, kurš apmeklē maksimālo lappušu skaitu ar {primārām prasmēm}, ilgtermiņā būtu {pašnāvniecisks}...",
  "map.[hota] the mysterious island.header.rumor.19.text" : "Hodors! Hodors, Hodors. Hodors, Hodors, Hodors. Hodors! HODOR! TURIET! {TURIET DURVIS}!",
  "map.[hota] the mysterious island.header.rumor.2.text" : "Noslēpumainajai figūrai zem vulkāna, kapteinim N., būs veids, kā {pārvietoties zem ūdens} un nokļūt jebkurā vietā uz salas!",
  "map.[hota] the mysterious island.header.rumor.20.text" : "Augstākajos grūtības līmeņos (Dāma un Karalis), kad ienaidnieks apmeklē treneri {primārās prasmes}, tā prasmes palielināsies {trīs reizes} vairāk nekā mūsu!",
  "map.[hota] the mysterious island.header.rumor.21.text" : "Pastāv runas par vecu gudro cilvēku vārdā {Miraxi}, kurš dzīvo uz šīs salas. Viņi saka, ka viņam pieder {dzirnavas} un {lauks} netālu no {ezera}.",
  "map.[hota] the mysterious island.header.rumor.22.text" : "Pirāti paslēpa savus {dārgumus} četrās dažādās vietās... Pirmā atrastos tieši ārpus savas pilsētas, {Pirātu līcī}.",
  "map.[hota] the mysterious island.header.rumor.23.text" : "{Leģiona statujas} fragmenti ir izkaisīti pa visu salu. Dzelzs banka austrumos ir paņēmusi vienīgo {Leģiona vadītāju}.",
  "map.[hota] the mysterious island.header.rumor.24.text" : "Nokļūšana Dzelzs bankā ir tiešām {lēna}...",
  "map.[hota] the mysterious island.header.rumor.25.text" : "Tiek teikts, ka {Pūķu Māte} var sasniegt {Pilsētas Portāla} burvestību, pat necīnoties ar sarkano frakciju!",
  "map.[hota] the mysterious island.header.rumor.3.text" : "Grālu būtu iespējams atrast, NEAPMEKLĒJOT visus galvenos meistarus... Puisis vārdā {Ayrton} man tā teica, bet es viņu neesmu redzējis gadu desmitiem.",
  "map.[hota] the mysterious island.header.rumor.4.text" : "Uz salas ir dažas {Pūķa utopijas}. Un tajās ir gandrīz visi spēcīgie kombinētie artefakti, ko sauc par {Pūķa Tēva Spēku}.",
  "map.[hota] the mysterious island.header.rumor.5.text" : "Runā, ka šīs salas {rezidences} organizē slepenu vampīru kultu. Turiet acis vaļā — ieeja varētu būt paslēpta {aiz kaut kā}.",
  "map.[hota] the mysterious island.header.rumor.6.text" : "2 ceļi uz {Grālu}: {Iekarošanas ceļš} savāc {6} krāsainas {atslēgas}, iegūsti piekļuvi {Nautilus} un pāreju uz {Grālu}. VAI {Izpētes ceļš}, ātrāk atrodi {Ayrton} izolētajā Ziemeļrietumu salā...",
  "map.[hota] the mysterious island.header.rumor.7.text" : "Ap salu esošajā jūrā ir trīs {Jūras akadēmijas}. Katrā no tām var apgūt {Ūdens maģiju} un {Navigāciju}.",
  "map.[hota] the mysterious island.header.rumor.8.text" : "{Eagle Eye} būtu VIENĪGAIS veids, kā iegūt {Berserk} un {Armageddon} burvestības... Ja vēlaties tās kopīgot, tikai VIENAM varonim ir {Scholar} prasme!",
  "map.[hota] the mysterious island.header.rumor.9.text" : "{Ērgļa acs} prasme vairs nav joks.\n\n",
  "map.[hota] the mysterious island.heroes.10.biography" : "Neitrāls labais... vai drīzāk haotisks labais tumšais garīdznieks! Nedaudz apsēsts ar Travijas, citādi ļoti nopietnās Pavarda dievietes, kultu, vēlāk mēs uzzinām, ka viņš galvenokārt bija Raijas, baudas dievietes, priesteris...! Tiek teikts, ka viņš spēj svētīt savus ienaidniekus ar spēcīgu nūju un varētu iegūt dažas noderīgas svētības... bet tas vēl jāredz.",
  "map.[hota] the mysterious island.heroes.109.biography" : "Sīmēras barbars, kura intelekts bīstami svārstījās starp vērša un vardes intelektu... kā fabulā, un, sastopoties ar lāci, viņš muļķīgi pārdod savu ādu un viņu saplosa tas, kuru viņš vēlējās uzdurt! (Mulsinoši, vai ne?... skaidrs... garīgs...)",
  "map.[hota] the mysterious island.heroes.111.biography" : "Nebs (Nebukadnēcars): bijušais vergs, kuru atbrīvoja viņa saimnieks Kīruss Smits, viņš paliek viņam uzticīgs pateicības un apbrīnas dēļ.",
  "map.[hota] the mysterious island.heroes.111.name" : "Nabs",
  "map.[hota] the mysterious island.heroes.116.biography" : "Gorgonzola!",
  "map.[hota] the mysterious island.heroes.129.biography" : "Beigas ir tuvu...",
  "map.[hota] the mysterious island.heroes.129.name" : "Zemestrīce",
  "map.[hota] the mysterious island.heroes.130.biography" : "Sarkanā jātniece - Apokalipses jātniece",
  "map.[hota] the mysterious island.heroes.130.name" : "Karš",
  "map.[hota] the mysterious island.heroes.132.biography" : "Mēris",
  "map.[hota] the mysterious island.heroes.133.biography" : "Beigas ir tuvu...",
  "map.[hota] the mysterious island.heroes.133.name" : "Lavas plūsma",
  "map.[hota] the mysterious island.heroes.134.biography" : "Iekarošana!",
  "map.[hota] the mysterious island.heroes.134.name" : "Iekarošana",
  "map.[hota] the mysterious island.heroes.142.biography" : "Anna Bonija",
  "map.[hota] the mysterious island.heroes.142.name" : "Anna Bonija",
  "map.[hota] the mysterious island.heroes.143.biography" : "Jūrnieks, vīrs, kas bija tikpat prasmīgs šūšanā kā galdniecībā, kurš vēlāk kļuva par zemnieku.",
  "map.[hota] the mysterious island.heroes.143.name" : "Penkrofts",
  "map.[hota] the mysterious island.heroes.145.biography" : "{LordCameron} – Pirmais angliski runājošais YouTube lietotājs, kurš spēlē {Fortress} (Zaļajā) frakcijā 1.4.e kartē. Pilna biogrāfija būs pieejama nākamajā atjauninājumā...\n\nSekojiet viņa piedzīvojumiem pakalpojumā YouTube!",
  "map.[hota] the mysterious island.heroes.149.biography" : "{\"Le J\"} — pirmais franču straumētājs, kurš spēlē {Stronghold} (Tan) frakcijā 1.4.j kartē, pilna biogrāfija būs pieejama nākamajā atjauninājumā...\n\nSekojiet viņa piedzīvojumiem vietnē YouTube un skatieties viņa turpmākos varoņdarbus vietnē Twitch!",
  "map.[hota] the mysterious island.heroes.150.biography" : "Ziema ir klāt.",
  "map.[hota] the mysterious island.heroes.150.name" : "Nakts karalis",
  "map.[hota] the mysterious island.heroes.153.biography" : "Pūķakmens princese. Septiņu karaļvalstu karaliene. Deinerisa Vētrā Dzimusī, Nesadedzinātā, Mīrīnas karaliene, Andalu, Rojnāru un Pirmo Vīru karaliene, Lielās Zāles Jūras Halīzi, Važu Lauzēja un Pūķu Māte. Septiņu karaļvalstu pavēlniece. Valstības Aizstāve.",
  "map.[hota] the mysterious island.heroes.153.name" : "Daenerys",
  "map.[hota] the mysterious island.heroes.157.biography" : "Viļņu un lielgabalu uguns vidū atskan viens vārds: {Picso}.\nPirmais (franču) straumētājs, kurš šeit iezīmē {Green Cove} frakcijas maršrutu.\nViņa ceļojumi turpinās {YouTube} (Picso) un {Twitch} (zepicso)...\n\nUn komanda zvēr: \"Labradori to dara lētāk.\"",
  "map.[hota] the mysterious island.heroes.166.biography" : "{Mundus}, leģendārs ātrskrējējs, kurš šajā salā ir pārspējis rekordus atkal un atkal.\nVispirms viņš to iekaroja {110 dienās}, pēc tam {81 dienā}, pirms sasniedza neiedomājamo: elpu aizraujošu {64 dienu skrējienu}, kas atstāja bijību visā kopienā!\nPapildus neticamajiem skrējieniem viņš arī darbojās kā uzticīgs testētājs starp {1.3} un {1.4} versijām, palīdzot veidot karti par tādu, kāda tā ir šodien.\nĪsts optimizācijas meistars!",
  "map.[hota] the mysterious island.heroes.17.biography" : "Rūķu karotājs, neitrāli labs (sabiedrības acīs, bet likumīgi labs pret grupu), aptuveni 160 cm garš, gandrīz neiznīcināms (!) ar nedaudz trokšņainu metāla kāju! Rūcīgs, drosmīgs, raupjš, bet diezgan simpātisks, viņš rokā smagu burvju āmuru, kas ir īpaši efektīvs, ko viņš var mest pret saviem ienaidniekiem... un atgūt, izmantojot bumeranga efektu! Viņa bārda ir viņa dārgakmens (papildus simtiem zelta monētu, kas viņam pieder...).",
  "map.[hota] the mysterious island.heroes.173.biography" : "Viņš ir daļēji leģendāras jūras rases karalis, kura tika uzskatīta par izmirušu. Tarkuss saprata, ka, lai viņa tauta atgrieztos, viņam ir jālūdz spēcīgu sabiedroto palīdzība. Pirāti kļuva par viņa jaunajiem ieroču brāļiem. Tāpat kā visi Niksi, viņš ir spēcīgs karotājs, spējīgs cīnīties gan uz sauszemes, gan jūrā. Pārējie Niksi viņu slavē un uzskata par lielisku piemēru.",
  "map.[hota] the mysterious island.heroes.174.biography" : "{Hieu Tran}, bezbailīgais jūras iekarotājs, kurš pierādīja, ka viļņu pārvarēšana ved uz uzvaru.\nŠajā pirātu tematikas salā viņš pilnībā pieņēma jūras garu: no 2. nedēļas 1. dienas viņš tika sūtīts jūrā, katru dienu savācot 5000 zelta un risinot visas resursu problēmas, kamēr pārējie cīnījās uz sauszemes.\nAr admirāļa cepuri un gandrīz 10 000 jūras kustībām viņš dominēja okeānos un atbalstīja lielisko {Xeron} stratēģiju, kas pārspēja visus rekordus: pārsteidzošs {62 dienu ātrskrējiens}, kas atstāja kopienu bez vārdiem!\nĪsts jūru un taktisko inovāciju meistars.\nJa uzmanīgi klausīsieties, varēsiet dzirdēt viņu sakām: \"Tas joprojām nav pietiekami ātri!\"",
  "map.[hota] the mysterious island.heroes.18.biography" : "Elizabete Svana",
  "map.[hota] the mysterious island.heroes.183.biography" : "{Winnymaru} ir pirmais (franču) straumētājs, kas spēlē Factory frakcijā.\n\nLimonādes un optimizācijas cienītājs, viņa episko ceļojumu var atrast viņa YouTube kanālā: {MrWinnymaru} un viņa jaunos piedzīvojumus — Twitch kanālā: {winnymarubaba}.\nViņš ir pazīstams arī ar savu izskatīgumu un brīnišķīgo smaržu... un vairākām Twitch sesijām šajā kartē, no kurām garākā bija vairāk nekā {7 stundas un 40 minūtes}!",
  "map.[hota] the mysterious island.heroes.184.name" : "Cēzars",
  "map.[hota] the mysterious island.heroes.185.biography" : "{Violeta} (pazīstama kā Vi) piedzima Zaunā Felīcijai un Konolam, un vēlāk viņai piedzima jaunāka māsa Pauere, ar kuru viņa bija ļoti tuva.\nKad Vanders, Felīcija, Silko un Konols vadīja sacelšanos pret Piltoveru, viņas vecāki krita kaujā, un Vanders uzņēma māsas pie sevis.\nVēlāk Vanders adoptēja arī divus bāreņus, un Vi kļuva par viņu grupas vadītāju.",
  "map.[hota] the mysterious island.heroes.189.biography" : "Airtons ir četrdesmit piecus gadus vecs vīrietis.\nAr skarbu seju, neskatoties uz ķermeņa tievumu, viņš šķiet apveltīts ar lielu dzīvesprieku, jo viņam ir tikai kauli un nervi.\nVidēja auguma, ar attīstītu plecu skeletu, viņam ir inteliģenta un enerģiska figūra, kur spožs skatiens iekļūst zem ļoti iegrimušajām uzacu velvēm.\nNeskatoties uz viņa sejas vaibstu stingrību un apņēmīgo izskatu, viņa seja izraisa līdzjūtību, kurā var nojaust ciešanu stigmu, kas vīrietim jāpārcieš.\nViņa personība ir acīmredzama jau no paša sākuma un liecina par labu viņam.",
  "map.[hota] the mysterious island.heroes.189.name" : "Airtons",
  "map.[hota] the mysterious island.heroes.192.name" : "Džons Silvers",
  "map.[hota] the mysterious island.heroes.193.biography" : "Mazā meitene Pauere bija kautrīga un mīļa, taču neveikla un kļūdījās. Tas, apvienojumā ar vidējā bērna sindromu, kaitināja viņas vecāko \"brāli\" Mailu, kurš viņu sauca par neliešu. Viņa ļoti apbrīnoja savu vecāko māsu Vi (savu vienīgo bioloģisko ģimeni) un uzskatīja viņu par paraugu un gandrīz vai vecāku figūru. Lai gan viņa nebija tik fiziski spējīga kā Vi, viņa bija ļoti radoša un daudz brīvā laika pavadīja, radot dažādus izgudrojumus, galvenokārt {bumbas} un citus mazus {sprāgstvielas}. Tomēr tie bija paredzami neuzticami un kļuva efektīvi tikai vēlāk pusaudža gados. Viņa parādīja, cik prasmīga ir ar ieroci.",
  "map.[hota] the mysterious island.heroes.194.biography" : "Inženieris, zinātnieks, kāds, kurš spēj radīt uguni, keramiku vai sprāgstvielas. Persona, uz kuru atsaucas visa vienība, kad jāpieņem lēmumi.",
  "map.[hota] the mysterious island.heroes.194.name" : "Sairuss Smits",
  "map.[hota] the mysterious island.heroes.195.biography" : "Heireddins Barbarossa",
  "map.[hota] the mysterious island.heroes.195.name" : "H. Barbarossa",
  "map.[hota] the mysterious island.heroes.197.biography" : "Mērija Džeina Rīda.",
  "map.[hota] the mysterious island.heroes.197.name" : "Marija Rīda",
  "map.[hota] the mysterious island.heroes.21.biography" : "Neitrāli neitrāls elfu bards, lepns, augstprātīgs un izskatīgs, kurš ir piedzīvojis neticami daudz piedzīvojumu; viņš ir redzējis vairāk nekā 50 tēlu nāvi viņa acu priekšā (jā, tiešām!); viņu sen nogalināja sarkans pūķis, bet pēc tam viņš augšāmcēlās, pateicoties Zehirmanna \"vēlēšanās\". Piesardzīgs, viņš zina, kā nepieciešamības gadījumā aizbēgt... Viņam ir iespaidīgas burvestības, ko viņš var izrunāt ar savas arfas skaņu (burvestības veids... \"mans skaistais paladīns, apgaismo manu ceļu\"...).",
  "map.[hota] the mysterious island.heroes.212.biography" : "Jups (saīsinājums no Jupitera) ir noslēpumaina radība, ko salā atklājuši avārijas upuriem piederīgie.\nSākotnēji mežonīgs un nepieradināts, viņš ātri vien demonstrē savu ievērojamo intelektu un pielāgošanās spējas.\n\nSpēcīgs, uzticīgs un pārsteidzoši gudrs, Jups iemācās palīdzēt mājasdarbos un kļūst par nenovērtējamu mazās kopienas locekli.\nViņa spēja mācīties un uzticīgā daba viņu no parasta dzīvnieka pārvērš par īstu kompanjonu.\nKolonistu neparastā piedzīvojuma laikā uz noslēpumainās salas Jups viņiem uzticīgi kalpo, pierādot, ka intelekts un sadarbība var pārvarēt sugu robežas.",
  "map.[hota] the mysterious island.heroes.22.biography" : "Burihs ir labi veidots, mierīgs vīrieša kalns.\nViņa seja ir šaura, stūraina un iedegusi.\nViņam ir gari pirksti, gudras rokas.\nBurihs viņa nedaudzo draugu vidū parasti tiek raksturots kā spītīgs, godīgs, tiešs un nedaudz melanholisks. Viņš savas darīšanas patur pie sevis.\nViņš ir iespaidīga figūra: ar vienu skatienu un klusu vārdu vien viņš ir noturējis kārtībā istabu pilnu ar rupjiem vīriešiem. Jaunībā Burihs smagi savainoja kāju medību negadījumā, aizsargājot bruņiniekus no mežacūkas. Tā nav labi sadzijusi, un viņš joprojām klibo - viņa rupjā un naidīgā daba pastiprinās, kad tā viņu ļoti uztrauc; parasti, kad pie apvāršņa līst lietus. Tomēr viņš ir īpaši jutīgs pret diskusijām un rej uz ikvienu, kas par to komentē.",
  "map.[hota] the mysterious island.heroes.23.biography" : "{JohnCutt}, pirmais (franču) straumētājs, kurš episkā kampaņā iesaistījās cīņā pret Rampart frakciju, kas bija pilna ar pārdrošām cīņām un dīvainiem pētījumiem par dīvainām receptēm, piemēram, ceptiem Mars batoniņiem un citām kulinārijas īpatnībām.\n\nViņš ir arī leģendārā Maroilles \"tarte en frites\" izgudrotājs, kas ir gan baidīts, gan cienīts ēdiens.\n\nSekojiet viņa piedzīvojumiem Twitch ar tādu pašu vārdu: {JohnCutt}.",
  "map.[hota] the mysterious island.heroes.231.biography" : "Kapteinis Nemo, pazīstams kā princis Dakars.\nNemo ieguva Rietumu izglītību, kuras laikā, kā viņš pats apgalvo, pavadīja savu jaunību, ceļojot un studējot pa visu Eiropu. Kad viņš pirmo reizi satiek profesoru Aronaksu un viņa biedrus, trīs avarējušie runā ar viņu franču, angļu, latīņu un vācu valodā.\nBūdams novatorisks inženieris, Nemo projektēja un uzbūvēja kuģi \"Nautilus\", tostarp tā elektrisko dzinēju un navigācijas sistēmas. Izmantojot tās, viņš ar neparastu prasmi kuģoja pa dažām no vissarežģītākajām zemūdens ejām okeānā...",
  "map.[hota] the mysterious island.heroes.231.name" : "Kapteinis Nemo",
  "map.[hota] the mysterious island.heroes.28.biography" : "Noslēpumains vientuļnieks vārdā Bens Kenobijs.",
  "map.[hota] the mysterious island.heroes.28.name" : "Bens Kenobi",
  "map.[hota] the mysterious island.heroes.37.biography" : "{Lexiav} bija pirmais angliski runājošais straumētājs, kas komandēja {Zilo torni} pār šo salu.\n\nJau no paša sākuma viņš iedvesa bailes savos ienaidniekos, iekarojot ienaidnieka pilsētas pirmā mēneša laikā tikai ar nelielu armiju un Burvju bultas burvestību!\n\nViņš iekaroja salas virsmu tikai četros mēnešos, pabeidzot piedzīvojumu mazāk nekā 300 dienās.\n\nNeskatoties uz viņa ātrumu, leģenda vēsta, ka viņš veltīja laiku, lai iedzertu pēdējo dzērienu ar pirātu \"Cēzaru\", kuru viņš bija sagūstījis krastā...",
  "map.[hota] the mysterious island.heroes.38.biography" : "Kara reportieris.",
  "map.[hota] the mysterious island.heroes.38.name" : "Gideona spēle",
  "map.[hota] the mysterious island.heroes.4.biography" : "Sers Džeims Lanisters, Karaļa gvardes bruņinieks, Lordkomandors.\n\nPazīstams kā \"Karaļa slepkava\" par karaļa Eirisa II nogalināšanu Roberta sacelšanās laikā, kas ilgi tika nicināta, bet tika veikta, lai glābtu neskaitāmus nevainīgus cilvēkus.\n\nViņš godam kalpoja vairāku karaļu pakļautībā, galu galā izvēloties cīnīties par dzīvajiem Lielajā karā pret mirušajiem.\n\nPazīstams ar savām kaujas prasmēm un nepārspējamo zobenu mākslu, viņš tika sagūstīts un sakropļots Piecu Kara laikā, tomēr, neskatoties uz ievainojumiem, atgriezās kaujā ar drosmi.",
  "map.[hota] the mysterious island.heroes.48.biography" : "Mičavs — pirmais franču straumētājs, kurš spēlējis Inferno (Orange) frakcijā 1.4.n kartē.\nPvP veterāns, kurš savu piedzīvojumu sāka ar iespaidīgu ātrumu un efektivitāti.\n\nViņa ceļojums turpinās, un šī biogrāfija tiks atjaunināta, tiklīdz viņš pabeigs savu episko uzdevumu...\n\nSekojiet viņa piedzīvojumiem Twitch un YouTube!",
  "map.[hota] the mysterious island.heroes.57.biography" : "Zorlims, ekstraplanāra būtne no Uguns līdzenumiem... milzīgs, ar sarkanām acīm, sarkanu ādu, rudiem matiem un augstu ķermeņa temperatūru (60 °C)... izmanto uzbrukuma burvestības, kas saistītas tikai ar tās elementu... Ja šai būtnei būtu balta vai melna āda, tā galu galā atgādinātu garu cilvēku \"austrumu un vienas nakts\" tipa (līdzīgi kā \"austrumu un vienas nakts\" tipa! Viņš ir nepārprotami neitrāli labs; bieži vien starpnieks, zinātkārs un drosmīgs, viegli neuzbāzīgs...",
  "map.[hota] the mysterious island.heroes.60.biography" : "Sairusa suns.",
  "map.[hota] the mysterious island.heroes.60.name" : "Augšup",
  "map.[hota] the mysterious island.heroes.66.biography" : "{Moucheron Quipet} bija pirmais (franču) straumētājs, kas vadīja {Teal Necropolis} pāri šai valstij.\nJūs varat vēlreiz izdzīvot viņa ceļojumu vietnē {YouTube} un skatīties viņa jaunos piedzīvojumus tiešraidē vietnē {Twitch} ar tādu pašu vārdu: {MoucheronQuipet}.\n\nViņš ir arī lielisks karšu veidotājs fheroes2 (viena no viņa kartēm pat tika iekļauta oficiālajās fheroes2 kartēs: \"Eruption\").",
  "map.[hota] the mysterious island.heroes.71.biography" : "Nāve",
  "map.[hota] the mysterious island.heroes.79.biography" : "Kādreizējais {Naheulbeuk cietuma} tumšais valdnieks {Zangdars} valdīja ar bailēm kopā ar savu viltīgo padomnieku Reivaksu.\n\nBaidoties no savas maģiskās varas un nestabilās dabas, viņam piemīt īpaša vājība: ārkārtēja alerģija pret sliktu mūziku – savdabīga īpašība, ko viņa ienaidnieki ir izmantojuši savā labā.",
  "map.[hota] the mysterious island.heroes.85.biography" : "{Wasilix} bija pirmais satura veidotājs, kurš devās šīs salas {Oranžās cietuma} dzīlēs.\n\nKamēr citi piesardzīgi dalījās ar saviem pirmajiem aklajiem mēģinājumiem, viņš izvēlējās citu pieeju: būdams pirmais, kas skatītājiem piedāvāja pilna ātruma video pēc pieprasījuma, metodiski iekarojot piedzīvojumu tikai {75 dienās}!\n\nPazīstams ar savu analītisko prātu un rūpīgo pieeju, šis pazemes meistars ir ienesis jaunu dimensiju šīs kartes saturam.\n\nVērojiet Vasilix varoņdarbus vietnē YouTube: {wasilix heroes 3}",
  "map.[hota] the mysterious island.heroes.94.biography" : "Piecpadsmit gadus vecs bārenis, par kuru rūpējas Penkrofs. Dedzīgi mācoties, viņš savas botāniskās zināšanas nodod sabiedrībai.",
  "map.[hota] the mysterious island.heroes.94.name" : "Herberts",
  "map.[hota] the mysterious island.monster.10.199.0.message" : "Kungs, lūk, uz manu pilsētu!",
  "map.[hota] the mysterious island.monster.100.178.0.message" : "Neizskaties tā! Tur notiek nejaukas lietas!",
  "map.[hota] the mysterious island.monster.100.82.1.message" : "\"Caur liesmām...",
  "map.[hota] the mysterious island.monster.100.87.1.message" : "...Pilsētas portāla svētnīca\"",
  "map.[hota] the mysterious island.monster.101.174.0.message" : "Hei! Mana pilsēta ir šeit!",
  "map.[hota] the mysterious island.monster.101.178.0.message" : "Paskaties uz šo, mans kungs!\n\nMūsu \"Slepenais vampīru kults\" strādā, lai izsauktu ļaunuma spēkus!\n\nLai pievienotos mums, izej caur slepenajām durvīm AIZ savrupmājas ziemeļrietumos.\n",
  "map.[hota] the mysterious island.monster.101.84.0.message" : "\"Tagad jūs redzēsiet Liču Karaļa patieso spēku.\"",
  "map.[hota] the mysterious island.monster.102.116.1.message" : "Nogaršojiet manus dūmus!",
  "map.[hota] the mysterious island.monster.102.118.0.message" : "SATIEK MANU ROKU!",
  "map.[hota] the mysterious island.monster.102.136.0.message" : "Sadedzini ķecerus!",
  "map.[hota] the mysterious island.monster.102.14.0.message" : "Bākas sargi jūk prātā, sakot dīvainas lietas:\n\n\"Nēēē... Mēs negribam kļūt par fangarmiem... vai lichiem! Miraks, kādu savdabīgu spēli tu spēlē?!\"",
  "map.[hota] the mysterious island.monster.102.172.1.message" : "NEPIEKRIET. NEAIZSKĀRIET. MŪMIJĀS.",
  "map.[hota] the mysterious island.monster.102.90.1.message" : "Haha, tu tāpat nekad netiksi cauri: mēs esam aizzīmogojuši eju!",
  "map.[hota] the mysterious island.monster.104.161.0.message" : "Tu dzirdi savu izlūku saucienu no savas telts:\n\"Lūk! Es atradu atslēgu, lai {atslēgtu ceļu} pie {gaiši zilā} atslēgu meistara!\"",
  "map.[hota] the mysterious island.monster.105.244.0.message" : "Bākas sargi jūk prātā, sakot dīvainas lietas:\n\n\"Nē... Mēs nevēlamies kļūt par fangarmiem vai citiem ličiem. Miraks, ko tieši tu izdarīji?\"",
  "map.[hota] the mysterious island.monster.106.137.0.message" : "Lai viņi dus mierā!",
  "map.[hota] the mysterious island.monster.107.172.1.message" : "\"Mēs aizstāvēsim šo valsti visu dienu!\"",
  "map.[hota] the mysterious island.monster.107.98.0.message" : "Neskaties!\nTu tāpat nekad ieeju neatradīsi!",
  "map.[hota] the mysterious island.monster.108.62.0.message" : "Lai pūķi guļ!",
  "map.[hota] the mysterious island.monster.109.126.0.message" : "Neaiztieciet!",
  "map.[hota] the mysterious island.monster.109.129.0.message" : "Dēmoniski dēmoni ir sasējuši mūsu māti {alā} starp Konfluksa pilsētu un Bāku!\nTu par to sadegs...",
  "map.[hota] the mysterious island.monster.109.87.0.message" : "IEKŠĀ!",
  "map.[hota] the mysterious island.monster.11.162.0.message" : "Šššš!",
  "map.[hota] the mysterious island.monster.110.161.0.message" : "Hei! Mana pilsēta ir šeit!",
  "map.[hota] the mysterious island.monster.111.74.1.message" : "\"Mēs esam Šmargonrogas pūķi — nometieties ceļos vai pārvērtieties pelnos!\"",
  "map.[hota] the mysterious island.monster.112.145.0.message" : "\"Vololo... ups, slikta spēle!\"",
  "map.[hota] the mysterious island.monster.112.227.1.message" : "\"Mēs esam Šmargonrogas pūķi — nometieties ceļos vai pārvērtieties pelnos!\"",
  "map.[hota] the mysterious island.monster.112.6.1.message" : "Mūūū!",
  "map.[hota] the mysterious island.monster.113.76.1.message" : "Sveiki! Mūsu varonis Monētu meistars mani atstāja šeit ar ziņu:\nviņi dodas izpētīt {pazemes upi}!",
  "map.[hota] the mysterious island.monster.114.106.0.message" : "GRRRRUEK!",
  "map.[hota] the mysterious island.monster.114.78.0.message" : "Atnesiet man krūmus!",
  "map.[hota] the mysterious island.monster.115.180.1.message" : "Viņa ir mūsu gūstekne! Ejiet prom!\n\nViņa nekad nebūtu tikusi cauri {slēptajām degošajām ejām}, kas ved uz {Pilsētas portāla} svētnīcu - mēs noslēdzām ceļu, hahaha!",
  "map.[hota] the mysterious island.monster.115.194.0.message" : "Ko, pie velna, tu te dari?!",
  "map.[hota] the mysterious island.monster.115.70.0.message" : "Ņau?",
  "map.[hota] the mysterious island.monster.116.109.1.message" : "\"...būvējiet vēl zikkurātus!\"",
  "map.[hota] the mysterious island.monster.116.198.0.message" : "\"Hmm, nepieteikti apmeklētāji. Jāveic sagatavošanās darbi...\"",
  "map.[hota] the mysterious island.monster.116.67.1.message" : "Paldies!\nMēs domājām, ka šeit gatavosim mūžīgi!",
  "map.[hota] the mysterious island.monster.118.92.0.message" : "Tu dzirdi savu izlūku saucienu no savas telts:\n\"Lūk! Es atradu atslēgu, lai {atslēgtu ceļu} pie {zilā} atslēgu meistara!\"",
  "map.[hota] the mysterious island.monster.118.99.0.message" : "Hei! Mana pilsēta ir šeit!",
  "map.[hota] the mysterious island.monster.119.62.1.message" : "Dēmoniskas šausmas ir iedzina mūsu māti {alā} \"starp Saplūšanu un Bāku!\nJūs sadedzināsiet par viņu noziegumiem...",
  "map.[hota] the mysterious island.monster.120.105.0.message" : "\"Zeķe!\"",
  "map.[hota] the mysterious island.monster.121.93.0.message" : "Hei! Mana pilsēta ir šeit!",
  "map.[hota] the mysterious island.monster.122.146.1.message" : "Dēmoniski dēmoni ir ieslodzījuši mūsu māti {alā} \"starp Saplūšanu un Bāku!\nTu degsi viņu dēļ...",
  "map.[hota] the mysterious island.monster.122.96.0.message" : "b b bb b b braraaiiiin",
  "map.[hota] the mysterious island.monster.123.32.0.message" : "Šššš!",
  "map.[hota] the mysterious island.monster.125.196.0.message" : "Šššš!",
  "map.[hota] the mysterious island.monster.126.121.0.message" : "Tu neizturēsi!",
  "map.[hota] the mysterious island.monster.129.102.0.message" : "Tas ir MŪSU zelts!",
  "map.[hota] the mysterious island.monster.13.202.1.message" : "IEKŠĀ!",
  "map.[hota] the mysterious island.monster.130.108.0.message" : "Kungs, varbūt mums vajadzētu {izrakt} šo pludmali, lai novērstu kuģu piestāšanu šeit?",
  "map.[hota] the mysterious island.monster.131.184.1.message" : "Kundze!",
  "map.[hota] the mysterious island.monster.133.190.1.message" : "Man vienalga, kas tu esi, tu netiksi cauri šīm durvīm.\n\nNe ar tām kurpēm, draugs.",
  "map.[hota] the mysterious island.monster.136.152.0.message" : "Kungs, varbūt mums vajadzētu {izrakt} šo pludmali, lai novērstu pirātu kuģu piestāšanu šeit?",
  "map.[hota] the mysterious island.monster.136.51.1.message" : "\"Tagad jūs redzēsiet Liču Karaļa patieso spēku.\"",
  "map.[hota] the mysterious island.monster.137.120.0.message" : "brāli...",
  "map.[hota] the mysterious island.monster.138.155.1.message" : "Smadzenes.",
  "map.[hota] the mysterious island.monster.139.37.1.message" : "Sveiki! Mūsu varonis Monētu meistars mani atstāja šeit ar ziņu:\nviņi dodas izpētīt {pazemes upi}!",
  "map.[hota] the mysterious island.monster.140.170.0.message" : "haaaaaaaaaaaaaaārrrrrr!",
  "map.[hota] the mysterious island.monster.140.94.0.message" : "Mums vajag šo {Kristālu} mūsu rituālam. Ejiet prom!",
  "map.[hota] the mysterious island.monster.141.116.0.message" : "Ko tu te dari?!",
  "map.[hota] the mysterious island.monster.141.137.0.message" : "Dusmīgs!",
  "map.[hota] the mysterious island.monster.141.97.0.message" : "Nebarojiet troļļus!",
  "map.[hota] the mysterious island.monster.143.13.1.message" : "Nē...nē...man vajag\nzeltu\nremontam.",
  "map.[hota] the mysterious island.monster.143.15.1.message" : "IZNĪCINI. IENAIDNIEKU.",
  "map.[hota] the mysterious island.monster.143.77.0.message" : "\"Vienmēr esi tu pats. Ja nevari būt vienradzis.\"\n\nTad vienmēr esi vienradzis.",
  "map.[hota] the mysterious island.monster.144.119.0.message" : "Nav sarežģījumu!",
  "map.[hota] the mysterious island.monster.144.173.0.message" : "HiLoiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii",
  "map.[hota] the mysterious island.monster.144.193.1.message" : "\"Mēs esam zagļi pasaulē, kas mūs vairs nevēlas.\"",
  "map.[hota] the mysterious island.monster.145.35.1.message" : "\"Mēs esam Šmargonrogas pūķi — nometieties ceļos vai pārvērtieties pelnos!\"",
  "map.[hota] the mysterious island.monster.146.154.0.message" : "Šššš!",
  "map.[hota] the mysterious island.monster.146.70.0.message" : "Dēmoniski dēmoni ir sasējuši mūsu māti {alā} starp Konfluksu un Bāku!\nTu degsi viņu dēļ...",
  "map.[hota] the mysterious island.monster.146.89.0.message" : "\"Es kādreiz biju piedzīvojumu meklētājs, tāpat kā tu... tad man celī trāpīja bulta.\"",
  "map.[hota] the mysterious island.monster.147.138.0.message" : "Draugs!!",
  "map.[hota] the mysterious island.monster.148.211.1.message" : "Haaa... vīrieši un viņu pudeles, kāda nāvējoša kombinācija!",
  "map.[hota] the mysterious island.monster.148.213.1.message" : "Ak! Vai kāds teica dārgums?",
  "map.[hota] the mysterious island.monster.149.212.1.message" : "Pagaidi... Es domāju, ka uzvaru... *žagat!*",
  "map.[hota] the mysterious island.monster.149.53.0.message" : "\"Zeķe!\"",
  "map.[hota] the mysterious island.monster.149.62.1.message" : "Urīns!",
  "map.[hota] the mysterious island.monster.15.51.0.message" : "Apstājies. Ikvienam, kurš šķērsos Nāves tiltu, ir jāatbild uz šiem trim jautājumiem manā vietā, ja viņš var redzēt otru pusi.\n\nKā tevi sauc?\nKāds... ir tavs uzdevums?\n\nKāds... ir bezslodzes gaisa ātrums?",
  "map.[hota] the mysterious island.monster.150.118.0.message" : "Nelietis: \"Man vajag zeltu, lūdzu, lūdzu, lūdzu!\"\n\nTu saki: \"Šī nav World of Warcraft - mirsti.\"",
  "map.[hota] the mysterious island.monster.150.213.1.message" : "Vispirms medus... tad cīnīsimies!",
  "map.[hota] the mysterious island.monster.150.48.1.message" : "Govju līmenis?",
  "map.[hota] the mysterious island.monster.151.150.0.message" : "mbm mārciņas mārciņas mārciņas!",
  "map.[hota] the mysterious island.monster.151.212.1.message" : "Vēl viens nemiers? Tikai ne manā sardzē!",
  "map.[hota] the mysterious island.monster.152.51.1.message" : "Neskaties!\nTu tāpat nekad ieeju neatradīsi!",
  "map.[hota] the mysterious island.monster.152.59.1.message" : "Ēēēē...\n\n... {gulbis}!",
  "map.[hota] the mysterious island.monster.153.90.0.message" : "Ko tu saki?\n\"Briesmīgais, resnais hobits\"?!",
  "map.[hota] the mysterious island.monster.154.123.0.message" : "Ļaunums?",
  "map.[hota] the mysterious island.monster.157.4.1.message" : "ArchDevil slēpjas detaļās!",
  "map.[hota] the mysterious island.monster.157.56.1.message" : "Nebarojiet troļļus!",
  "map.[hota] the mysterious island.monster.157.61.1.message" : "Hei! Mana pilsēta ir šeit!",
  "map.[hota] the mysterious island.monster.158.132.0.message" : "Nebaro troļļu, FFS!",
  "map.[hota] the mysterious island.monster.158.246.0.message" : "\"Nēēē... Mēs negribam kļūt par fangarmiem... vai lichiem! Miraks, kādu savdabīgu spēli tu spēlē?!\"",
  "map.[hota] the mysterious island.monster.159.112.0.message" : "Jāāā!",
  "map.[hota] the mysterious island.monster.160.100.0.message" : "\"KUR TAS IR?!\n\nKUR IR {MIRAXI}???\"",
  "map.[hota] the mysterious island.monster.160.194.0.message" : "Šššš!",
  "map.[hota] the mysterious island.monster.162.6.1.message" : "Remontam nepieciešams\nzelts.",
  "map.[hota] the mysterious island.monster.162.70.0.message" : "Tu neizturēsi!",
  "map.[hota] the mysterious island.monster.162.99.0.message" : "\"Esmu aita, zvēru!\n\nĻauj man nomazgāties vannā, labi? Izlaid! Izlaid! Izlaid!\"",
  "map.[hota] the mysterious island.monster.165.44.0.message" : "Uzbrukums, dūriens mugurā, dūriens mugurā, iekšas!\n\nkek",
  "map.[hota] the mysterious island.monster.165.61.1.message" : "Hei! Mana pilsēta ir šeit!",
  "map.[hota] the mysterious island.monster.166.105.0.message" : "Uzbrukums, dūriens mugurā, dūriens mugurā, iekšas!\n\nkek",
  "map.[hota] the mysterious island.monster.167.77.0.message" : "Uzņemt slēpni, iedurt mugurā, iedurt mugurā, izķidāt!\n",
  "map.[hota] the mysterious island.monster.167.8.1.message" : "Nepieciešams. Zelts. Remontam.",
  "map.[hota] the mysterious island.monster.170.102.1.message" : "Tu...\n...nekad...\n...to neatradīsi...\n...!",
  "map.[hota] the mysterious island.monster.170.155.0.message" : "Uzņemt slēpni, iedurt mugurā, iedurt mugurā, izķidāt!\n",

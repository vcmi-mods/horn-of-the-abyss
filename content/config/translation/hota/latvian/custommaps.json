  "map.[hota] the mysterious island.quest.136.99.1.completed" : "\"Es izvēlējos Extreme Ultra Giga Violence.\"",
  "map.[hota] the mysterious island.quest.136.99.1.firstVisit" : "PEGI {16} – ārkārtīgi liela vardarbība!\n\nUz priekšu!",

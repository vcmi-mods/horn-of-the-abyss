  "map.[hota] finding leena.sign.4.93.1.message" : "!!! BĪSTAMI TUMŠIE DŽUNGĻI!!!\n",
  "map.[hota] finding leena.sign.4.96.0.message" : "Atrodi vētrainas uguns bumbu",
  "map.[hota] finding leena.sign.45.98.0.message" : "Atrodi 4 artefaktus",
  "map.[hota] finding leena.sign.48.43.0.message" : "Atrodi pēdējo trūkstošo artefaktu un pabeidz Sharpshooter loka šaušanu.",
  "map.[hota] finding leena.sign.59.105.1.message" : "Atrodi GEL!\n\nUn izmanto viņa īpašās spējas.\n",
  "map.[hota] finding leena.sign.59.109.0.message" : "Atrodi spraugas sfēru\n\n",

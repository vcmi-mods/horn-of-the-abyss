  "map.[hota] finding leena ii.header.description" : "Moandors un viņa Ličes draugi piedāvā bezmaksas turpinājumu jautrajai kartei \"Kur ellē ir Līna?\".\nDodies jaunā piedzīvojumā, atrodi 74 slēptas vietas un ceļus, sakauj ienaidniekus, atrisini uzdevumus un, pats galvenais, atrodi Līnu!\n\n1.04. versija (HOTA 1.7.2)",
  "map.[hota] finding leena ii.header.name" : "Lēnas uzdevums II (parasts)",
  "map.[hota] finding leena ii.monster.86.137.0.message" : "Nekādā gadījumā!!!",
  "map.[hota] finding leena ii.quest.86.53.1.completed" : "Tev jāuzvar 4K melnie pūķi.",
  "map.[hota] finding leena ii.quest.86.53.1.firstVisit" : "Tev jāuzvar 3K melnie pūķi.",
  "map.[hota] finding leena ii.quest.86.53.1.nextVisit" : "Tev jāuzvar 4K melnie pūķi.",
  "map.[hota] finding leena ii.sign.109.112.1.message" : "???",
  "map.[hota] finding leena ii.sign.121.122.0.message" : "Un kā atgriezties?",
  "map.[hota] finding leena ii.sign.14.68.1.message" : "Turpini!",
  "map.[hota] finding leena ii.sign.21.127.0.message" : "ezers",
  "map.[hota] finding leena ii.sign.55.10.1.message" : "Trīs varoņi, Erdamons neuzvaramais!!!",
  "map.[hota] finding leena ii.sign.56.25.1.message" : "Nekādā gadījumā???",
  "map.[hota] finding leena ii.sign.66.139.1.message" : "Lēnas te nav :)",
  "map.[hota] finding leena ii.sign.67.60.0.message" : "Saka, ka tevi gaida sešas lieliskas prasmes...",
  "map.[hota] finding leena ii.sign.88.79.0.message" : "Ezera purvs",
  "map.[hota] finding leena ii.sign.9.127.1.message" : "Vai tu tiešām gribi mani tagad pārspēt?",
  "map.[hota] finding leena.guards.111.62.1.message" : "!!! BĪSTAMI!!!\n\n!!! Saindēta zāle!!!",
  "map.[hota] finding leena.guards.115.31.0.message" : "Šeit tev jānodod Nemirstīgā Karaļa Apmetnis, bet nebēdā, tu dabūsi kaut ko citu :)",
  "map.[hota] finding leena.guards.12.59.0.message" : "Es nezinu... varbūt man vajadzēja iet caur tiem vārtiem :)",
  "map.[hota] finding leena.guards.120.21.1.message" : "Līna\n\nEs tevi te gaidīju jau mūžību!\nKur tu tik ilgi esi uzkavējusies?\nAtbrīvo mani, lai es varu tikt galā ar to netikli Kasiopeju!",
  "map.[hota] finding leena.guards.124.92.1.message" : "Oho, es te netieku cauri??? Kādā veidā???",
  "map.[hota] finding leena.guards.125.26.1.message" : "Nepareizs ceļš!!!",
  "map.[hota] finding leena.guards.139.129.1.message" : "SACĪKSTES\n\nTagad tev ir lielas sacīkstes, tu sacentīsies ar Manfredu. Tev jāuzvar par katru cenu, citādi viss ir zaudēts.\nPaņem līdzi TIKAI VIENU ERCENGEĻI, lai GAVETU",
  "map.[hota] finding leena.guards.15.8.1.message" : "Apsveicu ar lielo uzvaru un neliela balva :)",
  "map.[hota] finding leena.guards.22.113.1.message" : "Divkāršs spēka lauks!",
  "map.[hota] finding leena.guards.26.18.1.message" : "FINIŠA LĪNIJA\n\nCeram, ka dalībnieki NEKRĀPŠANĀS un NESAĪSINĀS maršrutu :-)\n\n",
  "map.[hota] finding leena.guards.27.75.0.message" : "Palīdzība\n\nSarkanie torņi",
  "map.[hota] finding leena.guards.3.101.1.message" : "TUMŠIE DŽUNGĻI\n\nVai esi pārliecināts, ka tev pietiek drosmes iet cauri?",
  "map.[hota] finding leena.guards.5.50.1.message" : "Tu nevari uzvarēt???\n\nVai ir kāds cits veids???",
  "map.[hota] finding leena.guards.50.69.0.message" : "BĪSTAMI!!!",
  "map.[hota] finding leena.guards.73.83.0.message" : "!!! Nelietojiet abus artefaktus (HOTA un CoUK) kopā. Tie viens otram traucēs!!!",
  "map.[hota] finding leena.guards.75.130.0.message" : "Bīstami!",
  "map.[hota] finding leena.guards.92.54.0.message" : "Vai ir vēl kāds veids?",
  "map.[hota] finding leena.header.description" : "Atrodi pareizo ceļu. Atrodi un saliec visus artefaktus. Atrisini uzdevumus. Izlasi padomus un seko tiem. Uzvari visus ienaidniekus un, pats galvenais, atrodi Līnu!!!\n\nVersija Normāla 2.0. (h3 HOTA 1.6 un jaunāka)",
  "map.[hota] finding leena.header.name" : "Meklējot Līnu (N)",
  "map.[hota] finding leena.monster.77.76.1.message" : "Neaizmirsti pēc cīņas IZVAIRĪTIES NO SKELETA, tas tevi palēninās!!!",
  "map.[hota] finding leena.quest.120.40.1.firstVisit" : "Kas? Bezdibeņa stūris?\n\nBet es to jau pievienoju kaut kur citur!!!\n\nTātad man šeit jāatrod vēl viens... varbūt tas būs kaut kur pils tuvumā.\n\n...un kur, pie velna, ir Līna?",
  "map.[hota] finding leena.sign.10.5.1.message" : "Atrodi 2 artefaktus",
  "map.[hota] finding leena.sign.103.24.0.message" : "Aiz šī robežsarga atrodas Drosmes Lauvas vairogs... tāpēc neaizmirstiet to!",
  "map.[hota] finding leena.sign.110.94.1.message" : "Pagriezies pa labi!!!",
  "map.[hota] finding leena.sign.133.131.0.message" : "Pirms uzbrukuma izpētiet šo teritoriju.",
  "map.[hota] finding leena.sign.133.57.0.message" : "Atrodi lietusgāzes sfēru",
  "map.[hota] finding leena.sign.20.125.0.message" : "Atrodi 4 artefaktus un pabeidz Nemirstīgā Karaļa Apmetni\n\nIzmanto Gaisa Skata burvestību",
  "map.[hota] finding leena.sign.26.47.0.message" : "Ak, NĒ! Ar to ceļojums beidzas. Man jāatgriežas un tas viss vēlreiz perfekti jāizpēta.",
  "map.[hota] finding leena.sign.28.116.0.message" : "Vau! Bāka un noteikti kaut kāda jauka maģija.\n\nKaut kur jābūt ceļam, bet kur?\nMan tas jāieslēdz!!!\n",
  "map.[hota] finding leena.sign.33.100.1.message" : "Zidaras teritorija",
  "map.[hota] finding leena.sign.33.93.0.message" : "Atrodi 2 artefaktus.",

  "map.[hota] purgatory.guards.2.131.0.message" : "Slēpnis",
  "map.[hota] purgatory.guards.204.138.0.message" : "Tu ignorē zīmes un virzies uz priekšu. Pēkšņi dzirdi draudīgu balsi, kas nāk līdzi vējam:\n\"Es... jūtu... SPĒLĒTĀJU!\"",
  "map.[hota] purgatory.guards.218.197.1.message" : "Vai vēlaties izlaupīt šo jauko pilsētu un aplaupīt visus jaukos iedzīvotājus iekšā?",
  "map.[hota] purgatory.guards.22.72.0.message" : "rēciens",
  "map.[hota] purgatory.guards.231.18.0.message" : "Cilvēks vienkārši netiek debesīs.",
  "map.[hota] purgatory.guards.232.38.1.message" : "Tu ignorē zīmes un virzies uz priekšu. Pēkšņi dzirdi draudīgu balsi, kas nāk līdzi vējam:\n\"Es... jūtu... SPĒLĒTĀJU!\"",
  "map.[hota] purgatory.guards.28.69.0.message" : "rēciens",

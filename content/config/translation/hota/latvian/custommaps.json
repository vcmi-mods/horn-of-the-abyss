  "map.[hota] might and magic.town.99.170.1.name" : "Pazaudētā svētnīca",
  "map.[hota] noble nemesis.event.0.description" : "Tuksneša ciltis vienmēr ir cīnījušās par izdzīvošanu, bet tagad tām ir jāapvienojas, lai stātos pretī tirāna varai. Vai vari tās apvienot un izaicināt karaļa dzelzs dūri?",
  "map.[hota] noble nemesis.event.1.description" : "Zem zemes paslēpušies pūķi gaida. Ir pienācis laiks pamodināt viņu dusmas un vest viņus cīņā pret karaļa varu.",
  "map.[hota] noble nemesis.event.2.description" : "Karaļa vara vēl nav sasniegusi tuksnesi, bet viņa ietekme pieaug. Atbrīvojiet mašīnu un radību armiju un sagraujiet viņa impēriju, skrūvi pa skrūvei!",
  "map.[hota] noble nemesis.event.3.description" : "Purvos un mežos daba ir varena, taču no tevis ir atkarīga tās pārvaldīšana. Vai vari izmantot dabas spēkus, lai uzveiktu karaļa armiju?",
  "map.[hota] noble nemesis.event.4.description" : "Gadsimtiem ilgi iesprostoti tumsā, nekromanti mostas, lai atgūtu savu varu. Tagad ir pienācis laiks izmantot nāves spēkus, lai apstrīdētu karaļa varu.",
  "map.[hota] noble nemesis.event.5.description" : "Dziļi ugunīgajos dziļumos Inferno sirds pulsē nepieradinātā ugunī. Vai tu spēsi iekurt apjukuma liesmas un iedzīt to vēl lielākā nemierā, pasaulei atrodoties uz haosa robežas?",
  "map.[hota] noble nemesis.event.6.description" : "Tu dodies dārgumu meklējumos, bet uzzini, ka karaļa valdīšana ir pārvērtusi tavus meklējumus daudz aizraujošākos. Paķer, ko vari, un varbūt pat gāz karali no troņa, kamēr esi pie tā!",
  "map.[hota] noble nemesis.event.7.description" : "Pazemes upes galā atrodas sens zikurāts, kurā glabājas visspēcīgākie artefakti un burvestības. Lai to sasniegtu, varonim vispirms jāmeklē Zaļās telts atslēgu meistara padoms.",
  "map.[hota] noble nemesis.guards.104.31.1.message" : "+pieredze +izveidot +sp",
  "map.[hota] noble nemesis.guards.107.76.0.message" : "Karaļa suņi domāja, ka mani ir iedzinuši stūrī. Tagad viņi uzzinās, ka es kožu stiprāk. Pie jums ir mani naži...",
  "map.[hota] noble nemesis.guards.136.236.1.message" : "+sp +pieredze +veidotājs",
  "map.[hota] noble nemesis.guards.151.171.1.message" : "+pieredze +radījums +statistika +sp",
  "map.[hota] noble nemesis.guards.175.41.0.message" : "Tās ir karaliskas mantas! Ko jūs šeit darāt?!",
  "map.[hota] noble nemesis.guards.193.79.1.message" : "Pūķi alā izskatās draudzīgi... un šķiet, ka tie vairojas?",
  "map.[hota] noble nemesis.guards.199.180.1.message" : "+pieredze +sp +radošais",
  "map.[hota] noble nemesis.guards.21.229.1.message" : "izsaukt mākslīgā intelekta kuģi",
  "map.[hota] noble nemesis.guards.213.8.1.message" : "Tu taču nedomāji, ka tas būs bez maksas, vai ne?",
  "map.[hota] noble nemesis.guards.216.11.1.message" : "Asmens kvēlo solījumu pilns... bet tu neesi vienīgais, ko tas piesaista. Sargi kustas – it kā haoss aizstāvētos.",
  "map.[hota] noble nemesis.guards.216.18.1.message" : "Mūžīgā liesma atmodina drosmi, laimi un maģiju dziļi iekšienē.",
  "map.[hota] noble nemesis.guards.221.10.1.message" : "Tu uzmet monētu, un tā kūst. Veiksmei šeit nav vietas.",
  "map.[hota] noble nemesis.guards.222.11.1.message" : "Karstums satriec ne tikai ķermeni, bet arī garu. Jūsu karaspēks soļo... bez pārliecības.",
  "map.[hota] noble nemesis.guards.223.12.1.message" : "Uguns šeit barojas no gribasspēka. Tava maģija izsīkst – tā ir izdegusi.",
  "map.[hota] noble nemesis.guards.225.13.1.message" : "Karstums satriec ne tikai ķermeni, bet arī garu. Jūsu karaspēks soļo... bez pārliecības.",

  "map.[hota] element land.sign.84.39.0.message" : "Reti sastopami \"Lielā varoņa\" priekšmeti.",
  "map.[hota] element land.sign.85.107.0.message" : "Lūk, pūķi.",
  "map.[hota] element land.sign.86.9.0.message" : "Slepenā ļaunā klonēšanas laboratorija, turieties pa gabalu.",
  "map.[hota] element land.sign.89.35.0.message" : "Šajā salā aug \"Lielais varonis\".",
  "map.[hota] element land.sign.91.107.0.message" : "Piromanceru sala",
  "map.[hota] element land.sign.95.163.0.message" : "Rokraksts ir tik slikts, ka iekšā esošo ziņojumu nevar izlasīt.",

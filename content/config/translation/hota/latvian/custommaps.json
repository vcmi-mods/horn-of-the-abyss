  "map.[hota] might and magic.guards.250.198.0.message" : "HASPID BASEINS\n\nCeļa meklētāja bonuss:",
  "map.[hota] might and magic.guards.250.206.1.message" : "Arčibalds:\n\"Šī kaste ir pilna ar maģisku enerģiju. Kaut kas, ar ko jūs varat saskarties, to atverot, ir ārkārtīgi bīstams. Šīs kastes nosaukums izklausās pēc \"DEBESU PAKTA\"\"",
  "map.[hota] might and magic.guards.251.83.0.message" : "Arčibalds:\n\"Šī ir bezvārda Pandoras lāde. Es tajā nejūtu nekādu būtisku maģisku enerģiju, izņemot to, kas nepieciešama šīs lādes pastāvēšanai. Lai gan dažreiz es varu kļūdīties.\"",
  "map.[hota] might and magic.guards.26.134.1.message" : "\"Zemes gari neļaus necienīgajiem atklāt savus noslēpumus. Tev jāpierāda savs spēks, lai liktu viņiem pakļauties tavai gribai.\"",
  "map.[hota] might and magic.guards.28.158.0.message" : "TIDEWATER\n\nCeļa meklētāja bonuss:",

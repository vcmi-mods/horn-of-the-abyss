	"map.[hota] the mysterious island.header.name" : "- Tajuplný ostrov -",
	"map.[hota] the mysterious island.header.player.0.mainHeroName" : "Noční král",
	"map.[hota] the mysterious island.header.player.7.mainHeroName" : "John Silver",
	"map.[hota] the mysterious island.header.rumor.0.text" : "... zdá se, že pod sopkou žije tajemný {kapitán N.}...",
	"map.[hota] the mysterious island.header.rumor.1.text" : "Slyšel jsem někoho říkat, že bylo možné vyrobit impozantní zbraň, {Angelic Alliance}, přivedením tvorů k {šesti} různým věštcům...",
	"map.[hota] the mysterious island.header.rumor.10.text" : "Než vstoupíte na jeho území, síla červeného hráče v cechu zlodějů může být {nadhodnocena}... Za tuto informaci mu nevěřte.",
	"map.[hota] the mysterious island.header.rumor.11.text" : "{piráti} (Pink) mohou být schopni naplánovat koordinovaný útok na {více místech} současně {ve stejný čas}.",
	"map.[hota] the mysterious island.header.rumor.12.text" : "Chcete-li zastavit erupce, je snazší jim čelit pomocí {Orb of Vulnerability}. Ale má ho pouze {strážce rudého území}.",
	"map.[hota] the mysterious island.header.rumor.13.text" : "Legendární kouzlo {Town Portal} je přístupné pouze {po} návštěvě {Red Keymaster}. Až na jednu speciální hrdinku...",
	"map.[hota] the mysterious island.header.rumor.14.text" : "Síla sopky (červení hrdinové) se zvýší na začátku {každého měsíce}, počínaje {sedmým} měsícem.",
	"map.[hota] the mysterious island.header.rumor.15.text" : "Říká se, že existují {zadní vrátka}, která mohla odemknout pouze {The Mother of Dragons} nebo určitý {Ben}, což umožňuje obejít určité cesty. Poznámka autora: Zadní vrátka jsou volitelné.",
	"map.[hota] the mysterious island.header.rumor.16.text" : "Jen {tvorové} na {malých ostrůvcích} kolem ostrova na sobě mohou mít {zdroje}...",
	"map.[hota] the mysterious island.header.rumor.17.text" : "Spěch dělá odpad! Zanedbání {klíčů} a {primárních dovedností} vás přijde draho. Velmi, velmi drahá...",
	"map.[hota] the mysterious island.header.rumor.18.text" : "Mít {jediného} hlavního hrdinu, který navštívil maximální počet stránek s {primárními dovednostmi}, by bylo z dlouhodobého hlediska {sebevražedné}...",
	"map.[hota] the mysterious island.header.rumor.19.text" : "Hodor! Hodor, hodor. Hodor hodor hodor, hodor. Hodor! HODOR! HOLDOOR! {HOLD THE DOOR}!",
	"map.[hota] the mysterious island.header.rumor.2.text" : "Tajemná postava pod vulkánem, kapitán N., bude mít způsob, jak se {navigovat pod vodou} a dostat se na jakékoli místo na ostrově!",
	"map.[hota] the mysterious island.header.rumor.20.text" : "Na nejvyšších úrovních obtížnosti (královna a král), když nepřítel navštíví trenéra {primární dovednosti}, zvýší se {třikrát více} než u nás!",
	"map.[hota] the mysterious island.header.rumor.21.text" : "Mluví se o starém mudrci jménem {Miraxi} žijící na tomto ostrově. Říkají, že vlastní {mlýn} a {pole} poblíž {jezera}.",
	"map.[hota] the mysterious island.header.rumor.22.text" : "Piráti ukryli svůj {poklad} na čtyřech různých místech... První by bylo hned za jejich městem, {The Pirate Bay}.",
	"map.[hota] the mysterious island.header.rumor.23.text" : "Kusy {Sochy Legie} jsou roztroušeny po ostrově. Železná banka na východě vzala jediného {Head of Legion}.",
	"map.[hota] the mysterious island.header.rumor.24.text" : "Dostat se do Iron Bank je opravdu {pomalé}...",
	"map.[hota] the mysterious island.header.rumor.25.text" : "Říká se, že {Matka draků} může dosáhnout kouzla {Town Portal}, aniž by dokonce čelila červené frakci!",
	"map.[hota] the mysterious island.header.rumor.3.text" : "Bylo by možné najít grál BEZ návštěvy všech klíčových mistrů... Řekl mi to chlap jménem {Ayrton}, ale neviděl jsem ho desítky let.",
	"map.[hota] the mysterious island.header.rumor.4.text" : "Na ostrově jsou nějaké {dračí utopie}. A obsahují téměř veškerý mocný kombinovaný artefakt nazvaný {Síla dračího otce}.",
	"map.[hota] the mysterious island.header.rumor.5.text" : "Říká se, že existuje tajný kult upírů, organizovaný {sídly} tohoto ostrova. Mějte oči otevřené – přístup může být skrytý {za něčím}.",
	"map.[hota] the mysterious island.header.rumor.6.text" : "2 cesty pro {Grail}: {Path of conquest} sesbírejte {6} barevných {klíčů}, získejte přístup k {Nautilus} a průchod do {Grail}. NEBO {Path of exploration}, rychlejší nalezení {Ayrton} na izolovaném ostrově NorthWest...",
	"map.[hota] the mysterious island.header.rumor.7.text" : "V moři kolem ostrova jsou tři {námořnické akademie}. Každý z nich vám umožní naučit se {Water Magic} a {Navigation}.",
	"map.[hota] the mysterious island.header.rumor.8.text" : "{Eagle Eye} by byl JEDINÝ způsob, jak získat kouzla {Berserk} a {Armageddon}... Chcete-li je sdílet, pouze JEDEN hrdina má dovednost {Scholar}!",
	"map.[hota] the mysterious island.header.rumor.9.text" : "Dovednost {Eagle Eye} už není vtip.\n\n",
	"map.[hota] the mysterious island.heroes.10.biography" : "Neutrální dobrý... nebo spíše chaotický dobrý temný duchovní! Poněkud posedlí kultem Travie, jinak velmi vážné bohyně Hearth, později zjistíme, že byl většinou knězem Raie, bohyně rozkoše…! Říká se, že je schopen požehnat svým nepřátelům mocným kyjem a může mít několik užitečných požehnání… ale to se teprve uvidí.",
	"map.[hota] the mysterious island.heroes.109.biography" : "Simerský barbar, jehož inteligence nebezpečně oscilovala mezi volem a žábou... jako v bajce, a když se postaví medvědovi, pošetile prodá svou kůži a roztrhá ji ten, koho si přála napíchnout! (Matoucí, že?... jasné... duchovní...)",
	"map.[hota] the mysterious island.heroes.111.biography" : "Neb (Nebuchadnezzar): bývalý otrok osvobozený svým pánem Cyrusem Smithem, zůstává mu věrný z vděčnosti a obdivu.",
	"map.[hota] the mysterious island.heroes.111.name" : "Nab",
	"map.[hota] the mysterious island.heroes.116.biography" : "Gorgonzola!",
	"map.[hota] the mysterious island.heroes.129.biography" : "Konec se blíží...",
	"map.[hota] the mysterious island.heroes.129.name" : "Zemětřesení",
	"map.[hota] the mysterious island.heroes.130.biography" : "Červená jezdkyně - jezdkyně z Apokalypsy",
	"map.[hota] the mysterious island.heroes.130.name" : "Válka",
	"map.[hota] the mysterious island.heroes.132.biography" : "Mor",
	"map.[hota] the mysterious island.heroes.133.biography" : "Konec se blíží...",
	"map.[hota] the mysterious island.heroes.133.name" : "Proud lávy",
	"map.[hota] the mysterious island.heroes.134.biography" : "Dobytí!",
	"map.[hota] the mysterious island.heroes.134.name" : "Dobytí",
	"map.[hota] the mysterious island.heroes.142.biography" : "Anne Bonny",
	"map.[hota] the mysterious island.heroes.142.name" : "Anne Bonny",
	"map.[hota] the mysterious island.heroes.143.biography" : "Sailor, muž stejně zručný v šití jako v truhlářství, který se později stal farmářem.",
	"map.[hota] the mysterious island.heroes.143.name" : "Pencroft",
	"map.[hota] the mysterious island.heroes.145.biography" : "{LordCameron} – První anglicky mluvící youtuber, který hrál za frakci {Fortress} (Green) na mapě verze 1.4.e, celá biografie přijde v příští aktualizaci...\n\nSledujte jeho dobrodružství na YouTube!",
	"map.[hota] the mysterious island.heroes.149.biography" : "{\"Le J\"} - První francouzský streamer, který hraje za frakci {Stronghold} (Tan) na mapě verze 1.4.j, celá biografie přijde v příští aktualizaci...\n\nSledujte jeho dobrodružství na YouTube a zachyťte jeho budoucí činy na Twitchi!",
	"map.[hota] the mysterious island.heroes.150.biography" : "Zima je tady.",
	"map.[hota] the mysterious island.heroes.150.name" : "Noční král",
	"map.[hota] the mysterious island.heroes.153.biography" : "Princezna z Dračího kamene.\nKrálovna sedmi království.\nDaenerys Stormborn, Nespálená, Královna Meereenu, Královna Andalů a Rhoynarů a Prvních lidí, Khaleesi z Velkého Grass Sea, Lamač okovů a Matka draků.\nPán Sedmi království.\nOchránce říše.",
	"map.[hota] the mysterious island.heroes.153.name" : "Daenerys",
	"map.[hota] the mysterious island.heroes.157.biography" : "Mezi vlnami a palbou z děl zaznívá jedno jméno: {Picso}.\nPrvní (francouzský) streamer, který zde mapuje kurz frakce {Green Cove}.\nJeho cesty pokračují na {YouTube} (Picso) a {Twitch} (zepicso)... \n\nA posádka přísahá: \"Labradoři to dělají levněji.\"",
	"map.[hota] the mysterious island.heroes.166.biography" : "{Mundus}, legendární speedrunner, který na tomto ostrově znovu a znovu trhal rekordy.\nNejprve ji zdolal za {110 dní}, poté za {81 dní}, než dosáhl nemyslitelného: dechberoucího {64denního běhu}, který zanechal celou komunitu v úžasu!\nKromě svých neuvěřitelných běhů sloužil také jako oddaný tester mezi verzemi {1.3} a {1.4} a pomáhal formovat mapu do dnešní podoby.\nSkutečný mistr optimalizace!",
	"map.[hota] the mysterious island.heroes.17.biography" : "Trpasličí válečník, neutrální dobrý (v očích společnosti, ale zákonný dobrý vůči skupině), vysoký asi 160 cm, téměř nezničitelný (!) s trochu hlučnou kovovou nohou! Bručoun, troufalý, drsný, ale docela sympatický, ovládá těžké magické kladivo, které je obzvláště účinné, které může házet na své nepřátele... a získat ho pomocí bumerangového efektu! Jeho vousy jsou jeho klenotem (kromě stovek zlatých mincí, které vlastní...).",
	"map.[hota] the mysterious island.heroes.173.biography" : "Je králem napůl legendárního mořského rodu, který byl považován za vyhynulého. Tarkus si uvědomil, že aby se jeho lidé mohli vrátit, musí získat pomoc od mocných spojenců. Jeho novými bratry ve zbrani se stali Piráti. Jako všichni nixové je to mocný válečník, schopný bojovat na zemi i na moři. Ostatní nixové ho chválí a berou jako skvělý příklad.",
	"map.[hota] the mysterious island.heroes.174.biography" : "{Hieu Tran}, neohrožený námořní dobyvatel, který dokázal, že ovládnutí vln vede k vítězství.\nNa tomto ostrově s pirátskou tématikou plně přijal námořního ducha: ode dne 1. týdne 2 byl vyslán na moře, sbíral 5 000 zlatých denně a řešil všechny problémy se zdroji, zatímco ostatní bojovali na souši.\nS Admiral\"s Hat a téměř 10 000 mořským pohybem ovládl oceány a podpořil skvělou strategii {Xeron}, která rozbila všechny rekordy: ohromující {62denní speedrun}, který nechal komunitu beze slov!\nSkutečný mistr moří a taktických inovací.\nKdyž budete pozorně naslouchat, můžete ho slyšet říkat: \"Stále to není dost rychlé!\"",
	"map.[hota] the mysterious island.heroes.18.biography" : "Elizabeth Swannová",
	"map.[hota] the mysterious island.heroes.183.biography" : "{Winnymaru} je první (francouzský) streamer, který hraje za frakci Factory.\n\nFanoušek limonády a optimalizace, jeho epickou cestu najdete na jeho kanálu YouTube: {MrWinnymaru} a jeho nová dobrodružství na jeho kanálu Twitch: {winnymarubaba}. \nJe také známý tím, že je hezký a skvěle voní... a pro několik relací Twitch na této mapě, nejdelší přes {7 hodin a 40 minut}!",
	"map.[hota] the mysterious island.heroes.184.name" : "Caesar",
	"map.[hota] the mysterious island.heroes.185.biography" : "{Violet} (běžně známá jako Vi) se narodila v Zaun Felicii a Connolovi, později měla mladší sestru Powder, ke které měla velmi blízko.\nKdyž Vander, Felicia, Silco a Connol vedli povstání proti Piltoveru, její rodiče byli zabiti v bitvě a Vander vzal sestry dovnitř.\nVander později adoptoval také dva sirotky a Vi se stal vůdcem jejich skupiny.",
	"map.[hota] the mysterious island.heroes.189.biography" : "Ayrton je pětačtyřicetiletý muž.\nS drsnou tváří, navzdory hubenosti těla, se zdá být obdařen velkou elánem, protože má jen kosti a nervy.\nStředně vysoký, s vyvinutou kostrou ramen, má inteligentní a energickou postavu, kde pod velmi vpadlými oblouky obočí proniká brilantní pohled.\nPřes tvrdost jeho rysů a odhodlaný vzhled vzbuzuje jeho tvář sympatie, kde lze tušit stigmata utrpení, které musí snášet muž.\nJeho osobnost je zřejmá od začátku a varuje v jeho prospěch.",
	"map.[hota] the mysterious island.heroes.189.name" : "Ayrton",
	"map.[hota] the mysterious island.heroes.192.name" : "John Silver",
	"map.[hota] the mysterious island.heroes.193.biography" : "Jako malá dívka byla Powder plachá a sladká, ale nemotorná a náchylná k chybám. To, spárované s případem syndromu prostředního dítěte, vyvolalo podráždění u jejího staršího \"bratra\" Myla, který o ní hovořil jako o jinx. Velmi obdivovala svou starší sestru Vi (její jedinou biologickou rodinu) a viděla v ní vzor a téměř rodičovskou postavu. I když nebyla tak fyzicky zdatná jako Vi, byla velmi kreativní a většinu svého volného času trávila výrobou různých druhů vynálezů, většinou {bomby} a dalších malých {výbušnin}. Byly však předvídatelně nespolehlivé a byly účinné až později v jejím mladistvém věku. Ukázala, jak zručná umí se zbraní.",
	"map.[hota] the mysterious island.heroes.194.biography" : "Inženýr, vědec, ten, kdo je schopen dělat oheň, keramiku nebo výbušniny. Osoba, na kterou se odkazuje celá jednotka, když je třeba učinit rozhodnutí.",
	"map.[hota] the mysterious island.heroes.194.name" : "Cyrus Smith",
	"map.[hota] the mysterious island.heroes.195.biography" : "Hayreddin Barbarossa",
	"map.[hota] the mysterious island.heroes.195.name" : "H.Barbarossa",
	"map.[hota] the mysterious island.heroes.197.biography" : "Mary Jane Readová.",
	"map.[hota] the mysterious island.heroes.197.name" : "Mary Read",
	"map.[hota] the mysterious island.heroes.21.biography" : "Neutrální-neutrální elfí bard, hrdý, povýšený a pohledný, který má za sebou neuvěřitelné množství dobrodružství; viděl více než 50 postav umírat před jeho očima (ano, opravdu!); kdysi dávno byl zabit červeným drakem, ale poté byl vzkříšen díky \"přání\" od Zehirmahnn. Opatrný, ví, jak v případě potřeby utéct... Má impozantní kouzla, která dokáže seslat zvukem své harfy (typ kouzla... \"můj krásný paladine, osvětli mi cestu\"...).",
	"map.[hota] the mysterious island.heroes.212.biography" : "Jup (zkratka pro Jupiter) je tajemný tvor, který na Ostrově objevili trosečníci.\nZpočátku divoký a nezkrotný, rychle prokáže svou pozoruhodnou inteligenci a přizpůsobivost.\n\nSilný, loajální a překvapivě chytrý Jup se učí pomáhat s domácími úkoly a stává se neocenitelným členem malé komunity.\nJeho schopnost učit se a jeho věrná povaha ho promění z pouhého zvířete ve skutečného společníka.\nBěhem mimořádného dobrodružství kolonistů na tajemném ostrově jim Jup oddaně slouží a dokazuje, že inteligence a spolupráce mohou překročit hranice druhů.",
	"map.[hota] the mysterious island.heroes.22.biography" : "Burrich je dobře stavěný, klidná hora muže.\nJeho obličej je úzký, hranatý a opálený.\nMá dlouhoprsté a chytré ruce.\nBurrich je většinou popisován svými několika přáteli jako tvrdohlavý, čestný, přímý a trochu melancholický. Své podnikání si nechává pro sebe.\nJe to působivá postava: jen pohledem a tichým slovem udržoval v disciplíně celou místnost plnou drsných mužů. Jako mladší si Burrich při lovecké nehodě těžce poranil nohu a chránil rytířstvo před divočákem. Špatně se to hojilo a on stále kulhá - jeho drsná a nepřátelská povaha se umocňuje, když ho to silně trápí; obvykle, když je na obzoru déšť. Je však zvláštně citlivý na to, aby se o tom diskutovalo, a bude štěkat na každého, kdo se k tomu vyjádří.",
	"map.[hota] the mysterious island.heroes.23.biography" : "{JohnCutt}, první (francouzský) streamer, který se postavil proti frakci Rampart v epické kampani, plné odvážných bitev a podivných vyšetřování bizarních receptů, jako jsou smažené tyčinky Mars a další kulinářské zvláštnosti\n\nJe také skvělým vynálezcem legendárního Maroilles \"tarte en frites\", jídla obávaného i uctívaného.\n\nSledujte jeho dobrodružství na Twitchi pod stejným jménem: {JohnCutt}.",
	"map.[hota] the mysterious island.heroes.231.biography" : "Kapitán Nemo, známý jako princ Dakkar.\nNemo získal západní vzdělání, během kterého, jak sám uvádí, strávil své mládí turné a studiem po celé Evropě. Při jeho prvním setkání s profesorem Aronnaxem a jeho společníky na něj tři trosečníci mluví francouzsky, anglicky, latinsky a německy.\nInovativní inženýr Nemo navrhl a vyrobil Nautilus, včetně jejích elektrických pohonných jednotek a navigačních systémů. S jejich využitím s mimořádnou dovedností zdolal některé z nejobtížnějších podvodních průchodů oceánu...",
	"map.[hota] the mysterious island.heroes.231.name" : "Kapitán Nemo",
	"map.[hota] the mysterious island.heroes.28.biography" : " Tajemný poustevník jménem Ben Kenoby.",
	"map.[hota] the mysterious island.heroes.28.name" : "Ben Kenobi",
	"map.[hota] the mysterious island.heroes.37.biography" : "{Lexiav} byl první anglicky mluvící streamer, který velel {Blue Tower} přes tento ostrov.\n\nOd samého začátku udeřil do svých nepřátel strach a během prvního měsíce dobyl nepřátelská města pouze s malou armádou a kouzlem Magic Arrow!\n\nPokračoval v dobytí povrchu ostrova za pouhé čtyři měsíce a dobrodružství dokončil za méně než 300 dní.\n\nNavzdory své rychlosti si legenda vypráví, že si udělal čas na poslední drink s pirátem \"Caesarem\", kterého uvěznil na pobřeží...",
	"map.[hota] the mysterious island.heroes.38.biography" : "Válečný reportér.",
	"map.[hota] the mysterious island.heroes.38.name" : "Hra Gideon",
	"map.[hota] the mysterious island.heroes.4.biography" : "Ser Jaime Lannister, rytíř Královské gardy, Lord Commander.\n\nZnámý jako \"Kingslayer\" za zabití krále Aeryse II během Robertova povstání, čin dlouho opovrhovaný, ale učiněný pro záchranu bezpočtu nevinných.\n\nSloužil se ctí pod několika králi a nakonec se rozhodl bojovat za živé ve Velké válce proti mrtvým.\n\nProslul svými dovednostmi v bitvě a bezkonkurenčním uměním šermu, byl zajat a zmrzačen během Války pěti králů, přesto se navzdory zranění vrátil do boje s odvahou.",
	"map.[hota] the mysterious island.heroes.48.biography" : "Mitchave - První francouzský streamer, který hraje za frakci Inferno (Orange) na mapě verze 1.4.n.\nPvP veterán, který začal své dobrodružství s působivou rychlostí a efektivitou.\n\nJeho cesta stále pokračuje a tato biografie bude aktualizována, jakmile dokončí své epické pátrání...\n\nSledujte jeho dobrodružství na Twitchi a YouTube!",
	"map.[hota] the mysterious island.heroes.57.biography" : "Zorlim, extraplanární bytost z Planiny ohně... obrovský, s červenýma očima, zrzavou kůží, zrzavými vlasy a vysokou tělesnou teplotou (140 °F / 60 °C)... ovládá útočná kouzla vázaná výhradně na svůj živel... Pokud by tato bytost měla bílou nebo černou kůži, nakonec by připomínala vysokého člověka typu \"orientální a jedné noci\" (jako \"orientální a Jednonoční\" typu! Je jasně neutrální dobrý; často prostředník, zvědavý a odvážný, nevzplane tak snadno...",
	"map.[hota] the mysterious island.heroes.60.biography" : "Cyrusův pes.",
	"map.[hota] the mysterious island.heroes.60.name" : "Nahoru",
	"map.[hota] the mysterious island.heroes.66.biography" : "{Moucheron Quipet} byl první (francouzský) streamer, který vedl {Teal Necropolis} přes tuto zemi.\nJeho cestu můžete znovu prožít na {YouTube} a sledovat jeho nová dobrodružství živě na {Twitch} pod stejným názvem: {MoucheronQuipet}.\n\nJe také skvělým tvůrcem map pro fheroes2 (jedna z jeho map byla dokonce zahrnuta do oficiálních map fheroes2: \"Eruption\").",
	"map.[hota] the mysterious island.heroes.71.biography" : "Smrt",
	"map.[hota] the mysterious island.heroes.79.biography" : "Kdysi temný vládce {Dungeon of Naheulbeuk}, {Zangdar} vládl s hrůzou po boku svého mazaného poradce Reivaxe.\n\nBojí se o svou magickou sílu a nestabilní povahu a skrývá zvláštní slabost: extrémní alergii na špatnou hudbu - zvláštní vlastnost, kterou jeho nepřátelé využili ve svůj prospěch.",
	"map.[hota] the mysterious island.heroes.85.biography" : "{Wasilix} byl prvním tvůrcem obsahu, který se vydal do hlubin {Orange Dungeon} na tomto ostrově.\n\nZatímco ostatní obezřetně sdíleli své slepé první pokusy, on zvolil jiný přístup: jako první nabídl divákům plnou rychlostní VOD, metodicky zdolal dobrodružství za pouhých {75 dní}!\n\nTento mistr podsvětí, známý svou analytickou myslí a pečlivým přístupem, vnesl do obsahu kolem této mapy nový rozměr.\n\nStaňte se svědky Wasilixových záletů na YouTube: {wasilix heroes 3}",
	"map.[hota] the mysterious island.heroes.94.biography" : "15 let, sirotek, stará se o něj Pencroff. Dychtivá učit se, přináší jeho botanické znalosti do společnosti.",
	"map.[hota] the mysterious island.heroes.94.name" : "Harberta",
	"map.[hota] the mysterious island.monster.10.199.0.message" : "Pane, tudy do mého města!",
	"map.[hota] the mysterious island.monster.100.178.0.message" : "Nedívej se tak! Dějí se tam hnusné věci!",
	"map.[hota] the mysterious island.monster.100.82.1.message" : "\"Skrze plameny...",
	"map.[hota] the mysterious island.monster.100.87.1.message" : "... Svatyně městského portálu\"",
	"map.[hota] the mysterious island.monster.101.174.0.message" : "Hej! Moje město je tudy!",
	"map.[hota] the mysterious island.monster.101.178.0.message" : "Podívejte se na to, můj pane!\nNáš \"Secret Vampire Cult\" pracuje na přivolání sil zla!\n\nChcete-li se k nám připojit, projděte tajnými dveřmi ZA sídlem na severozápadě.\n",
	"map.[hota] the mysterious island.monster.101.84.0.message" : "\"Nyní budete svědky skutečné moci Krále Lichů.\"",
	"map.[hota] the mysterious island.monster.102.116.1.message" : "Ochutnej můj kouř!",
	"map.[hota] the mysterious island.monster.102.118.0.message" : "SEZNĚTE MŮJ SKÁLA!",
	"map.[hota] the mysterious island.monster.102.136.0.message" : "Upálit kacíře!",
	"map.[hota] the mysterious island.monster.102.14.0.message" : "Strážci majáku se zbláznili, říkají divné věci:\n\n\"Nooo... Nechceme se stát fangarmy... nebo lichy! Miraxi, jakou zvrácenou hru to hraješ?!\"",
	"map.[hota] the mysterious island.monster.102.172.1.message" : "DONT.\nDOTEK.\nV MUMIÍCH.",
	"map.[hota] the mysterious island.monster.102.90.1.message" : "Haha, stejně nikdy neprojdete: průchod jsme zapečetili!",
	"map.[hota] the mysterious island.monster.104.161.0.message" : "Slyšíte, jak váš zvěd křičí z jejich stanu:\n\"Tady! Našel jsem klíč k {odemknutí cesty} ke {světle modrému} keymasterovi!\"",
	"map.[hota] the mysterious island.monster.105.244.0.message" : "Strážci majáku se zbláznili, říkají divné věci:\n\n\"Ne... Nechceme se stát fangarmy nebo dalšími lichy. Miraxi, co jsi přesně udělal?\"",
	"map.[hota] the mysterious island.monster.106.137.0.message" : "Ať odpočívají v pokoji!",
	"map.[hota] the mysterious island.monster.107.172.1.message" : "\"Budeme bránit tuto zemi, celý den!\"",
	"map.[hota] the mysterious island.monster.107.98.0.message" : "Nedívej se!\nStejně nikdy nenajdete vchod!",
	"map.[hota] the mysterious island.monster.108.62.0.message" : "Nechte draky spát!",
	"map.[hota] the mysterious island.monster.109.126.0.message" : "Nedotýkejte se!",

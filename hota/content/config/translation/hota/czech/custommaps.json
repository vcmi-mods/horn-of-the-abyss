	"map.[hota] the mysterious island (allied).quest.211.215.0.completed" : "Vítejte! Zde najdete nápovědu pro závěrečnou bitvu.",
	"map.[hota] the mysterious island (allied).quest.211.215.0.firstVisit" : "Pouze frakce nesoucí {zelený} transparent si zaslouží projít!",

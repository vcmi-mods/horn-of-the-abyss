	"map.[hota] might and magic.event.99.description" : "Archibald:\n\"Mluvili jsme o porážce Triumvirátu a invazi do jejich říší, ale zdá se, že nám uniká důležitý detail - jejich majetek je neproniknutelný, chráněný magickými branami, aktivovanými po jejich vítězství proti koalici Antagarich. Zmátl jsem tě, ale naštěstí mám také stopu. \"Bílé brány\", jak se jim říká - nebyly vytvořeny Triumvirátem po staré civilizaci Ent. pakt o neagresi podepsaný mezi národy Enrothu, neexistoval příliš dlouho a magický systém není tak stabilní, ale právě teď hraje proti nám Brány, v tomto případě potřebujeme \"Bílý klíč\" a můžeme ho najít tam, kde byl vytvořen v Starých městech - je potřeba, aby se podařilo najít všechny badatele a najít cestu ke všem Eastern Jadame, Tidewater Caverns a Balthazarův labyrint, musí tam být brána vedoucí k \"Bílému klíči\"\"",
	"map.[hota] might and magic.guards.1.28.1.message" : "Archibald:\n\"Tato krabice je plná magické energie. Něco, čemu můžete čelit, jakmile ji otevřete, je extrémně nebezpečné. Název udělený této krabici zní jako \"ČERNÁ PAKTA\"\"",
	"map.[hota] might and magic.guards.1.83.0.message" : "\"Spirits of Water nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",
	"map.[hota] might and magic.guards.10.180.0.message" : "Archibald:\n\"Tato Pandořina skříňka je určena Elmorovi.\"",
	"map.[hota] might and magic.guards.10.196.1.message" : "SKRYTÝ ZÁTOK\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.100.69.0.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.100.97.0.message" : "KAMENNÝ HROB\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.101.128.1.message" : "Pandora:\n\"NEVĚDOMOST BUDE KOŘENĚNA!\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.101.133.1.message" : "Pandora:\n\"ENROTH NEBYL SPOJENÝ POD JEDNOTNÝM PRAVIDLEM ANI PŘED STOLETMI\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.102.129.1.message" : "*Temný proud Styx si bere svůj hold a strhává úlomky vašich duší*",
	"map.[hota] might and magic.guards.102.145.1.message" : "Pandora:\n\"NEVĚDOMOST BUDE KOŘENĚNA!\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.102.153.0.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.103.136.1.message" : "Archibald:\n\"Tato Pandořina skříňka je záhadou, v této říši se zhmotnila teprve nedávno a postrádá nehybnou velikost...\"",
	"map.[hota] might and magic.guards.103.139.1.message" : "Pandora:\n\"LETOVÉ TECHNOLOGIE BYLY TÉMĚŘ ZTRACENY\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.103.141.1.message" : "*Temný proud Styx si bere svůj hold a strhává úlomky vašich duší*",
	"map.[hota] might and magic.guards.103.17.1.message" : "HALA POD VRCHOLEM\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.103.81.1.message" : "PROKLETÁ DOBŘE\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.104.90.0.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.105.130.1.message" : "Pandora:\n\"VELKÉ KOLOSY A GOLEMOVÉ BYLI POD VAŠÍM KRATKORYTÝM MYSLEM ODSUNUTI K REZIVĚ A HNILOSTI\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.105.143.1.message" : "Pandora:\n\"ZDROJE ENROTH ZŮSTALY HLUBOCE NEVYUŽITÉ.\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.105.224.1.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.106.146.1.message" : "*Temný proud Styx si bere svůj hold a strhává úlomky vašich duší*",
	"map.[hota] might and magic.guards.106.64.0.message" : "ÚDOLÍ DAGRONDU\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.107.127.1.message" : "Archibald:\n\"Tato Pandořina skříňka je záhadou, v této říši se zhmotnila teprve nedávno a postrádá nehybnou velikost...\"",
	"map.[hota] might and magic.guards.108.182.0.message" : "\"Spirits of Wind nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"\n",
	"map.[hota] might and magic.guards.109.129.1.message" : "Pandora:\n\"VÁŠ ŽIVOT NEMÁ ÚČEL\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.109.147.1.message" : "Pandora:\n\"DOKONCE RUČNÍ ODSTŘEŠOVAČE BYLY NEPODOBĚ POŠKOZENY A ZNIČENY.\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.110.126.1.message" : "Pandora:\n\"VYBRANÍ LIDÉ ZAČALI BOJOVAT MÍSTO SJEDNOVÁNÍ KOLEM SPOLEČNÉHO CÍLE.\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.110.237.0.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.111.217.1.message" : "Archibald:\n\"Myslím, že i vy cítíte tu velkou magickou energii uzamčenou v této Pandořině skříňce. Bylo jí uděleno jméno \"ROTTEN PATH\"\"",
	"map.[hota] might and magic.guards.112.123.1.message" : "*Temný proud Styx si bere svůj hold a strhává úlomky vašich duší*",
	"map.[hota] might and magic.guards.112.149.1.message" : "*Temný proud Styx si bere svůj hold a strhává úlomky vašich duší*",
	"map.[hota] might and magic.guards.112.37.0.message" : "WYVERNSKÉ PLAINY\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.112.9.1.message" : "Archibald:\n\"Této schránce byl svěřen název - \"POMÍNKA\", Obsahuje značné množství magické energie.\"",
	"map.[hota] might and magic.guards.113.124.1.message" : "Pandora:\n\"VYVOLENÍ SE ODSULI K RYCHLÉMU ZÁNIKU, NIC NEDOSÁHLI\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.113.168.0.message" : "GRIFFIN Útesy\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.114.148.1.message" : "Pandora:\n\"I PO PŘÍSTUPU ANDĚLSKÝCH SÍL SE SMRTLÍKŮM NEDALO ÚPLNĚ VYMAZAT KREEGANSKOU HROZBU.\"\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.114.6.1.message" : "\"Duchové Země nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",
	"map.[hota] might and magic.guards.115.111.0.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.116.125.1.message" : "*Temný proud Styx si bere svůj hold a strhává úlomky vašich duší*",
	"map.[hota] might and magic.guards.116.187.0.message" : "BRONZOVÁ POUŠŤ\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.117.124.1.message" : "Archibald:\n\"Tato Pandořina skříňka je záhadou, v této říši se zhmotnila teprve nedávno a postrádá nehybnou velikost...\"",
	"map.[hota] might and magic.guards.118.156.1.message" : "\"Kolem vás houstne tmavá mlha\"",
	"map.[hota] might and magic.guards.119.125.1.message" : "Pandora:\n\"DRAGONKIN DIHONORUJE SÁM SEBE!\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.119.149.1.message" : "Pandora:\n\"TECHNOLOGIE DANÉ VAŠIMU DRUHŮM PŘED STOLETMI LETY SKONČILY TÝM, ŽE JSOU PRO VÁŠ DRUH NEDOSTUPNÉ, ZATÍMCO VAŠÍM ÚKOLEM BYLO JE VYVÍJET A ZDOKONALIT.\"\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.119.201.0.message" : "Archibald:\n\"Této schránce bylo svěřeno jméno - \"RUST\", Obsahuje velké množství magické energie.",
	"map.[hota] might and magic.guards.12.96.0.message" : "\"Duchové Země nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",
	"map.[hota] might and magic.guards.121.118.1.message" : "\"Kolem vás houstne tmavá mlha\"",
	"map.[hota] might and magic.guards.121.57.1.message" : "Vznešení válečníci z AvLee, kteří se nesklonili před tyranií Triumvirátu, jsou uvězněni v této Pandořině skříňce. Přejete si osvobodit jejich řetězy?",
	"map.[hota] might and magic.guards.122.131.0.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.122.147.1.message" : "Pandora:\n\"ŠPIČKOVÁ TECHNOLOGIE VÝzbroje BYLA ZTRACENA.\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.123.127.1.message" : "Pandora:\n\"VAŠE NEDOSTATEK MYŠLENÍ NÁROKOVANÉ TECHNOLOGIE JAKO KOUZLO. TOTO JE ZPRACOVÁNÍ VAŠÍ NEVĚDOMOSTI\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.123.211.0.message" : "\"Spirits of Fire nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",
	"map.[hota] might and magic.guards.124.128.1.message" : "Pandora:\n\"LODĚ, KTERÉ KDYKOLI PROBÍRALY VESMÍREM, PLYNULY NA VODU, POUZE PLOVALY PO VODÁCH.\"\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.124.147.1.message" : "*Temný proud Styx si bere svůj hold a strhává úlomky vašich duší*",
	"map.[hota] might and magic.guards.124.2.0.message" : "SOUMRAK\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.124.56.1.message" : "VÍLA\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.125.129.1.message" : "Pandora:\n\"MYSL KOLONISTŮ NÁHODOU NEBYLA PŘIPRAVENA NA NADCHÁZEJÍCÍ VÝZVY.\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.126.119.1.message" : "\"Kolem vás houstne tmavá mlha\"",
	"map.[hota] might and magic.guards.126.125.1.message" : "Pandora:\n\"NEVĚDOMOST BUDE KOŘENĚNA!\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.126.230.1.message" : "\"Duchové Země nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",
	"map.[hota] might and magic.guards.126.38.0.message" : "Archibald:\n\"Této schránce bylo svěřeno jméno - \"MĚŘÍTKO\", Obsahuje značné množství magické energie.\"",
	"map.[hota] might and magic.guards.126.75.0.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.127.145.1.message" : "Pandora:\n\"INFORMAČNÍ TOKY BYLY PŘERUŠENY, A FUNGOVÁNÍ SYSTÉMŮ ODSUNULO K NEVYHNUTNÉMU ZASTAVENÍ.\"\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.128.119.0.message" : "VYSOKÝ HRAD\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.128.132.1.message" : "Pandora:\n\"VYBRANÍ LIDÉ JE SAMOSTATNĚ OŘEZUJÍ OD STARÝCH\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.128.136.1.message" : "Archibald:\n\"Tato Pandořina skříňka je záhadou, v této říši se zhmotnila teprve nedávno a postrádá nehybnou velikost...\"",
	"map.[hota] might and magic.guards.128.141.1.message" : "Pandora:\n\"TECHNOLOGII ORBITÁLNÍHO BOMBARDOVÁNÍ NELZE SVĚŘIT DO VAŠICH RUKOU, URČITĚ DŘÍVE NEBO POZDĚJI PŘINESE ZÁNIK PLANETY\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.129.103.1.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.129.116.1.message" : "\"Kolem vás houstne tmavá mlha\"",
	"map.[hota] might and magic.guards.129.12.0.message" : "\"Duchové Země nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",
	"map.[hota] might and magic.guards.129.134.1.message" : "*Temný proud Styx si bere svůj hold a strhává úlomky vašich duší*",
	"map.[hota] might and magic.guards.129.137.1.message" : "Pandora:\n\"PSYCHICKÉ TECHNOLOGIE BYLY DANÉ DESTRUKTIVNÍM SÍLÁM, KTERÝ SVŮJ ÚČEL KROUTÍ UVNITŘ VEN\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.13.40.1.message" : "Archibald:\n\"Tato krabice je přeplněna magickou energií. Něco, čemu můžete po otevření čelit, je extrémně nebezpečné. Název udělený této krabici zní jako \"LIFE PACT\"\"",
	"map.[hota] might and magic.guards.130.119.1.message" : "\"Kolem vás houstne tmavá mlha\"",
	"map.[hota] might and magic.guards.130.144.1.message" : "Pandora:\n\"NEVĚDOMOST BUDE KOŘENĚNA!\"\n\nArchibald:\n\"Počkej! Sama Pandora k tobě promlouvá skrze tuto skříňku. Množství magické energie v této skříňce je nesrovnatelné, dej si pozor na své činy.\"",
	"map.[hota] might and magic.guards.130.154.0.message" : "GRAINRICH\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.133.217.0.message" : "\"Duchové Země nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",
	"map.[hota] might and magic.guards.134.117.1.message" : "\"Kolem vás houstne tmavá mlha\"",
	"map.[hota] might and magic.guards.135.150.1.message" : "\"Spirits of Water nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",

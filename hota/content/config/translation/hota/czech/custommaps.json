	"map.[hota] might and magic.guards.136.224.0.message" : "Archibald:\n\"Této schránce bylo svěřeno jméno - \"ŽEBRA\", Obsahuje značné množství magické energie.\"",
	"map.[hota] might and magic.guards.136.79.1.message" : "KOSTNÍ JÁMA\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.137.11.0.message" : "Archibald:\n\"Toto je bezejmenná Pandořina skříňka. Necítím v ní žádnou významnou magickou energii kromě té, která je potřebná k tomu, aby tato skříňka existovala. I když se občas mohu mýlit.\"",
	"map.[hota] might and magic.guards.137.136.1.message" : "\"Kolem vás houstne tmavá mlha\"",
	"map.[hota] might and magic.guards.137.209.1.message" : "Vznešení válečníci z Nighonu, kteří se nesklonili před tyranií Triumvirátu, jsou uvězněni v této Pandořině skříňce. Přejete si osvobodit jejich řetězy?",
	"map.[hota] might and magic.guards.137.249.0.message" : "PERMAFROST\n\nBonus Pathfinder:",
	"map.[hota] might and magic.guards.138.178.1.message" : "\"Spirits of Water nedovolí, aby jejich tajemství odhalili nehodní. Musíte prokázat svou sílu, abyste je přiměli klanět se vaší vůli\"",
	"map.[hota] might and magic.guards.138.183.1.message" : "Archibald:\n\"Myslím, že i vy cítíte tu velkou magickou energii uzamčenou v této Pandořině skříňce. Bylo jí uděleno jméno \"NEUTRÁLNÍ CESTA\"\"",
	"map.[hota] might and magic.guards.139.136.0.message" : "SOUTĚŽENÉ POZEMKY\n\nBonus Pathfinder:",

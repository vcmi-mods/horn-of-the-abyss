	"map.[hota] the mysterious island (Allied).guards.240.84.1.message" : "BUUUURNNNN!\n\nPropadnete se do šílenství a necháte se spálit.",
	"map.[hota] the mysterious island (Allied).guards.240.86.1.message" : "BUUUURNNNN!\n\nPropadnete se do šílenství a necháte se spálit.",
	"map.[hota] the mysterious island (Allied).guards.241.189.1.message" : "Nejmenujete se Artuš, ale pojďme na pátrání po svatém {GRÁLU}!",

	"map.[hota] finding leena.guards.111.62.1.message" : "!!! NEBEZPEČÍ!!! \n\n!!! Otrávená tráva!!! ",
	"map.[hota] finding leena.guards.115.31.0.message" : "Zde musíte odevzdat Plášť nemrtvého krále, ale nesmutněte, dostanete něco jiného :) ",
	"map.[hota] finding leena.guards.12.59.0.message" : "Tak nevím...možná jsem měl projít tou bránou :) ",
	"map.[hota] finding leena.guards.120.21.1.message" : "Leena\n\nČekal jsem tu na tebe celou věčnost!\nKde se tak dlouho flákáš?\nOsvoboď mě, abych se mohl vypořádat s tou děvkou Cassiopeiou! ",
	"map.[hota] finding leena.guards.124.92.1.message" : "Páni, tak tady neprojdu??? Jakým způsobem??? ",
	"map.[hota] finding leena.guards.125.26.1.message" : "Špatná cesta!!!",
	"map.[hota] finding leena.guards.139.129.1.message" : "ZÁVODĚNÍ\n\nNyní máte velké závody, budete závodit s Manfredem. Musíte za každou cenu vyhrát, jinak je vše ztraceno. \nVezměte si s sebou POUZE 1 ARCHANDĚLA, do RYCHLE ",
	"map.[hota] finding leena.guards.15.8.1.message" : "Gratuluji k velkému vítězství a tady je malá odměna :) ",
	"map.[hota] finding leena.guards.22.113.1.message" : "Dvojité silové pole!",
	"map.[hota] finding leena.guards.26.18.1.message" : "KONCOVÁ ČÁRA \n\nDoufáme, že závodníci NEBUDOU PODVÁDĚT a ŽÁDNÉ ZKRÁCENÍ trasy :-)\n\n",
	"map.[hota] finding leena.guards.27.75.0.message" : "Nápověda \n\nČervené věže",
	"map.[hota] finding leena.guards.3.101.1.message" : "TEMNÁ DŽUNGLE\n\nJste si jistý, že máte odvahu projít? ",
	"map.[hota] finding leena.guards.5.50.1.message" : "To nemůžeš vyhrát???\n\nNebo je jiný způsob??? ",
	"map.[hota] finding leena.guards.50.69.0.message" : "!!! NEBEZPEČÍ!!! ",
	"map.[hota] finding leena.guards.73.83.0.message" : "!!! Nepoužívejte oba artefakty (HOTA a CoUK) společně. Budou si navzájem překážet!!!",
	"map.[hota] finding leena.guards.75.130.0.message" : "! Nebezpečí!",
	"map.[hota] finding leena.guards.92.54.0.message" : "Existuje jiná cesta?",
	"map.[hota] finding leena.header.description" : "Najděte správnou cestu. Najděte a sestavte všechny artefakty. Vyřešte úkoly. Přečtěte si rady a postupujte podle nich. Porazte všechny nepřátele a hlavně najděte Leenu!!! \n\nVerze Normal 2.0. (h3 HOTA 1.6 a vyšší)",
	"map.[hota] finding leena.header.name" : "Hledání Leeny (N)",
	"map.[hota] finding leena.monster.77.76.1.message" : "Nezapomeňte po boji VYHNOUT KOSTRU, zpomalí vás to !!! ",
	"map.[hota] finding leena.quest.120.40.1.firstVisit" : "Co?   Roh Abyss?\n\nAle to už jsem dodal jinde!!! \nTak tady musím najít další ...třeba to bude někde u hradu.\n\n...a kde je sakra Leena? ",
	"map.[hota] finding leena.sign.10.5.1.message" : "Najděte 2 artefakty",
	"map.[hota] finding leena.sign.103.24.0.message" : "Za touto pohraniční stráží se skrývá Lví štít odvahy ... tak na něj nezapomeňte!",
	"map.[hota] finding leena.sign.110.94.1.message" : "Vezměte to doprava!!!",
	"map.[hota] finding leena.sign.133.131.0.message" : "Prozkoumejte toto území, než zaútočíte.",

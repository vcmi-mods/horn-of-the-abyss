	"map.[hota] noble nemesis.header.heroes.34" : "Moudrost",
	"map.[hota] noble nemesis.header.heroes.37" : "Hádanka",
	"map.[hota] noble nemesis.header.heroes.5" : "Spravedlnost",
	"map.[hota] noble nemesis.header.heroes.6" : "Rozsudek",
	"map.[hota] noble nemesis.header.heroes.7" : "Dominion",
	"map.[hota] noble nemesis.header.heroes.8" : "Hrdost",
	"map.[hota] noble nemesis.header.name" : "Vznešená Nemesis",
	"map.[hota] noble nemesis.heroes.10.biography" : "Cuthbert",
	"map.[hota] noble nemesis.heroes.110.biography" : "Grulk velí Kyklopům ne slovy, ale řetězy a strachem. Udržuje je nakrmené, soustředěné a otočené správným směrem – obvykle. Nikdo si není jistý, kdo je nebezpečnější: monstra v kleci nebo ten, kdo drží klíč.",
	"map.[hota] noble nemesis.heroes.118.biography" : "Jakmile byl Gorgthak vyšlechtěn pro válku, našel účel v řetězech a zdech. Nyní střeží andělské vězení s brutální pýchou, zdrcujícím útěkem i milosrdenstvím. Říká se, že nikdy nespal – jen vrčel. Dokonce i démoni si udržují odstup.",
	"map.[hota] noble nemesis.heroes.12.biography" : "Ingham",
	"map.[hota] noble nemesis.heroes.127.biography" : "Zsarr\"khan se narodil v černých vodách, kam slunce nikdy nedosáhne, a mluví jazykem bažiny i hada. Jeho oči hoří jako utopené světlušky a močál se na jeho příkaz posouvá. Někteří říkají, že močál nehlídá on – je to on.",
	"map.[hota] noble nemesis.heroes.144.biography" : "Sir Mullich",
	"map.[hota] noble nemesis.heroes.146.biography" : "Kateřina",
	"map.[hota] noble nemesis.heroes.152.biography" : "Varguk, oděný do spáleného železa a dračí kůže, se nazývá králem špatných skřetů. Krmí vězně wyrmlingům a zpívá plamenům. Dokonce i draci mu dávají prostor – a to už je co říct.",
	"map.[hota] noble nemesis.heroes.17.biography" : "Ufretin",
	"map.[hota] noble nemesis.heroes.19.biography" : "Ryland",
	"map.[hota] noble nemesis.heroes.2.biography" : "Edric",
	"map.[hota] noble nemesis.heroes.20.biography" : "Ufretin, který jako dítě osiřel, vyrůstal v nejsevernějších lesích AvLee. Stal se známým po celé zemi pro svou výjimečnou schopnost odolávat magii všeho druhu.",
	"map.[hota] noble nemesis.heroes.22.biography" : "Clancy",
	"map.[hota] noble nemesis.heroes.23.biography" : "Říká se, že Grashka jednou sundal wyvernu s rezavým hákem a polovičním plánem. Nikdy nemluví o své minulosti – jen si brousí čepele u ohně. Když se směje, obvykle někdo zemře.",
	"map.[hota] noble nemesis.heroes.25.biography" : "Uland",
	"map.[hota] noble nemesis.heroes.27.biography" : "Klenot",
	"map.[hota] noble nemesis.heroes.28.biography" : "Malcom",
	"map.[hota] noble nemesis.heroes.29.biography" : "promiň",
	"map.[hota] noble nemesis.heroes.31.biography" : "Thalanar se údajně zrodil z první bouře pod kořenem světa. Jeho přítomnost ohýbá světlo, uklidňuje zvířata a umlčuje lži. Málokdo ví, jestli jeskyni chrání – nebo jestli si jeskyně vysnila, aby byl.",
	"map.[hota] noble nemesis.heroes.34.biography" : "Josephine",
	"map.[hota] noble nemesis.heroes.37.biography" : "Fafner",
	"map.[hota] noble nemesis.heroes.5.biography" : "soda",
	"map.[hota] noble nemesis.heroes.6.biography" : "křesťan",
	"map.[hota] noble nemesis.heroes.7.biography" : "Pneumatika",
	"map.[hota] noble nemesis.heroes.8.biography" : "Rion",
	"map.[hota] noble nemesis.quest.100.23.1.completed" : "Zde je dodávka zlata.",
	"map.[hota] noble nemesis.quest.100.23.1.firstVisit" : "Amulet hrobníka leží pohřben hluboko v králově rudném dole. Chceš mi to přinést? Mohl bych vám pomoci zorganizovat horníky.",
	"map.[hota] noble nemesis.quest.100.23.1.nextVisit" : "Pořád se hrabeš v tunelech? Rudný důl se tak snadno nevzdá svých tajemství.",
	"map.[hota] noble nemesis.quest.102.113.1.completed" : "Jak se kouzlo svitku ujme, prastarý kámen se chvěje, drolí se a bledne v prach.",
	"map.[hota] noble nemesis.quest.102.113.1.firstVisit" : "Tento prastarý kámen zde stojí po staletí. Pouze magie mohla zrušit svou moc v této zemi.",
	"map.[hota] noble nemesis.quest.102.113.1.nextVisit" : "Tento prastarý kámen zde stojí po staletí. Pouze magie mohla zrušit svou moc v této zemi.",
	"map.[hota] noble nemesis.quest.103.33.1.completed" : "Rogue dorazí, zámek se s cvaknutím otevře. Cesta je jasná.",
	"map.[hota] noble nemesis.quest.103.33.1.firstVisit" : "Silný zámek zatarasí cestu. Přineste mi darebáky – otevřít to mohou jen jejich ruce.",
	"map.[hota] noble nemesis.quest.103.33.1.nextVisit" : "Zámek stále drží.",
	"map.[hota] noble nemesis.quest.108.206.0.completed" : "Užijte si svou novou společnost.",
	"map.[hota] noble nemesis.quest.108.206.0.firstVisit" : "Vítejte na trhu s otroky. 10 000 zlatých za tyto krásky.",
	"map.[hota] noble nemesis.quest.108.206.0.nextVisit" : "Vítejte na trhu s otroky. 10 000 zlatých za tyto krásky.",
	"map.[hota] noble nemesis.quest.109.155.0.completed" : "Konečně! Ten otravný svitek je můj – pozor na překážky!",
	"map.[hota] noble nemesis.quest.109.155.0.firstVisit" : "Povaluje se vám nějaký z těch zaprášených svitků odstranění překážky? Za jeden zaplatím 30 000 zlatých – neptejte se proč, prostě mi věřte.",
	"map.[hota] noble nemesis.quest.109.155.0.nextVisit" : "Stále čekám... ten svitek se sám neodevzdá, víš.",
	"map.[hota] noble nemesis.quest.110.206.0.completed" : "Užijte si svou novou společnost.",
	"map.[hota] noble nemesis.quest.110.206.0.firstVisit" : "Vítejte na trhu s otroky. 10 000 zlatých za tyto krásky.",
	"map.[hota] noble nemesis.quest.110.206.0.nextVisit" : "Vítejte na trhu s otroky. 10 000 zlatých za tyto krásky.",
	"map.[hota] noble nemesis.quest.110.29.1.completed" : "Průkaz se otevře.",
	"map.[hota] noble nemesis.quest.110.29.1.firstVisit" : "Důl je zamčený. Ufretin má klíč.",
	"map.[hota] noble nemesis.quest.110.29.1.nextVisit" : "Ufretin má klíč.",
	"map.[hota] noble nemesis.quest.112.206.0.completed" : "Užijte si svou novou společnost.",
	"map.[hota] noble nemesis.quest.112.206.0.firstVisit" : "Vítejte na trhu s otroky. 10 000 zlatých za tyto krásky.",

	"map.[hota] the mysterious island.guards.233.216.1.message" : "Toto je cesta k {Floatsom Point}, buďte silní!",
	"map.[hota] the mysterious island.guards.233.220.1.message" : "Tenhle malý artefakt nevypadá moc mocně...\n\nAle měli bychom si to {nechat} na později.",
	"map.[hota] the mysterious island.guards.233.74.0.message" : "{příznivý vítr} nás tlačí!",
	"map.[hota] the mysterious island.guards.234.20.1.message" : "Vážně?!",
	"map.[hota] the mysterious island.guards.235.94.0.message" : "{příznivý vítr} nás tlačí!",
	"map.[hota] the mysterious island.guards.236.21.1.message" : "Choďte bez rytmu, nechoďte po dírách od červů!\n\nPříliš pozdě...",
	"map.[hota] the mysterious island.guards.237.20.1.message" : "Choďte bez rytmu, nechoďte po dírách od červů!\n\nPříliš pozdě...",
	"map.[hota] the mysterious island.guards.238.210.1.message" : "JACKPOT!",
	"map.[hota] the mysterious island.guards.238.84.1.message" : "BUUUURNNNN!\n\nPropadnete se do šílenství a necháte se spálit.",
	"map.[hota] the mysterious island.guards.238.85.1.message" : "Velký!",
	"map.[hota] the mysterious island.guards.238.86.1.message" : "To je vše!\n\n\"Nestojte v ohni\" říká kapitán Obvious.",
	"map.[hota] the mysterious island.guards.238.91.0.message" : "Mezi rukopisy najdete něco, co upoutá vaši pozornost:\n\n\"{Daenerys}, matka draků, byla zajata a převezena do jeskyně poblíž zálivu Conflux \"WashingtownBay.\"\"\n\nJejímu únosci, chýši věštce, se prý podařilo vytvořit {Vial of Dragon Blood}.\n\nS touto lahvičkou ve svém držení by Daenerys mohla dosáhnout svatyně {Town Portal} v rudém území, aniž by probudila zuřivost sopky... Nebezpečná mise.\n\nVchod do tohoto průchodu prý leží v plamenech, ve stejné jeskyni jako dračí obydlí, které vyžaduje síru...\"",
	"map.[hota] the mysterious island.guards.239.84.1.message" : "Úžasný!",
	"map.[hota] the mysterious island.guards.239.85.1.message" : "OHEŇ VÁS ZAČÍNÁ POŽÍRAT!\n\nPamatujte: \"NEPODLÉHEJTE se volání {FIRE}\".",
	"map.[hota] the mysterious island.guards.239.86.1.message" : "OHEŇ VÁS ZAČÍNÁ POŽÍRAT!\n\nPamatujte: \"Nepodléhejte volání {ohně}\".",
	"map.[hota] the mysterious island.guards.239.88.1.message" : "{R.T.F.M.}\n\n---- IN ----\nPozor!\n{Přečtěte si} {sign} na levé straně.\nNebo spálit.\n\n---- FR ----\nPozor !\nRozhodně si přečtěte a přeložte {sign} (panel) vedle něj.\nNebo spálit.\n\n---- PL ----\nPozor!\nPřečtěte si a nezapomeňte přeložit {sign} (tabulky) vlevo.\nAlbo splon.\n\n---- OF ----\nNebezpečí!\nNezapomeňte si přečíst a přeložit {sign} ihned doleva.\nNebo spálit.\n\n---- ES ----\nPozor!\nPřečtěte si a zcela přeložte {sign} hned vedle.\nTo je vše.\n\n---- IT ----\nPozor!\nNezapomeňte si přečíst a přeložit {sign} (znak) hned vedle.\nNebo spálíte.",
	"map.[hota] the mysterious island.guards.24.11.1.message" : "Pěkný!",
	"map.[hota] the mysterious island.guards.240.170.1.message" : "V této podzemní řece jsou peřeje!",
	"map.[hota] the mysterious island.guards.240.211.0.message" : "{příznivý vítr} nás tlačí!",
	"map.[hota] the mysterious island.guards.240.231.1.message" : "Opatrně... Díky této truhle vyrostete mnohem rychleji, než byste čekali!",
	"map.[hota] the mysterious island.guards.240.84.1.message" : "BUUUURNNNN!\n\nPropadnete se do šílenství a necháte se spálit.",
	"map.[hota] the mysterious island.guards.240.86.1.message" : "BUUUURNNNN!\n\nPropadnete se do šílenství a necháte se spálit.",
	"map.[hota] the mysterious island.guards.241.189.1.message" : "Nejmenujete se Artuš, ale pojďme na pátrání po svatém {GRÁLU}!",
	"map.[hota] the mysterious island.guards.241.85.1.message" : "BUUUURNNNN!\n\nPropadnete se do šílenství a necháte se spálit.",

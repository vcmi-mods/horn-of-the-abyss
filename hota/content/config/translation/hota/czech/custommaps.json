	"map.[hota] the mysterious island (Allied).guards.243.87.1.message" : "BUUUURNNNN!\n\nPropadnete se do šílenství a necháte se spálit.",
	"map.[hota] the mysterious island (Allied).guards.244.211.1.message" : "Opatrně... Díky této truhle vyrostete mnohem rychleji, než byste čekali!",
	"map.[hota] the mysterious island (Allied).guards.245.172.0.message" : "{příznivý vítr} nás tlačí!",
	"map.[hota] the mysterious island (Allied).guards.245.62.0.message" : "Opatrně... Díky této truhle vyrostete mnohem rychleji, než byste čekali!",
	"map.[hota] the mysterious island (Allied).guards.245.93.1.message" : "...a...\nnic.",
	"map.[hota] the mysterious island (Allied).guards.245.95.1.message" : "Pamatujte: \"Na {Water Walk} lehkým krokem.\"\"",
	"map.[hota] the mysterious island (Allied).guards.246.107.1.message" : "Nemo říká:\n\n\"Zde je zkratka, která vám umožní vrátit se do {Nautilus}, ale také {vrátit se} sem, aniž byste museli znovu překračovat celé území {Red}!\n\nJo, a pomocí {Červeného klíče} jste také {odemkli} novou místnost v Nautilu, včetně {Knihovny osvícení}, mimo jiné...\n\nUrčitě to prozkoumejte, mohlo by vám to na vaší cestě velmi pomoci!\"",
	"map.[hota] the mysterious island (Allied).guards.246.225.0.message" : "{příznivý vítr} nás tlačí!",
	"map.[hota] the mysterious island (Allied).guards.246.37.0.message" : "{příznivý vítr} nás tlačí!",
	"map.[hota] the mysterious island (Allied).guards.246.90.1.message" : "\"Bojujte se stíny\", tady jsme...",
	"map.[hota] the mysterious island (Allied).guards.246.91.1.message" : "znovu...",
	"map.[hota] the mysterious island (Allied).guards.246.92.1.message" : "a znovu...",
	"map.[hota] the mysterious island (Allied).guards.246.93.1.message" : "...a...\nnic.",
	"map.[hota] the mysterious island (Allied).guards.247.92.1.message" : "a znovu...",
	"map.[hota] the mysterious island (Allied).guards.248.21.0.message" : "V mořských řasách najdete malý, bezcenný předmět... který by mohl {odemknout} strážní úkol hned vedle něj.",
	"map.[hota] the mysterious island (Allied).guards.248.47.0.message" : "Ideální místo pro přepadení, počkej...",
	"map.[hota] the mysterious island (Allied).guards.250.133.0.message" : "{příznivý vítr} nás tlačí!",
